@using EarlyWarning.Extensions
@model EarlyWarning.Models.CropPestAndDesease

@{
    ViewData["Title"] = "የሰብል ተባይ/በሽታ መሰረዝ";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var used = ViewBag.UsageCount as int? ?? 0;
}

<partial name="_SettingsPageStyles" />

<div class="container-fluid">
    <div class="page-header">
        <h1><i class="fas fa-trash"></i> @ViewData["Title"]</h1>
        <p>@Model.Name</p>
    </div>

    <div class="form-card">
        <div class="card-header-custom danger"><i class="fas fa-exclamation-triangle"></i> ይህን ተባይ/በሽታ መሰረዝ ይፈልጋሉ?</div>
        <div class="card-body-custom">
            @if (used > 0)
            {
                <div class="alert alert-warning">
                    <i class="fas fa-lock me-2"></i>ይህ ተባይ/በሽታ በ@(used) የሪፖርት ዝርዝር(ሮች) ላይ ስለተጠቀሰ መሰረዝ አይቻልም።
                    ቢሰረዝ የተመዘገቡት ሪፖርቶች መረጃ አብሮ ይጠፋል። ስሙን ማስተካከል ይችላሉ።
                </div>
            }
            <div class="detail-row">
                <div class="detail-label"><i class="fas fa-tag"></i> @Html.DisplayNameFor(m => m.Name)</div>
                <div class="detail-value"><strong>@Model.Name</strong></div>
            </div>
            <div class="detail-row">
                <div class="detail-label"><i class="fas fa-layer-group"></i> @Html.DisplayNameFor(m => m.CPDType)</div>
                <div class="detail-value">@ReadOnlyFields.EnumLabel(Model.CPDType)</div>
            </div>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="form-actions">
                    <a asp-action="Index" class="btn-custom btn-back"><i class="fas fa-arrow-left"></i> ወደ ዝርዝር ተመለስ</a>
                    @if (used == 0)
                    {
                        <button type="submit" class="btn-custom btn-delete"><i class="fas fa-trash"></i> አዎ፣ ሰርዝ</button>
                    }
                    else
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-custom btn-edit"><i class="fas fa-edit"></i> አርትዕ</a>
                    }
                </div>
            </form>
        </div>
    </div>
</div>
