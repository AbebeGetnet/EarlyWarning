@* Shared look for Setting (lookup list) pages: header banner, stat cards, list table and form card.
   Matches the inline styles of GrainTypes/AnimalTypes/AccidentTypes so the pages look the same. *@
<style>
    .page-header {
        background: var(--ew-brand-gradient, linear-gradient(120deg, #173e50 0%, #276683 55%, #2f7f9f 100%));
        color: white;
        padding: 25px 20px;
        border-radius: 12px;
        margin-bottom: 25px;
        position: relative;
        overflow: hidden;
    }
    .page-header::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
        transform: rotate(45deg);
        pointer-events: none;
    }
    .page-header h1 { margin: 0; font-size: 1.6rem; position: relative; z-index: 1; }
    .page-header p { margin: 8px 0 0; opacity: 0.9; position: relative; z-index: 1; }
    .page-header .btn-create { position: relative; z-index: 1; }

    .btn-create {
        background: var(--ew-good, #1e7e34);
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        color: white;
        font-weight: 600;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
    }
    .btn-create:hover { transform: translateY(-2px); box-shadow: 0 4px 8px rgba(0,0,0,0.2); color: white; }

    .stat-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        margin-bottom: 20px;
        overflow: hidden;
        transition: transform 0.3s ease;
    }
    .stat-card:hover { transform: translateY(-3px); box-shadow: 0 6px 16px rgba(0,0,0,0.15); }
    .stat-header { padding: 12px 15px; text-align: center; color: white; }
    .stat-header.total { background: var(--ew-brand-gradient, linear-gradient(120deg, #173e50 0%, #276683 55%, #2f7f9f 100%)); }
    .stat-header.active { background: var(--ew-good, #1e7e34); }
    .stat-header.inactive { background: var(--ew-critical, #c0392b); }
    .stat-header.warning { background: #d68910; }
    .stat-body { padding: 15px; text-align: center; }
    .stat-number { font-size: 1.8rem; font-weight: bold; margin-bottom: 5px; }
    .stat-label { color: #6c757d; font-size: 0.85rem; }

    .table-container {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        overflow: hidden;
        animation: settingsFadeIn 0.5s ease-out;
    }
    .table-container .table { margin-bottom: 0; }
    .table-container .table thead th {
        background: #f8f9fa;
        color: #495057;
        border-bottom: 2px solid #dee2e6;
        padding: 12px;
        font-weight: 600;
        font-size: 0.85rem;
        text-align: center;
    }
    .table-container .table tbody tr { transition: background-color 0.3s ease; cursor: pointer; }
    .table-container .table tbody tr:hover { background-color: #f8f9fa; }
    .table-container .table tbody td { padding: 10px 12px; vertical-align: middle; text-align: center; font-size: 0.85rem; }

    .badge-active, .badge-inactive, .badge-neutral {
        padding: 5px 12px;
        border-radius: 20px;
        color: white;
        font-size: 0.75rem;
        display: inline-block;
    }
    .badge-active { background: var(--ew-good, #1e7e34); }
    .badge-inactive { background: var(--ew-critical, #c0392b); }
    .badge-neutral { background: #6c757d; }

    .action-buttons { display: flex; gap: 5px; justify-content: center; flex-wrap: wrap; }
    .btn-action { padding: 4px 8px; border-radius: 6px; font-size: 0.7rem; transition: all 0.3s ease; }
    .btn-action:hover { transform: translateY(-2px); }

    .search-box { margin-bottom: 20px; }
    .search-box input { border-radius: 25px; padding: 8px 15px; border: 1px solid #ddd; transition: all 0.3s ease; }
    .search-box input:focus { border-color: var(--ew-brand, #276683); box-shadow: 0 0 0 0.2rem rgba(39, 102, 131, 0.25); outline: none; }
    .export-buttons { margin-bottom: 15px; display: flex; gap: 10px; justify-content: flex-end; flex-wrap: wrap; }
    .btn-export { border-radius: 8px; padding: 5px 12px; font-size: 0.8rem; }

    /* Form, details and delete pages */
    .form-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        overflow: hidden;
    }
    .card-header-custom {
        background: var(--ew-brand-gradient, linear-gradient(120deg, #173e50 0%, #276683 55%, #2f7f9f 100%));
        color: white;
        padding: 12px 20px;
        font-weight: 600;
    }
    .card-header-custom.danger { background: var(--ew-critical, #c0392b); }
    .card-header-custom i { margin-right: 8px; }
    .card-body-custom { padding: 25px; }
    .form-card .form-group { margin-bottom: 20px; }
    .form-card .form-label { font-weight: 600; margin-bottom: 8px; display: block; font-size: 0.9rem; }
    .form-card .form-label i { margin-right: 5px; color: var(--ew-brand, #276683); }
    .form-card .form-control, .form-card .form-select {
        border-radius: 8px;
        border: 1px solid #ddd;
        padding: 10px 12px;
        width: 100%;
        font-size: 0.9rem;
        transition: all 0.3s ease;
    }
    .form-card .form-control:focus, .form-card .form-select:focus {
        border-color: var(--ew-brand, #276683);
        box-shadow: 0 0 0 0.2rem rgba(39, 102, 131, 0.25);
        outline: none;
    }
    .info-hint {
        background: #e8f4f8;
        border-left: 3px solid var(--ew-brand, #276683);
        padding: 8px 12px;
        border-radius: 6px;
        font-size: 0.8rem;
        margin-top: 5px;
    }
    .detail-row { display: flex; padding: 12px 0; border-bottom: 1px solid #eee; }
    .detail-row:last-child { border-bottom: none; }
    .detail-label { width: 40%; font-weight: 600; color: #495057; }
    .detail-label i { margin-right: 6px; color: var(--ew-brand, #276683); }
    .detail-value { width: 60%; }
    .form-actions { display: flex; gap: 15px; justify-content: flex-end; margin-top: 25px; flex-wrap: wrap; }
    .btn-custom {
        padding: 10px 25px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        color: white;
    }
    .btn-submit { background: var(--ew-good, #1e7e34); }
    .btn-edit { background: #d68910; }
    .btn-delete { background: var(--ew-critical, #c0392b); }
    .btn-back { background: linear-gradient(135deg, #6c757d 0%, #495057 100%); }
    .btn-custom:hover { transform: translateY(-2px); box-shadow: 0 4px 8px rgba(0,0,0,0.2); color: white; }

    @@media (max-width: 768px) {
        .stat-number { font-size: 1.3rem; }
        .action-buttons { flex-direction: column; align-items: center; }
        .table-container .table thead th { font-size: 0.7rem; padding: 8px; }
        .table-container .table tbody td { padding: 6px 8px; font-size: 0.75rem; }
        .export-buttons { justify-content: center; }
        .card-body-custom { padding: 20px; }
        .form-actions { flex-direction: column; }
        .btn-custom { width: 100%; text-align: center; }
        .detail-row { flex-direction: column; }
        .detail-label, .detail-value { width: 100%; }
    }
    @@keyframes settingsFadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
