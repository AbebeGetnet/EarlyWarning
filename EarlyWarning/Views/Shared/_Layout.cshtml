    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/beneficiaries.js" asp-append-version="true"></script>
    <script src="~/js/offline.js" asp-append-version="true"></script>
    <script>
        // Numeric inputs that still hold the default 0 are emptied when the user clicks in,
        // so they can type straight away; leaving the field empty puts the 0 back.
        (function () {
            const isNumeric = el => el instanceof HTMLInputElement && !el.readOnly && !el.disabled
                && (el.type === 'number' || (el.type === 'text' && el.hasAttribute('data-val-number')));
            document.addEventListener('focusin', event => {
                const input = event.target;
                if (!isNumeric(input) || !/^0+([.,]0*)?$/.test(input.value.trim())) return;
                input.dataset.zeroCleared = '1';
                input.value = '';
            });
            document.addEventListener('focusout', event => {
                const input = event.target;
                if (!isNumeric(input) || input.dataset.zeroCleared !== '1') return;
                delete input.dataset.zeroCleared;
                if (input.value.trim() !== '') return;
                input.value = '0';
                input.dispatchEvent(new Event('input', { bubbles: true }));
                input.dispatchEvent(new Event('change', { bubbles: true }));
            });
            // Submitting with Enter does not blur the field, so put the 0 back before the form is sent.
            document.addEventListener('submit', event => {
                event.target.querySelectorAll?.('input[data-zero-cleared="1"]').forEach(input => {
                    if (input.value.trim() === '') input.value = '0';
                });
            }, true);
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
