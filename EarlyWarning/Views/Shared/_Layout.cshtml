@using EarlyWarning.Data
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Early Warning</title>
    @* Read by wwwroot/js/offline.js (outbox and service worker). *@
    <meta name="ew-base" content="@Url.Content("~/")" />
    <meta name="ew-user" content="@UserManager.GetUserId(User)" />
    <meta name="ew-token-url" content="@Url.Action("AntiforgeryToken", "RegisterationWizard")" />
    @* Only what the pages use. Everything is served locally except toastr (pinned) and the optional web font,
       which loads without blocking so the page (and login) still draws fast on a slow or offline connection.
       Removed (unused): ionicons, tempusdominus, iCheck, JQVMap, daterangepicker, summernote, DataTables buttons. *@
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=swap" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="~/AdminLte/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="~/AdminLte/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="~/AdminLte/plugins/overlayScrollbars/css/OverlayScrollbars.min.css">
    <link rel="stylesheet" href="~/AdminLte/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/AdminLte/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <style>
        .preloader { background: rgba(241, 250, 247, .98) !important; }
        .ew-loading-spinner {
            width: 68px;
            height: 68px;
            border: 7px solid rgba(39, 102, 131, .18);
            border-top-color: #276683;
            border-right-color: #276683;
            border-radius: 50%;
            animation: ew-spinner-rotate .8s linear infinite;
            box-shadow: 0 5px 18px rgba(39, 102, 131, .13);
        }
        .ew-loading-text {
            margin-top: 15px;
            color: #276683;
            font-weight: 700;
            letter-spacing: .02em;
        }
        @@keyframes ew-spinner-rotate { to { transform: rotate(360deg); } }
        @@media (prefers-reduced-motion: reduce) {
            .ew-loading-spinner { animation-duration: 1.6s; }
        }
        /* Beneficiary tables: age/disability rows are breakdowns of household heads + family (js/beneficiaries.js). */
        tr.beneficiary-breakdown > td:first-child { padding-left: 1.5rem !important; font-weight: 500 !important; font-style: italic; }
        tr.beneficiary-breakdown > td:first-child::before { content: "↳ "; opacity: .6; }
    </style>

    <!-- Theme style -->
    @RenderSection("Styles", required: false)
</head>
<body class="hold-transition sidebar-mini layout-fixed" style="background-color:#f5f6f6">
