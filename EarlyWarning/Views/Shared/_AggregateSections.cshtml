@model EarlyWarning.ViewModels.WeeklyAggregateViewModel
@{
    // Word-style numbered heading: "3.2 Title" → number in a fixed column, title at the same indent for every
    // heading (wrapped lines included); headings without a number keep their title in that same column.
    (string Number, string Title) SplitNumber(string name)
    {
        var match = System.Text.RegularExpressions.Regex.Match(name, @"^(\d+(?:\.\d+)*\.?)\s+(.+)$");
        return match.Success ? (match.Groups[1].Value.Contains('.') ? match.Groups[1].Value : match.Groups[1].Value + ".", match.Groups[2].Value) : ("", name);
    }
}
<style>
    .aggregate-review .ew-numbered { display: grid; grid-template-columns: 3.25rem minmax(0, 1fr); align-items: baseline; }
    .aggregate-review .ew-numbered .ew-num { white-space: nowrap; }
</style>

<div class="aggregate-review mt-4">
    <h4 class="border-bottom pb-2 mb-3">ሁሉም የተጠቃለሉ መረጃዎች — የማጠቃለያ ግምገማ</h4>
    @if (Model.RainfallZones.Any())
    {
        var fullTotal = Model.RainfallZones.Sum(x => x.FullRainWoredas);
        var partialTotal = Model.RainfallZones.Sum(x => x.PartialRainWoredas);
        var noRainTotal = Model.RainfallZones.Sum(x => x.NoRainWoredas);
        var noDataTotal = Model.RainfallZones.Sum(x => x.NoDataWoredas);
        <section class="card mb-4 shadow-sm border-0">
            <div class="card-header bg-primary bg-opacity-10 fw-bold py-3 ew-numbered"><span class="ew-num">1.</span><span>የዝናብ ሁኔታ</span></div>
            <div class="table-responsive">
                <table class="table table-sm table-bordered text-start align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>ተ/ቁ</th><th class="text-start">ዞን</th><th>ሙሉ በሙሉ ዝናብ ያገኙ ቀበሌዎች</th><th>በከፊል ዝናብ ያገኙ ቀበሌዎች</th><th>ዝናብ ያላገኙ ቀበሌዎች</th><th>መረጃ ያልተገኘላቸው ቀበሌዎች</th><th>ድምር</th></tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.RainfallZones.Count; i++)
                        {
                            var row = Model.RainfallZones[i];
                            <tr><td>@(i + 1)</td><td class="text-start">@row.Zone</td><td>@(row.FullRainWoredas == 0 ? "" : row.FullRainWoredas.ToString())</td><td>@(row.PartialRainWoredas == 0 ? "" : row.PartialRainWoredas.ToString())</td><td>@(row.NoRainWoredas == 0 ? "" : row.NoRainWoredas.ToString())</td><td>@(row.NoDataWoredas == 0 ? "" : row.NoDataWoredas.ToString())</td><td class="fw-bold">@row.TotalWoredas</td></tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold"><tr><td></td><td class="text-start">ድምር</td><td>@fullTotal</td><td>@partialTotal</td><td>@noRainTotal</td><td>@noDataTotal</td><td>@(fullTotal + partialTotal + noRainTotal + noDataTotal)</td></tr></tfoot>
                </table>
            </div>
        </section>
    }

    @if (Model.FarmingZones.Any())
    {
        var meherPlanTotal = Model.FarmingZones.Sum(x => x.MeherFarmPlan);
        var meherPloughedTotal = Model.FarmingZones.Sum(x => x.MeherPloughed);
        var meherSownTotal = Model.FarmingZones.Sum(x => x.MeherSown);
        var autumnPlanTotal = Model.FarmingZones.Sum(x => x.AutumnFarmPlan);
        var autumnSownTotal = Model.FarmingZones.Sum(x => x.AutumnSown);
        <section class="card mb-4 shadow-sm border-0">
            <div class="card-header bg-primary bg-opacity-10 fw-bold py-3 ew-numbered"><span class="ew-num">2.</span><span>የመኸር የእርሻ ሥራ እንቅስቃሴ</span></div>
            <div class="table-responsive">
                <table class="table table-sm table-bordered text-start align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>ተ/ቁ</th><th class="text-start">ዞን</th><th>ዕቅድ በሄ/ር</th><th>የታረሰ በሄ/ር</th><th>የተዘራ በሄ/ር</th><th>የበልግ ዕቅድ በሄ/ር</th><th>የበልግ የተዘራ በሄ/ር</th></tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.FarmingZones.Count; i++)
                        {
                            var row = Model.FarmingZones[i];
                            <tr><td>@(i + 1)</td><td class="text-start">@row.Zone</td><td>@row.MeherFarmPlan.ToString("N2")</td><td>@row.MeherPloughed.ToString("N2")</td><td>@row.MeherSown.ToString("N2")</td><td>@row.AutumnFarmPlan.ToString("N2")</td><td>@row.AutumnSown.ToString("N2")</td></tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold"><tr><td></td><td class="text-start">ድምር</td><td>@meherPlanTotal.ToString("N2")</td><td>@meherPloughedTotal.ToString("N2")</td><td>@meherSownTotal.ToString("N2")</td><td>@autumnPlanTotal.ToString("N2")</td><td>@autumnSownTotal.ToString("N2")</td></tr></tfoot>
                </table>
            </div>
        </section>
    }

    @foreach (var aggregateSection in Model.Sections.Where(x => x.Metrics.Any()
        && (x.Name != "1. የዝናብ ሁኔታ" || !Model.RainfallZones.Any())
        && (x.Name != "2. የመኸር የእርሻ ሥራ እንቅስቃሴ" || !Model.FarmingZones.Any())))
    {
        <section class="card mb-4 shadow-sm border-0">
            @{ var heading = SplitNumber(aggregateSection.Name); }<div class="card-header bg-primary bg-opacity-10 fw-bold py-3 ew-numbered"><span class="ew-num">@heading.Number</span><span>@heading.Title</span></div>
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var metric in aggregateSection.Metrics)
                    {
                        <div class="col-12 col-md-6">
                            <div class="h-100 border rounded-3 p-3 bg-light">
                                <div class="small fw-semibold text-secondary mb-1">@metric.Name</div>
                                <div class="d-flex align-items-end gap-2">
                                    <span class="fs-5 fw-bold text-dark">@metric.Value.ToString("N2")</span>
                                    @if (!string.IsNullOrWhiteSpace(metric.Unit))
                                    {
                                        <span class="text-muted">@metric.Unit</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    @{ var affectedEvents = Model.AffectedLocations.Where(x => x.Woredas > 0).ToList(); }
    @if (affectedEvents.Any())
    {
        <section class="card mb-4 shadow-sm border-0">
            <div class="card-header bg-primary bg-opacity-10 fw-bold py-3 ew-numbered"><span class="ew-num"></span><span>በክስተት የተጎዱ አካባቢዎች</span></div>
            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>ክስተት</th><th class="text-start">የተጎዱ ቀበሌዎች</th><th class="text-start">የተጎዱ ወረዳዎች</th><th class="text-start">የተጎዱ ዞኖች</th><th>የተጎዱ ዞኖችና ወረዳዎች</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var affected in affectedEvents)
                        {
                            <tr>
                                <td class="fw-semibold">@affected.Event</td>
                                <td class="text-start">@affected.Kebeles.ToString("N0")</td>
                                <td class="text-start">@affected.Woredas.ToString("N0")</td>
                                <td class="text-start">@affected.Zones.ToString("N0")</td>
                                <td>
                                    @foreach (var zone in EarlyWarning.Services.AffectedLocations.ByZone(affected))
                                    {
                                        <div><strong>@EarlyWarning.Services.AffectedLocations.ZoneWithWoredas(zone.Key, zone.Count())፡</strong> @EarlyWarning.Services.AffectedLocations.WoredaList(zone)</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (Model.TextEntries.Any())
    {
        <section class="card mb-4 shadow-sm border-0">
            <div class="card-header bg-primary bg-opacity-10 fw-bold py-3 ew-numbered"><span class="ew-num"></span><span>የተጠቃለለ ጽሑፋዊ መረጃ</span></div>
            <div class="card-body">
                @foreach (var narrative in Model.TextEntries.GroupBy(x => x.Source))
                {
                    <div class="mb-3">
                        <div class="fw-semibold mb-1">@narrative.Key</div>
                        @foreach (var zoneText in narrative.GroupBy(x => x.Zone))
                        {
                            <p class="border rounded-3 bg-light p-3 mb-1">@if (!string.IsNullOrEmpty(zoneText.Key) && narrative.Select(x => x.Zone).Distinct().Count() > 1) { <strong>@zoneText.Key ዞን — </strong> }@string.Join("፤ ", zoneText.Select(x => $"{x.Location}፡ {x.Text.Trim().TrimEnd('።', '.', '፤', ';')}"))።</p>
                        }
                    </div>
                }
            </div>
        </section>
    }

    @if (Model.AnimalMigrationRoutes.Any())
    {
        <section class="card mb-4 shadow-sm border-0">
            <div class="card-header bg-primary bg-opacity-10 fw-bold py-3 ew-numbered"><span class="ew-num"></span><span>በተለያዩ ምክንያት ስደት — የእንስሳት ስደት</span></div>
            <div class="table-responsive">
                <table class="table table-sm table-bordered text-start mb-0">
                    <thead class="table-light"><tr><th>አቅጣጫ</th><th>ከየት ቦታ ተሰደዱ</th><th>ወደ የት ሄዱ / የሄዱበት ቦታ</th><th>የእንስሳት አይነት</th><th>ብዛት</th></tr></thead>
                    <tbody>@foreach (var route in Model.AnimalMigrationRoutes) { <tr><td>@route.Direction</td><td>@route.Origin</td><td>@route.Destination</td><td>@route.AnimalType</td><td class="fw-bold">@route.NumberOfAnimals.ToString("N0")</td></tr> }</tbody>
                </table>
            </div>
        </section>
    }
</div>
