@model (string Action, List<EarlyWarning.ViewModels.WeeklyFormReportWeek> Weeks, DateTime? StartDate, DateTime? EndDate)
@using EarlyWarning.Extensions
@* Week selector in Ethiopian dates; picking a week reloads the page for it. *@
@if (Model.Weeks.Count > 0)
{
    <form method="get" asp-action="@Model.Action" class="d-flex align-items-end gap-2 no-print">
        <div>
            <label for="weekSelect" class="form-label mb-1 fw-bold">የሪፖርት ሳምንት</label>
            <select id="weekSelect" class="form-select" onchange="const [s, e] = this.value.split('|'); this.form.startDate.value = s; this.form.endDate.value = e; this.form.submit();">
                @foreach (var week in Model.Weeks)
                {
                    var value = $"{week.StartDate:yyyy-MM-dd}|{week.EndDate:yyyy-MM-dd}";
                    <option value="@value" selected="@(week.StartDate == Model.StartDate && week.EndDate == Model.EndDate)">
                        @EthiopianDate.FromGregorian(week.StartDate) — @EthiopianDate.FromGregorian(week.EndDate) ዓ/ም
                    </option>
                }
            </select>
        </div>
        <input type="hidden" name="startDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
        <input type="hidden" name="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
    </form>
}
