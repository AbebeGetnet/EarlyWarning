@model ChangePasswordViewModel
@{
    ViewData["Title"] = "የይለፍ ቃል ቀይር";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-header text-white fw-bold" style="background:#276683">
                    <i class="fas fa-key me-2"></i> የይለፍ ቃል ቀይር
                </div>
                <div class="card-body">
                    <form asp-action="ChangePassword" method="post" autocomplete="off">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label fw-bold"></label>
                            <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" autofocus />
                            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-bold"></label>
                            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                            <div class="form-text">ቢያንስ 6 ፊደላት፤ ትልቅ (A-Z) እና ትንሽ (a-z) የእንግሊዝኛ ፊደል፣ ቁጥር እና ምልክት (ለምሳሌ @@ # !) ይያዝ።</div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold"></label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="showPasswords"
                                   onchange="document.querySelectorAll('.card input[autocomplete$=password]').forEach(x => x.type = this.checked ? 'text' : 'password')" />
                            <label class="form-check-label" for="showPasswords">የይለፍ ቃሉን አሳይ</label>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-fill"><i class="fas fa-save me-1"></i> የይለፍ ቃል ቀይር</button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary flex-fill">ተመለስ</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
