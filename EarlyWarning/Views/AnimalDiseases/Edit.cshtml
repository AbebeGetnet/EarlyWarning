@model EarlyWarning.Models.AnimalDisease

@{
    ViewData["Title"] = "የእንስሳት በሽታ ማስተካከያ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="_SettingsPageStyles" />

<div class="container-fluid">
    <div class="page-header">
        <h1><i class="fas fa-edit"></i> @ViewData["Title"]</h1>
        <p>የ"@Model.Name" መረጃን ያስተካክሉ</p>
    </div>

    <div class="form-card">
        <div class="card-header-custom"><i class="fas fa-shield-virus"></i> የበሽታ መረጃ</div>
        <div class="card-body-custom">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <partial name="_AnimalDiseaseFields" model="Model" />
                <div class="form-actions">
                    <a asp-action="Index" class="btn-custom btn-back"><i class="fas fa-arrow-left"></i> ወደ ዝርዝር ተመለስ</a>
                    <button type="submit" class="btn-custom btn-submit"><i class="fas fa-save"></i> አስቀምጥ</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
