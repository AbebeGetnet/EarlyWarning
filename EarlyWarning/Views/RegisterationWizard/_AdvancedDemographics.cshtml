@model (string Prefix, string Title, object Values)
@{
    var rows = new[] {
        ("HouseholdHeads", "አባወራ / እማወራ"),
        ("FamilyMembers", "የቤተሰብ አባላት"),
        ("Children", "ከ5 ዓመት በታች ህጻናት"),
        ("Youth", "ወጣቶች"),
        ("Elderly", "አረጋውያን"),
        ("Disabled", "አካል ጉዳተኞች")
    };
    long maleTotal = 0;
    long femaleTotal = 0;
}
<h6 class="mt-3">@Model.Title</h6>
<div class="table-responsive"><table class="table table-sm table-bordered calc-table"><thead><tr><th>ምድብ</th><th>ወንድ</th><th>ሴት</th><th>ድምር</th></tr></thead><tbody>
@foreach (var row in rows) {
    var male = Convert.ToInt64(Model.Values.GetType().GetProperty($"Male{row.Item1}")?.GetValue(Model.Values) ?? 0);
    var female = Convert.ToInt64(Model.Values.GetType().GetProperty($"Female{row.Item1}")?.GetValue(Model.Values) ?? 0);
    maleTotal += male;
    femaleTotal += female;
    <tr><td>@row.Item2</td><td><input type="number" min="0" name="@(Model.Prefix).Male@(row.Item1)" class="form-control val-male" value="@male" /></td><td><input type="number" min="0" name="@(Model.Prefix).Female@(row.Item1)" class="form-control val-female" value="@female" /></td><td class="row-total">@(male + female)</td></tr>
}
</tbody><tfoot class="table-light fw-bold"><tr><td>ጠቅላላ ድምር</td><td class="total-male">@maleTotal</td><td class="total-female">@femaleTotal</td><td class="grand-total bg-primary text-white">@(maleTotal + femaleTotal)</td></tr></tfoot></table></div>
