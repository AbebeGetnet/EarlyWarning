@model (string Prefix, string Name, string Key, object Values)
@{
    var rows = new[] { ("HouseholdHeads", "አባወራ/እማወራ"), ("FamilyMembers", "ቤተሰብ"), ("Children", "ህፃናት ከ5 ዓመት በታች"), ("Youth", "ወጣቶች"), ("Elderly", "አረጋውያን"), ("Disabled", "አካል ጉዳተኞች") };
  long maleTotal = 0;
  long femaleTotal = 0;
  // Per-type damage fields (Field, Label, Min, Max, Step) that must be filled whenever this card is shown.
  var extras = ViewData["ImpactExtras"] as (string Field, string Label, string Min, string Max, string Step)[] ?? [];
}
<div class="card mb-3 border impact-card d-none" data-impact-key="@Model.Key">
  <div class="card-header fw-bold bg-light">@Model.Name</div>
  <div class="card-body p-2">
  @if (extras.Length > 0) {
    <div class="row g-2 mb-2">
    @foreach (var extra in extras) {
      var raw = Model.Values.GetType().GetProperty(extra.Field)?.GetValue(Model.Values);
      var value = raw == null || Convert.ToDecimal(raw) == 0 ? "" : Convert.ToString(raw, System.Globalization.CultureInfo.InvariantCulture);
      <div class="col-md-4"><label class="form-label fw-bold">@extra.Label <span class="text-danger">*</span></label><input name="@(Model.Prefix).@extra.Field" type="number" min="@extra.Min" max="@extra.Max" step="@extra.Step" value="@value" class="form-control" data-required-when-visible="true" /></div>
    }
    </div>
  }
  <div class="table-responsive"><table class="table table-sm table-bordered mb-0 calc-table"><thead><tr><th>ምድብ</th><th>ወንድ</th><th>ሴት</th><th>ድምር</th></tr></thead><tbody>
  @foreach (var row in rows) {
    var male = Convert.ToInt64(Model.Values.GetType().GetProperty($"Male{row.Item1}")?.GetValue(Model.Values) ?? 0);
    var female = Convert.ToInt64(Model.Values.GetType().GetProperty($"Female{row.Item1}")?.GetValue(Model.Values) ?? 0);
    // Only household heads and family are counted; the other rows are breakdowns of them.
    if (row.Item1 is "HouseholdHeads" or "FamilyMembers") { maleTotal += male; femaleTotal += female; }
    <tr><td>@row.Item2</td><td><input name="@(Model.Prefix).Male@(row.Item1)" type="number" min="0" value="@male" class="form-control val-male" /></td><td><input name="@(Model.Prefix).Female@(row.Item1)" type="number" min="0" value="@female" class="form-control val-female" /></td><td class="row-total">@(male + female)</td></tr>
  }
  </tbody><tfoot class="table-light fw-bold"><tr><td>ጠቅላላ ድምር (አባወራ/እማወራ + ቤተሰብ)</td><td class="total-male">@maleTotal</td><td class="total-female">@femaleTotal</td><td class="grand-total bg-primary text-white">@(maleTotal + femaleTotal)</td></tr></tfoot></table></div></div>
</div>
