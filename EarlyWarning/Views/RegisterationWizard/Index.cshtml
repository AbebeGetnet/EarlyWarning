@model EarlyWarning.ViewModels.RegistrationWithardViewModel
@using EarlyWarning.Enums
@using EarlyWarning.Models
@{
    var serverErrorFields = ViewData.ModelState.Where(x => x.Value?.Errors.Count > 0)
        .Select(x => x.Key).Where(x => !string.IsNullOrWhiteSpace(x)).ToArray();
    var zoneReviewSubmission = ViewBag.ReviewSubmission as WeeklyReportSubmission;
}

@section Styles {
    <style>
        #earlyWarningForm .d-flex > .form-check,
        #earlyWarningForm .d-flex > label:has(input[type="radio"]) {
            margin-right: 2.25rem !important;
            margin-bottom: .75rem;
        }
        #earlyWarningForm input[type="radio"] {
            margin-right: .55rem;
            transform: scale(1.15);
            accent-color: #0d6efd;
        }
        #earlyWarningForm label:has(input[type="radio"]),
        #earlyWarningForm .form-check-label {
            line-height: 1.65;
            cursor: pointer;
        }
        #earlyWarningForm label:has(input[type="radio"]),
        #earlyWarningForm .form-check:has(input[type="radio"]) {
            padding: .3rem .75rem;
            border: 1px solid currentColor;
            border-radius: .4rem;
            font-weight: 700;
            transition: background-color .15s ease, color .15s ease, box-shadow .15s ease;
        }
        #earlyWarningForm label:has(input[type="radio"][value="true"]),
        #earlyWarningForm .form-check:has(input[type="radio"][value="true"]) { color: #198754; }
        #earlyWarningForm label:has(input[type="radio"][value="false"]),
        #earlyWarningForm .form-check:has(input[type="radio"][value="false"]) { color: #dc3545; }
        #earlyWarningForm label:has(input[type="radio"][value="true"]:checked),
        #earlyWarningForm .form-check:has(input[type="radio"][value="true"]:checked) {
            color: #fff;
            background-color: #198754;
            box-shadow: 0 0 0 .18rem rgba(25, 135, 84, .18);
        }
        #earlyWarningForm label:has(input[type="radio"][value="false"]:checked),
        #earlyWarningForm .form-check:has(input[type="radio"][value="false"]:checked) {
            color: #fff;
            background-color: #dc3545;
            box-shadow: 0 0 0 .18rem rgba(220, 53, 69, .18);
        }
        #earlyWarningForm label:has(input[type="radio"]:checked):not(:has(input[value="true"])):not(:has(input[value="false"])),
        #earlyWarningForm .form-check:has(input[type="radio"]:checked):not(:has(input[value="true"])):not(:has(input[value="false"])) {
            color: #fff;
            background-color: #0d6efd;
            box-shadow: 0 0 0 .18rem rgba(13, 110, 253, .18);
        }
        #earlyWarningForm .form-check:has(input[type="radio"]:checked) > label,
        #earlyWarningForm .form-check:has(input[type="radio"]:checked) > .form-check-label,
        #earlyWarningForm label:has(input[type="radio"]:checked) {
            color: #fff !important;
        }
        #earlyWarningForm .form-check:has(input[type="radio"]:not(:checked)) > label,
        #earlyWarningForm .form-check:has(input[type="radio"]:not(:checked)) > .form-check-label {
            color: inherit !important;
        }
        #earlyWarningForm .bool-radio[value="true"] { accent-color: #198754; }
        #earlyWarningForm .bool-radio[value="false"] { accent-color: #dc3545; }
        #earlyWarningForm select.form-select,
        #earlyWarningForm select.form-control {
            display: block;
            width: 100%;
            min-height: 44px;
            margin-top: .45rem;
            margin-bottom: 1rem;
            padding: .55rem 2.35rem .55rem .85rem;
            color: #212529;
            background-color: #fff;
            border: 1px solid #9ca8b4;
            border-radius: .375rem;
            box-shadow: 0 1px 3px rgba(0, 0, 0, .08);
        }
        #earlyWarningForm select.form-select:focus,
        #earlyWarningForm select.form-control:focus {
            border-color: #80bdff;
            box-shadow: 0 0 0 .2rem rgba(0, 123, 255, .18);
            outline: 0;
        }
        #earlyWarningForm td select.form-select,
        #earlyWarningForm td select.form-control {
            margin-top: .15rem;
            margin-bottom: .15rem;
        }
        #earlyWarningForm .conditional-section > label,
        #earlyWarningForm .row > div > label:not(.form-check-label) {
            display: inline-block;
            margin-top: .55rem;
            margin-bottom: .3rem;
            font-weight: 600;
        }
        #earlyWarningForm .row-total,
        #earlyWarningForm .total-male,
        #earlyWarningForm .total-female,
        #earlyWarningForm .grand-total,
        #earlyWarningForm table tfoot td,
        #previewContainer table tfoot td {
            font-weight: 800 !important;
            font-size: 1.05rem;
        }
        #earlyWarningForm .row-total,
        #earlyWarningForm .total-male,
        #earlyWarningForm .total-female {
            color: #172b4d;
            background-color: #eef3f8 !important;
        }
        #earlyWarningForm table tfoot { border-top: 2px solid #536273; }
        @@media (max-width: 576px) {
            #earlyWarningForm .d-flex > .form-check,
            #earlyWarningForm .d-flex > label:has(input[type="radio"]) { margin-right: 1.25rem !important; }
        }
    </style>
}

<div class="container-fluid mt-4">
    <div class="card shadow border-0 rounded-lg">
        <div class="card-header bg-dark text-white p-3 d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="fas fa-magic me-2"></i>@(ViewBag.IsReviewMode == true ? "የወረዳ ሳምንታዊ ሪፖርት ግምገማ (Review Mode)" : "የተቀናጀ የሳምንታዊ መረጃ መሰብሰቢያ ዊዛርድ (Early Warning Data Wizard)")</h4>
            <span class="badge bg-info p-2" id="stepIndicator">ደረጃ 1 ከ 18</span>
        </div>
        
        <div class="progress rounded-0" style="height: 6px;">
            <div id="wizardProgress" class="progress-bar bg-success" role="progressbar" style="width: 12.5%;"></div>
        </div>

        <div class="card-body bg-light">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (ViewBag.SubmissionFailed == true)
            {
                <div class="alert alert-danger shadow-sm" id="submissionFailedAlert" role="alert">
                    <h5 class="alert-heading"><i class="fas fa-exclamation-circle me-2"></i>መረጃው አልተላከም</h5>
                    <p class="mb-2">ከታች ያለውን ስህተት ያስተካክሉና እንደገና ይላኩ።</p>
                    <ul class="mb-0">
                        @foreach (string error in ViewBag.SubmissionErrors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }
            @if (ViewBag.InitialDuplicateMessage != null)
            {
                <div class="alert alert-warning shadow-sm"><i class="fas fa-exclamation-triangle me-2"></i>@ViewBag.InitialDuplicateMessage</div>
            }

            <div id="wizardModeBanner" class="alert alert-info py-2 d-none shadow-sm animate-fade-in">
                <i class="fas fa-info-circle me-2"></i><span id="wizardModeText">አዲስ መረጃ በመፍጠር ላይ...</span>
            </div>

            @if (ViewBag.IsReviewMode == true)
            {
                <div class="alert alert-primary shadow-sm">
                    <i class="fas fa-eye me-2"></i><strong>Review Mode:</strong>
                    የ@ViewBag.WoredaName የተላከ መረጃ በንባብ ብቻ ሁኔታ ተከፍቷል። ሁሉንም 17 ደረጃዎች በመመልከት ያረጋግጡ።
                </div>
            }

            <form asp-action="SubmitWizard" method="post" id="earlyWarningForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger mb-3 card p-2 bg-white @(ViewData.ModelState.IsValid ? "d-none" : "")" id="errorSummaryBox"></div>

                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="WoredaId" />
                <input type="hidden" id="RecordId" name="RecordId" value="0" />

                <div class="wizard-step" id="step1">
                    <div class="p-4 bg-white rounded shadow-sm border-top border-primary border-4">
                        <h4 class="text-primary mb-3"><i class="fas fa-map-marker-alt me-2"></i>መነሻ ፡ አጠቃላይ የአካባቢ እና የጊዜ መረጃ</h4>
                        <div class="alert alert-danger p-2 d-none" id="dateValidationWarning">
                            <i class="fas fa-exclamation-triangle me-2"></i><strong>የቀን ስህተት፡</strong> እባክዎ ካለፉት 8 ቀናት እስከ ዛሬ ያለውን ቀን ብቻ ያስገቡ (የወደፊት ቀን ወይም ከ8 ቀን የበለሰ መረጃ ማስገባት አይቻልም)።
                        </div>
                        <hr />
                        <div class="alert alert-secondary"><strong>የመረጃ ባለቤት ወረዳ፡</strong> @ViewBag.WoredaName <span class="ms-2 text-muted">(በተጠቃሚው መለያ የተወሰነ፤ መቀየር አይቻልም)</span></div>
                        <div class="row">                            
                            <div class="col-md-4">
                                <label class="fw-bold">በወረዳ ያሉ ቀበሌዎች ብዛት</label>
                                <input id="totalWoredaKebeles" class="form-control text-center bg-light fw-bold text-primary" value="@ViewBag.TotalKebeles" readonly disabled />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="StartDate" class="form-label fw-bold">የሪፖርት መነሻ ቀን (ሰኞ)</label>
                                <input asp-for="StartDate" id="StartDate" type="date" class="form-control" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="EndDate" class="form-label fw-bold">የሪፖርት ማጠናቀቂያ ቀን (ረቡዕ)</label>
                                <input asp-for="EndDate" id="EndDate" type="date" class="form-control" readonly />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="wizard-step d-none" id="step2">
                    <div class="p-4 bg-white rounded shadow-sm border-top border-info border-4">
                        <h4 class="text-info mb-3"><i class="fas fa-cloud-showers-heavy me-2"></i>ደረጃ 1፡ የዝናብ ስርጭት ሁኔታ</h4>
                        <div class="alert alert-info py-1 mb-3 bg-opacity-10 text-dark border-info">
                            <i class="fas fa-info-circle me-2 text-info"></i>የወረዳው ጠቅላላ የቀበሌዎች ብዛት ገደብ፦ <span id="woredaKebeleCountBadge" class="fw-bold text-primary">0</span>
                        </div>
                        <hr />
                        <div class="row g-3 mb-3">
                            <div class="col-md-3">
                                <label asp-for="RainfallReport.FullCoverageKebeles" class="form-label"></label>
                                <input asp-for="RainfallReport.FullCoverageKebeles" id="rainFull" class="form-control text-center" type="number" min="0" value="0" />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="RainfallReport.PartialCoverageKebeles" class="form-label"></label>
                                <input asp-for="RainfallReport.PartialCoverageKebeles" id="rainPartial" class="form-control text-center" type="number" min="0" value="0" />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="RainfallReport.NoRainKebeles" class="form-label"></label>
                                <input asp-for="RainfallReport.NoRainKebeles" id="rainNone" class="form-control text-center" type="number" min="0" value="0" />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="RainfallReport.NoDataKebeles" class="form-label"></label>
                                <input asp-for="RainfallReport.NoDataKebeles" id="rainNoData" class="form-control text-center" type="number" min="0" value="0" />
                            </div>
                        </div>
                        <h5 class="text-info border-bottom pb-2 mb-3">የዝናቡ መጠንና ስርጭት</h5>
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label asp-for="RainfallReport.HighAmountKebeles" class="form-label"></label>
                                <input asp-for="RainfallReport.HighAmountKebeles" id="rainHigh" class="form-control text-center" type="number" min="0" value="0" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="RainfallReport.MediumAmountKebeles" class="form-label"></label>
                                <input asp-for="RainfallReport.MediumAmountKebeles" id="rainMedium" class="form-control text-center" type="number" min="0" value="0" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="RainfallReport.MediumHighAmountKebeles" class="form-label"></label>
                                <input asp-for="RainfallReport.MediumHighAmountKebeles" id="rainMediumHigh" class="form-control text-center" type="number" min="0" value="0" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="RainfallReport.LowAmountKebeles" class="form-label"></label>
                                <input asp-for="RainfallReport.LowAmountKebeles" id="rainLow" class="form-control text-center" type="number" min="0" value="0" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="RainfallReport.LowMediumAmountKebeles" class="form-label"></label>
                                <input asp-for="RainfallReport.LowMediumAmountKebeles" id="rainLowMedium" class="form-control text-center" type="number" min="0" value="0" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="RainfallReport.NoDataForRainAmountKebeles" class="form-label"></label>
                                <input asp-for="RainfallReport.NoDataForRainAmountKebeles" id="rainAmountNoData" class="form-control text-center" type="number" min="0" value="0" />
                            </div>
                        </div>
                        <div class="p-3 bg-light rounded shadow-sm border">
                            <label class="form-label fw-bold text-dark"><i class="fas fa-map-signs me-1"></i>በከፍተኛ ዝናብ የተጎዱ ቀበሌዎችን ይምረጡ</label>
                            <div class="row pt-2 ms-1">
                                @if (Model.Kebelies != null)
                                {
                                    foreach (var kebele in Model.Kebelies)
                                    {
                                        <div class="col-md-3 form-check mb-2">
                                            <input class="form-check-input kebele-checkbox" type="checkbox" name="SelectedKebeliesIds" value="@kebele.Id" data-name="@kebele.LocationAmharicName" id="keb_@kebele.Id" />
                                            <label class="form-check-label" for="keb_@kebele.Id">@kebele.LocationAmharicName</label>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                        <div class="p-3 bg-light rounded shadow-sm border mt-3">
                            <label class="form-label fw-bold text-dark"><i class="fas fa-sun me-1"></i>በድርቅ የተጎዱ ከበሌዎችን ይምረጡ</label>
                            <div class="row pt-2 ms-1">
                                @if (Model.Kebelies != null)
                                {
                                    foreach (var kebele in Model.Kebelies)
                                    {
                                        <div class="col-md-3 form-check mb-2">
                                            <input class="form-check-input drought-kebele-checkbox" type="checkbox" name="SelectedDroughtKebeleIds" value="@kebele.Id" data-name="@kebele.LocationAmharicName" id="droughtKeb_@kebele.Id" />
                                            <label class="form-check-label" for="droughtKeb_@kebele.Id">@kebele.LocationAmharicName</label>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="wizard-step d-none" id="step3">
                    <div class="p-4 bg-white rounded shadow-sm border-top border-success border-4">
                        <h4 class="text-success mb-3"><i class="fas fa-seedling me-2"></i>ደረጃ 2፡ የግብርና ስራዎች ክንውን (ሄክታር)</h4>
                        <div class="alert alert-warning p-2 d-none" id="farmPlanValidationError">
                            <i class="fas fa-exclamation-triangle me-2"></i><strong>ስህተት፡</strong> የእቅድ መጠን ከተከናወኑት ማናቸውም መስኮች ማነስ አይችልም።
                        </div>
                        <hr />
                        <div class="row g-3">
                            <div class="col-md-6 border-end">
                                <h5 class="text-muted border-bottom pb-2">የመኸር ወቅት (Meher Season)</h5>
                                <div class="mb-2"><label class="fw-bold">የታቀደ (Plan)</label><input asp-for="FarmingActivity.MeherFarmPlan" id="meherPlan" type="number" step="any" min="0" class="form-control" value="0" /></div>
                                <div class="mb-2"><label>የታረሰ (Ploughed)</label><input asp-for="FarmingActivity.MeherPloughed" id="meherPloughed" type="number" step="any" min="0" class="form-control farm-val-meher" value="0" /></div>
                                <div class="mb-2"><label>የተዘራ (Sown)</label><input asp-for="FarmingActivity.MeherSown" id="meherSown" type="number" step="any" min="0" class="form-control farm-val-meher" value="0" /></div>
                                <div class="mb-2"><label>የተሰበሰበ (Harvesting)</label><input asp-for="FarmingActivity.MeherHarvestingHHarvesting" id="meherHarvesting" type="number" step="any" min="0" class="form-control farm-val-meher" value="0" /></div>
                                <div class="mb-2"><label>በቀሪ እርጥበት የተዘራ</label><input asp-for="FarmingActivity.MeherSownWithResidualMoisture" id="meherResidual" type="number" step="any" min="0" class="form-control farm-val-meher" value="0" /></div>
                            </div>
                            <div class="col-md-6">
                                <h5 class="text-muted border-bottom pb-2">የበልግ ወቅት (Autumn/Belg Season)</h5>
                                <div class="mb-2"><label class="fw-bold">የታቀደ (Plan)</label><input asp-for="FarmingActivity.AutumnFarmPlan" id="autumnPlan" type="number" step="any" min="0" class="form-control" value="0" /></div>
                                <div class="mb-2"><label>የታረሰ (Ploughed)</label><input asp-for="FarmingActivity.AutumnPloughed" id="autumnPloughed" type="number" step="any" min="0" class="form-control farm-val-autumn" value="0" /></div>
                                <div class="mb-2"><label>የተዘራ (Sown)</label><input asp-for="FarmingActivity.AutumnSown" id="autumnSown" type="number" step="any" min="0" class="form-control farm-val-autumn" value="0" /></div>
                                <div class="mb-2"><label>የተሰበሰበ (Harvesting)</label><input asp-for="FarmingActivity.AutumnHarvestingHHarvesting" id="autumnHarvesting" type="number" step="any" min="0" class="form-control farm-val-autumn" value="0" /></div>
                                <div class="mb-2"><label>በቀሪ እርጥበት የተዘራ</label><input asp-for="FarmingActivity.AutumnSownWithResidualMoisture" id="autumnResidual" type="number" step="any" min="0" class="form-control farm-val-autumn" value="0" /></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="wizard-step d-none" id="step4">
                    <div class="p-4 bg-white rounded shadow-sm border-top border-warning border-4">
                        <h4 class="text-warning mb-3"><i class="fas fa-bug me-2"></i>ደረጃ 3፡ የሰብል ሁኔታ</h4>
                        <hr />
                        <div class="card border-success mb-4">
                            <div class="card-header bg-success bg-opacity-10 text-success fw-bold">3.1፡ የሰብል እድገትና አቋም ሁኔታ</div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-4"><label asp-for="CropGrowth.AtSeedStage" class="form-label">በዘር ደረጃ</label><input asp-for="CropGrowth.AtSeedStage" id="cropSeedStage" class="form-control" type="number" step="0.01" min="0" /></div>
                                    <div class="col-md-4"><label asp-for="CropGrowth.AtGerminationStage" class="form-label">በብቅለት ደረጃ</label><input asp-for="CropGrowth.AtGerminationStage" id="cropGerminationStage" class="form-control" type="number" step="0.01" min="0" /></div>
                                    <div class="col-md-4"><label asp-for="CropGrowth.AtGrowthStage" class="form-label">በእድገት ደረጃ</label><input asp-for="CropGrowth.AtGrowthStage" id="cropGrowthStage" class="form-control" type="number" step="0.01" min="0" /></div>
