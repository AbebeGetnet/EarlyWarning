        function hydrateCollectionRows(prefix, key, rows) {
            (rows || []).forEach(item => {
                const hidden = [...document.querySelectorAll(`input[name^="${prefix}["][name$="].${key}"]`)].find(x => x.value.toLowerCase() === String(item[key.charAt(0).toLowerCase() + key.slice(1)]).toLowerCase());
                const row = hidden?.closest('.impact-card') || hidden?.closest('tr') ||
                    (hidden?.nextElementSibling?.classList.contains('impact-card') ? hidden.nextElementSibling : null);
                if (!row) return;
                Object.entries(item).forEach(([property, value]) => {
                    const pascal = property.charAt(0).toUpperCase() + property.slice(1);
                    const checkboxes = row.querySelectorAll(`input[type="checkbox"][name$="].${pascal}"]`);
                    if (checkboxes.length) {
                        const selected = (Array.isArray(value) ? value : [value]).map(String);
                        checkboxes.forEach(box => box.checked = selected.includes(box.value));
                        return;
                    }
                    const input = row.querySelector(`[name$="].${pascal}"]`);
                    if (input) input.value = value ?? '';
                });
            });
        }

        function mapDemographicInputs(rowDOM, maleVal, femaleVal) {
            if(!rowDOM) return;
            const male = Number(maleVal) || 0;
            const female = Number(femaleVal) || 0;
            rowDOM.querySelector(".val-male").value = male;
            rowDOM.querySelector(".val-female").value = female;
            rowDOM.querySelector(".row-total").innerText = (male + female).toLocaleString();
        }

        function resetWizardForm() {
            document.getElementById("remarksInput").value = "";
            document.querySelectorAll("input[type='number']").forEach(el => el.value = "0");
            document.querySelectorAll("input[type='text']").forEach(el => el.value = "");
            document.querySelectorAll("input[type='checkbox']").forEach(el => el.checked = false);
            
            document.getElementById("hasPestNo").checked = true;
            document.getElementById("pastureEnoughYes").checked = true;
            document.getElementById("waterEnoughYes").checked = true;
            document.getElementById("healthEnoughYes").checked = true;
            
            toggleCropPestFields();
            togglePastureFields();
            toggleWaterFields();
            toggleBodyConditionFields();
            toggleAnimalHealthFields();
            document.querySelectorAll('.calc-table').forEach(t => calculateGridTotals(t));
        }

        // =======================================================
        // REAL-TIME MATHEMATICAL MATRIX GRID CALCULATION ENGINE
        // =======================================================
        function initMatrixCalculations() {
            document.querySelectorAll('.calc-table').forEach(table => {
                table.querySelectorAll('tbody tr').forEach(row => {
                    const maleInput = row.querySelector('.val-male');
                    const femaleInput = row.querySelector('.val-female');

                    if(maleInput && femaleInput) {
                        const calculateRow = () => {
                            let mValue = parseInt(maleInput.value) || 0;
                            let fValue = parseInt(femaleInput.value) || 0;
                            row.querySelector('.row-total').innerText = (mValue + fValue).toLocaleString();
                            calculateGridTotals(table);
                        };
                        maleInput.addEventListener('input', calculateRow);
                        femaleInput.addEventListener('input', calculateRow);
                    }
                });
                calculateGridTotals(table);
            });
        }

        // Totals count household heads + family only; the age and disability rows are checked against
        // them but never added (wwwroot/js/beneficiaries.js, mirrored by Extensions/Beneficiaries.cs).
        function calculateGridTotals(table) {
            return window.Beneficiaries.calculate(table);
        }

        function calculateMigrationTotals(table) {
            let total = 0;
            table.querySelectorAll('tbody tr').forEach(row => {
                const count = parseInt(row.querySelector('.migration-count')?.value) || 0;
                total += count;
                const rowTotal = row.querySelector('.migration-row-total');
                if (rowTotal) rowTotal.innerText = count.toLocaleString();
            });
            const columnTotal = table.querySelector('.migration-column-total');
            const grandTotal = table.querySelector('.migration-grand-total');
            if (columnTotal) columnTotal.innerText = total.toLocaleString();
            if (grandTotal) grandTotal.innerText = total.toLocaleString();
        }

