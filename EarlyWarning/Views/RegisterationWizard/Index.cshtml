        // =======================================================
        // ASYNC STEP STEP-TRANSITION VALIDATOR WITH BOUNDARY CHECKS
        // =======================================================
        async function validateCurrentStep() {
            let valid = true;
            updateMaxKebeleLimit();
            syncConditionalRequired();
            const nativeInvalid = Array.from(steps[currentStep].querySelectorAll('input, select, textarea'))
                .find(field => field.type !== 'hidden' && field.offsetParent !== null && !field.checkValidity());
            if (nativeInvalid) {
                navigateToField(nativeInvalid);
                nativeInvalid.reportValidity();
                return false;
            }
            
            // STEP 1 CONTEXT CHECK
            if (currentStep === 0) {
                const woredaSelect = document.getElementById("WoredaId");
                const startDateInput = document.getElementById("StartDate");
                const dateWarningAlert = document.getElementById("dateValidationWarning");

                if (!woredaSelect.value) { woredaSelect.classList.add("is-invalid"); valid = false; } 
                else { woredaSelect.classList.remove("is-invalid"); }

                if (startDateInput.value) {
                    const selectedDate = new Date(startDateInput.value);
                    selectedDate.setHours(0,0,0,0);
                    const today = new Date();
                    today.setHours(0,0,0,0);
                    const oldestAllowedDate = new Date(today);
                    oldestAllowedDate.setDate(today.getDate() - 8);

                    if (selectedDate < oldestAllowedDate || selectedDate > today) {
                        startDateInput.classList.add("is-invalid");
                        dateWarningAlert.classList.remove("d-none");
                        valid = false;
                    } else {
                        startDateInput.classList.remove("is-invalid");
                        dateWarningAlert.classList.add("d-none");
                    }
                } else { startDateInput.classList.add("is-invalid"); valid = false; }
                // #StartDate is hidden; show the error on the Ethiopian date picker instead.
                document.querySelectorAll('#ethStartPicker select').forEach(select =>
                    select.classList.toggle('is-invalid', startDateInput.classList.contains('is-invalid')));

                if (!valid) {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                    return false;
                }

                const duplicate = await checkSelectedWeek();
                if (duplicate?.exists && !duplicate.editable) {
                    showWizardMessage(duplicate.message, 'danger');
                    navigateToField(startDateInput);
                    return false;
                }
                serverDraftEnabled = true;
                if (duplicate?.offline) {
                    // No connection: continue on this device; the draft is uploaded once the server answers.
                } else {
                    if (!duplicate?.exists && !await saveServerDraft(true)) return false;
                    try {
                        await loadExistingWeeklyData(true);
                    } catch (err) {
                        if (isNetworkError(err)) goneOffline();
                        else console.error("Database graph API error:", err);
                    }
                }
            }
            
            // STEP 2 METADATA GEOMETRIC SUM LIMIT EVALUATION (Rainfall Report)
            if (currentStep === 1) {
                let rFull = parseInt(document.getElementById("rainFull").value) || 0;
                let rPartial = parseInt(document.getElementById("rainPartial").value) || 0;
                let rNone = parseInt(document.getElementById("rainNone").value) || 0;
                let rNoData = parseInt(document.getElementById("rainNoData").value) || 0;
                const rainAmountFields = ["rainHigh", "rainMedium", "rainMediumHigh", "rainLow", "rainLowMedium", "rainAmountNoData"];
                const totalRainAmountKebeles = rainAmountFields
                    .reduce((total, id) => total + (parseInt(document.getElementById(id).value) || 0), 0);

                let totalReportedKebeles = rFull + rPartial + rNone + rNoData;
                const rainFields = ["rainFull", "rainPartial", "rainNone", "rainNoData", ...rainAmountFields];
                
                rainFields.forEach(id => {
                    let el = document.getElementById(id);
                    if (parseInt(el.value) > currentWoredaMaxKebeles) { el.classList.add("is-invalid"); valid = false; } 
                    else { el.classList.remove("is-invalid"); }
                });

                if (totalReportedKebeles > currentWoredaMaxKebeles || totalRainAmountKebeles > currentWoredaMaxKebeles) {
                    valid = false;
                    alert(`⚠️ የተመዘገበው የቀበሌዎች ቁጥር ድምር ከወረዳው ጠቅላላ ቀበሌዎች ብዛት (${currentWoredaMaxKebeles}) መብለጥ አይችልም! እባክዎ ያርሙ።`);
                }
                if (!valid) window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            // STEP 3 LAND ALLOCATION HIERARCHY EVALUATIONS
            if (currentStep === 2) {
                const errorAlert = document.getElementById("farmPlanValidationError");
                errorAlert.classList.add("d-none");
                document.querySelectorAll(".farm-val-meher, .farm-val-autumn, #meherPlan, #autumnPlan").forEach(el => el.classList.remove("is-invalid"));

                // Ploughed may exceed the plan; seeded <= ploughed and harvested <= seeded.
                // Residual-moisture sowing keeps its existing limit of the plan.
                const farmErrors = [];
                const areaValue = id => parseFloat(document.getElementById(id).value) || 0;
                const flagArea = (id, limitId, message) => {
                    if (areaValue(id) <= areaValue(limitId)) return;
                    document.getElementById(id).classList.add("is-invalid");
                    document.getElementById(limitId).classList.add("is-invalid");
                    farmErrors.push(message);
                    valid = false;
                };
                [["meher", "መኸር"], ["autumn", "በልግ"]].forEach(([season, seasonName]) => {
                    flagArea(`${season}Sown`, `${season}Ploughed`, `የ${seasonName} የተዘራ መሬት ከታረሰው መሬት መብለጥ አይችልም።`);
                    flagArea(`${season}Harvesting`, `${season}Sown`, `የ${seasonName} የተሰበሰበ መሬት ከተዘራው መሬት መብለጥ አይችልም።`);
                    flagArea(`${season}Residual`, `${season}Plan`, `የ${seasonName} በቀሪ እርጥበት የተዘራ መሬት ከእቅዱ መብለጥ አይችልም።`);
                });
                if (!valid) {
                    document.getElementById("farmPlanValidationMessage").textContent = farmErrors.join(" ");
                    errorAlert.classList.remove("d-none");
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            }

            // STEP 5 VALIDATION: PASTURE-SHORTAGE KEBELE BOUNDARY CHECK
            if (currentStep === 4) {
                const pastureKebelesInput = document.getElementById("pastureKebelesCount");
                const pastureFieldsActive = document.querySelector('input[name="pastureEnoughRadio"]:checked').value === "false";

                if (pastureFieldsActive) {
                    let pastureKebelesCount = parseInt(pastureKebelesInput.value) || 0;

                    if (pastureKebelesCount > currentWoredaMaxKebeles) {
                        pastureKebelesInput.classList.add("is-invalid");
                        alert(`⚠️ የግጦሽ ችግር ያለባቸው ቀበሌዎች ብዛት (${pastureKebelesCount}) ከወረዳው ጠቅላላ ቀበሌዎች ብዛት (${currentWoredaMaxKebeles}) ሊበልጥ አይችልም!`);
                        valid = false;
                        window.scrollTo({ top: pastureKebelesInput.offsetTop - 100, behavior: 'smooth' });
                    } else {
                        pastureKebelesInput.classList.remove("is-invalid");
                    }
                }
            }

            // STEP 6 VALIDATION: ANIMAL WATER SUPPLY FIELD BOUNDARY CHECK
            if (currentStep === 5) {
                const waterKebelesInput = document.getElementById("waterKebelesCount");
                const waterFieldsActive = document.querySelector('input[name="waterEnoughRadio"]:checked').value === "false";
                
                if (waterFieldsActive) {
                    let waterKebelesCount = parseInt(waterKebelesInput.value) || 0;
                    
                    if (waterKebelesCount > currentWoredaMaxKebeles) {
                        waterKebelesInput.classList.add("is-invalid");
                        alert(`⚠️ የውሃ እጥረት የታየባቸው ቀበሌዎች ብዛት (${waterKebelesCount}) ከወረዳው ጠቅላላ ቀበሌዎች ብዛት (${currentWoredaMaxKebeles}) ሊበልጥ አይችልም!`);
                        valid = false;
                        window.scrollTo({ top: waterKebelesInput.offsetTop - 100, behavior: 'smooth' });
                    } else {
                        waterKebelesInput.classList.remove("is-invalid");
                    }
                }
            }

            // STEP 6 VALIDATION: ANIMAL BODY CONDITION (REASON REQUIRED WHEN LOW)
            if (currentStep === 5 && valid) {
                const isHigh = document.getElementById("bodyConditionHigh").checked;
                const isMedium = document.getElementById("bodyConditionMedium").checked;
                const isLow = document.getElementById("bodyConditionLow").checked;
                const reasonInput = document.getElementById("bodyConditionReason");

                if (!isHigh && !isMedium && !isLow) {
                    alert("⚠️ እባክዎ የእንስሳት አቋም ይምረጡ (ከፍተኛ፣ መካከለኛ ወይም ዝቅተኛ)።");
                    valid = false;
                } else if (isLow && !reasonInput.value.trim()) {
                    reasonInput.classList.add("is-invalid");
                    alert("⚠️ የእንስሳት አቋም ዝቅተኛ ከሆነ ምክንያቱን ይግለጹ።");
                    valid = false;
                } else {
                    reasonInput.classList.remove("is-invalid");
                }
            }

            // Human drinking-water and human epidemic affected-kebele boundaries.
            if (currentStep === 7 || currentStep === 8) {
                const id = currentStep === 7 ? 'HumanDrinkWaterIssue_NumberOfAffectedKebeles' : 'EpidemicDisease_NumberOfAffectedKebeles';
                const input = document.getElementById(id);
                const count = Number(input?.value) || 0;
                if (count > currentWoredaMaxKebeles) {
                    input.classList.add('is-invalid');
                    alert(`⚠️ የችግሩ ቀበሌዎች ቁጥር (${count}) ከወረዳው ጠቅላላ ቀበሌዎች (${currentWoredaMaxKebeles}) ሊበልጥ አይችልም።`);
                    valid = false;
                } else if (input) input.classList.remove('is-invalid');
            }

            return valid;
        }

