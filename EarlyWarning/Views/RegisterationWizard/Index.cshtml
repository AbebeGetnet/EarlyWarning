                                    </thead>
                                    <tbody>
                                        <tr><td class="bg-light fw-bold" data-label="አባወራ / እማወራ">አባወራ / እማወራ</td><td><input asp-for="AnimalWaterSupplyStatus.MaleHouseHold" class="form-for-int form-control text-center val-male" type="number" min="0" value="0" /></td><td><input asp-for="AnimalWaterSupplyStatus.FemaleHouseHold" class="form-for-int form-control text-center val-female" type="number" min="0" value="0" /></td><td class="fw-bold bg-light row-total">0</td></tr>
                                        <tr><td class="bg-light fw-bold" data-label="የቤተሰብ አባላት">የቤተሰብ አባላት</td><td><input asp-for="AnimalWaterSupplyStatus.MaleFamily" class="form-for-int form-control text-center val-male" type="number" min="0" value="0" /></td><td><input asp-for="AnimalWaterSupplyStatus.FemaleFamily" class="form-for-int form-control text-center val-female" type="number" min="0" value="0" /></td><td class="fw-bold bg-light row-total">0</td></tr>
                                        <tr><td class="bg-light fw-bold" data-label="ህፃናት ከ5 ዓመት በታች">ህፃናት ከ5 ዓመት በታች</td><td><input asp-for="AnimalWaterSupplyStatus.ChildhMale" class="form-for-int form-control text-center val-male" type="number" min="0" value="0" /></td><td><input asp-for="AnimalWaterSupplyStatus.ChildFemale" class="form-for-int form-control text-center val-female" type="number" min="0" value="0" /></td><td class="fw-bold bg-light row-total">0</td></tr>
