        }

        // =======================================================
        // ASYNC STEP STEP-TRANSITION VALIDATOR WITH BOUNDARY CHECKS
        // =======================================================
        async function validateCurrentStep() {
            let valid = true;
            updateMaxKebeleLimit();
            const nativeInvalid = Array.from(steps[currentStep].querySelectorAll('input, select, textarea'))
                .find(field => field.type !== 'hidden' && field.offsetParent !== null && !field.checkValidity());
            if (nativeInvalid) {
                navigateToField(nativeInvalid);
                nativeInvalid.reportValidity();
                return false;
            }
            
            // STEP 1 CONTEXT CHECK
            if (currentStep === 0) {
                const woredaSelect = document.getElementById("WoredaId");
                const startDateInput = document.getElementById("StartDate");
                const dateWarningAlert = document.getElementById("dateValidationWarning");

                if (!woredaSelect.value) { woredaSelect.classList.add("is-invalid"); valid = false; } 
                else { woredaSelect.classList.remove("is-invalid"); }

                if (startDateInput.value) {
                    const selectedDate = new Date(startDateInput.value);
                    selectedDate.setHours(0,0,0,0);
                    const today = new Date();
                    today.setHours(0,0,0,0);
                    const oldestAllowedDate = new Date(today);
                    oldestAllowedDate.setDate(today.getDate() - 8);

                    if (selectedDate < oldestAllowedDate || selectedDate > today) {
                        startDateInput.classList.add("is-invalid");
                        dateWarningAlert.classList.remove("d-none");
                        valid = false;
                    } else {
                        startDateInput.classList.remove("is-invalid");
                        dateWarningAlert.classList.add("d-none");
                    }
                } else { startDateInput.classList.add("is-invalid"); valid = false; }

                if (!valid) {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                    return false;
                }

                const duplicate = await checkSelectedWeek();
                if (duplicate?.exists && !duplicate.editable) {
                    showWizardMessage(duplicate.message, 'danger');
                    navigateToField(startDateInput);
                    return false;
                }
                serverDraftEnabled = true;
                if (!duplicate?.exists && !await saveServerDraft(true)) return false;

                try {
                    await loadExistingWeeklyData(true);
                } catch (err) { console.error("Database graph API error:", err); }
            }
            
            // STEP 2 METADATA GEOMETRIC SUM LIMIT EVALUATION (Rainfall Report)
            if (currentStep === 1) {
                let rFull = parseInt(document.getElementById("rainFull").value) || 0;
                let rPartial = parseInt(document.getElementById("rainPartial").value) || 0;
                let rNone = parseInt(document.getElementById("rainNone").value) || 0;
                let rNoData = parseInt(document.getElementById("rainNoData").value) || 0;
                const rainAmountFields = ["rainHigh", "rainMedium", "rainMediumHigh", "rainLow", "rainLowMedium", "rainAmountNoData"];
                const totalRainAmountKebeles = rainAmountFields
                    .reduce((total, id) => total + (parseInt(document.getElementById(id).value) || 0), 0);

                let totalReportedKebeles = rFull + rPartial + rNone + rNoData;
                const rainFields = ["rainFull", "rainPartial", "rainNone", "rainNoData", ...rainAmountFields];
                
                rainFields.forEach(id => {
                    let el = document.getElementById(id);
                    if (parseInt(el.value) > currentWoredaMaxKebeles) { el.classList.add("is-invalid"); valid = false; } 
                    else { el.classList.remove("is-invalid"); }
                });

                if (totalReportedKebeles > currentWoredaMaxKebeles || totalRainAmountKebeles > currentWoredaMaxKebeles) {
                    valid = false;
                    alert(`⚠️ የተመዘገበው የቀበሌዎች ቁጥር ድምር ከወረዳው ጠቅላላ ቀበሌዎች ብዛት (${currentWoredaMaxKebeles}) መብለጥ አይችልም! እባክዎ ያርሙ።`);
                }
                if (!valid) window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            // STEP 3 LAND ALLOCATION HIERARCHY EVALUATIONS
            if (currentStep === 2) {
                const errorAlert = document.getElementById("farmPlanValidationError");
                errorAlert.classList.add("d-none");
                document.querySelectorAll(".farm-val-meher, .farm-val-autumn, #meherPlan, #autumnPlan").forEach(el => el.classList.remove("is-invalid"));

                let meherPlanVal = parseFloat(document.getElementById("meherPlan").value) || 0;
                document.querySelectorAll(".farm-val-meher").forEach(input => {
                    if ((parseFloat(input.value) || 0) > meherPlanVal) { input.classList.add("is-invalid"); document.getElementById("meherPlan").classList.add("is-invalid"); valid = false; }
                });

                let autumnPlanVal = parseFloat(document.getElementById("autumnPlan").value) || 0;
                document.querySelectorAll(".farm-val-autumn").forEach(input => {
                    if ((parseFloat(input.value) || 0) > autumnPlanVal) { input.classList.add("is-invalid"); document.getElementById("autumnPlan").classList.add("is-invalid"); valid = false; }
                });
                if (!valid) { errorAlert.classList.remove("d-none"); window.scrollTo({ top: 0, behavior: 'smooth' }); }
            }

            // STEP 6 VALIDATION: ANIMAL WATER SUPPLY FIELD BOUNDARY CHECK
            if (currentStep === 5) {
                const waterKebelesInput = document.getElementById("waterKebelesCount");
                const waterFieldsActive = document.querySelector('input[name="waterEnoughRadio"]:checked').value === "false";
                
                if (waterFieldsActive) {
                    let waterKebelesCount = parseInt(waterKebelesInput.value) || 0;
                    
                    if (waterKebelesCount > currentWoredaMaxKebeles) {
                        waterKebelesInput.classList.add("is-invalid");
                        alert(`⚠️ የውሃ እጥረት የታየባቸው ቀበሌዎች ብዛት (${waterKebelesCount}) ከወረዳው ጠቅላላ ቀበሌዎች ብዛት (${currentWoredaMaxKebeles}) ሊበልጥ አይችልም!`);
                        valid = false;
                        window.scrollTo({ top: waterKebelesInput.offsetTop - 100, behavior: 'smooth' });
                    } else {
                        waterKebelesInput.classList.remove("is-invalid");
                    }
                }
            }

            // Human drinking-water and human epidemic affected-kebele boundaries.
            if (currentStep === 7 || currentStep === 8) {
                const id = currentStep === 7 ? 'HumanDrinkWaterIssue_NumberOfAffectedKebeles' : 'EpidemicDisease_NumberOfAffectedKebeles';
                const input = document.getElementById(id);
                const count = Number(input?.value) || 0;
                if (count > currentWoredaMaxKebeles) {
                    input.classList.add('is-invalid');
                    alert(`⚠️ የችግሩ ቀበሌዎች ቁጥር (${count}) ከወረዳው ጠቅላላ ቀበሌዎች (${currentWoredaMaxKebeles}) ሊበልጥ አይችልም።`);
                    valid = false;
                } else if (input) input.classList.remove('is-invalid');
            }

            return valid;
        }

        // =======================================================
        // HYDRATION AND DATA FLOW SCHEDULER
        // =======================================================
        function hydrateWizardForm(data) {
            if (data.recordStartDate) document.getElementById('StartDate').value = data.recordStartDate;
            if (data.recordEndDate) document.getElementById('EndDate').value = data.recordEndDate;
            document.getElementById("remarksInput").value = data.remarks || "";

            if (data.totalKebelesCount) {
                document.getElementById("totalWoredaKebeles").value = data.totalKebelesCount;
            }
            updateMaxKebeleLimit();

            if (data.rainfall) {
                document.getElementById("rainFull").value = data.rainfall.full;
                document.getElementById("rainPartial").value = data.rainfall.partial;
                document.getElementById("rainNone").value = data.rainfall.none;
                document.getElementById("rainNoData").value = data.rainfall.noData;
                document.getElementById("rainHigh").value = data.rainfall.high;
                document.getElementById("rainMedium").value = data.rainfall.medium;
                document.getElementById("rainMediumHigh").value = data.rainfall.mediumHigh;
                document.getElementById("rainLow").value = data.rainfall.low;
                document.getElementById("rainLowMedium").value = data.rainfall.lowMedium;
                document.getElementById("rainAmountNoData").value = data.rainfall.amountNoData;
                const kebeleIds = data.rainfall.kebeleIds || [];
                document.querySelectorAll(".kebele-checkbox").forEach(cb => cb.checked = kebeleIds.map(String).includes(cb.value));
                const droughtKebeleIds = data.rainfall.droughtKebeleIds || [];
                document.querySelectorAll(".drought-kebele-checkbox").forEach(cb => cb.checked = droughtKebeleIds.map(String).includes(cb.value));
            }

            if (data.farming) {
                document.getElementById("meherPlan").value = data.farming.meherPlan;
                document.getElementById("meherPloughed").value = data.farming.meherPloughed;
                document.getElementById("meherSown").value = data.farming.meherSown;
                document.getElementById("meherHarvesting").value = data.farming.meherHarvesting;
                document.getElementById("meherResidual").value = data.farming.meherResidual;
                document.getElementById("autumnPlan").value = data.farming.autumnPlan;
                document.getElementById("autumnPloughed").value = data.farming.autumnPloughed;
                document.getElementById("autumnSown").value = data.farming.autumnSown;
                document.getElementById("autumnHarvesting").value = data.farming.autumnHarvesting;
                document.getElementById("autumnResidual").value = data.farming.autumnResidual;
            }

            if (data.cropGrowth) {
                document.getElementById("cropSeedStage").value = data.cropGrowth.seed;
                document.getElementById("cropGerminationStage").value = data.cropGrowth.germination;
                document.getElementById("cropGrowthStage").value = data.cropGrowth.growth;
                document.getElementById("cropFruitStage").value = data.cropGrowth.fruit;
                document.getElementById("cropHarvestingStage").value = data.cropGrowth.harvesting;
            }

            if (data.pest) {
                document.getElementById(`hasPest${data.pest.hasOccured ? 'Yes' : 'No'}`).checked = true;
                document.getElementById("pestHectars").value = data.pest.hectars;
                document.getElementById("pestCropType").value = data.pest.cropType || "";
                const pestIds = data.pest.pestIds || [];
                document.querySelectorAll(".pest-checkbox").forEach(cb => { cb.checked = pestIds.map(String).includes(cb.value); cb.dispatchEvent(new Event('change')); });
                const rows = document.getElementById("pestTable").querySelectorAll("tbody tr");
                mapDemographicInputs(rows[0], data.pest.mHH, data.pest.fHH);
                mapDemographicInputs(rows[1], data.pest.mFam, data.pest.fFam);
                mapDemographicInputs(rows[2], data.pest.mChild, data.pest.fChild);
                mapDemographicInputs(rows[3], data.pest.mYouth, data.pest.fYouth);
                mapDemographicInputs(rows[4], data.pest.mEld, data.pest.fEld);
                mapDemographicInputs(rows[5], data.pest.mDis, data.pest.fDis);
                toggleCropPestFields();
            }

            if (data.pasture) {
                document.getElementById(`pastureEnough${data.pasture.enough ? 'Yes' : 'No'}`).checked = true;
                document.getElementById("pastureAnimalsAffected").value = data.pasture.animalsAffected;
                const rows = document.getElementById("pastureTable").querySelectorAll("tbody tr");
                mapDemographicInputs(rows[0], data.pasture.mHH, data.pasture.fHH);
                mapDemographicInputs(rows[1], data.pasture.mFam, data.pasture.fFam);
                mapDemographicInputs(rows[2], data.pasture.mChild, data.pasture.fChild);
                mapDemographicInputs(rows[3], data.pasture.mYouth, data.pasture.fYouth);
                mapDemographicInputs(rows[4], data.pasture.mEld, data.pasture.fEld);
                mapDemographicInputs(rows[5], data.pasture.mDis, data.pasture.fDis);
                togglePastureFields();
            }

            if (data.water) {
                document.getElementById(`waterEnough${data.water.enough ? 'Yes' : 'No'}`).checked = true;
                document.getElementById("waterKebelesCount").value = data.water.kebelesCount;
                const rows = document.getElementById("waterTable").querySelectorAll("tbody tr");
                mapDemographicInputs(rows[0], data.water.mHH, data.water.fHH);
                mapDemographicInputs(rows[1], data.water.mFam, data.water.fFam);
                mapDemographicInputs(rows[2], data.water.mChild, data.water.fChild);
                mapDemographicInputs(rows[3], data.water.mYouth, data.water.fYouth);
                mapDemographicInputs(rows[4], data.water.mEld, data.water.fEld);
                mapDemographicInputs(rows[5], data.water.mDis, data.water.fDis);
                toggleWaterFields();
            }

            if (data.health) {
                document.getElementById(`healthEnough${data.health.enough ? 'Yes' : 'No'}`).checked = true;
                document.getElementById("healthAnimalsMale").value = data.health.infectedMale;
                const healthFemale = document.getElementById("healthAnimalsFemale");
                if (healthFemale) healthFemale.value = data.health.infectedFemale || 0;
                const diseaseIds = data.health.diseaseIds || [];
                document.querySelectorAll(".health-checkbox").forEach(cb => { cb.checked = diseaseIds.map(String).includes(cb.value); cb.dispatchEvent(new Event('change')); });
                const rows = document.getElementById("healthTable").querySelectorAll("tbody tr");
                mapDemographicInputs(rows[0], data.health.mHH, data.health.fHH);
                mapDemographicInputs(rows[1], data.health.mFam, data.health.fFam);
                mapDemographicInputs(rows[2], data.health.mChild, data.health.fChild);
                mapDemographicInputs(rows[3], data.health.mYouth, data.health.fYouth);
                mapDemographicInputs(rows[4], data.health.mEld, data.health.fEld);
                mapDemographicInputs(rows[5], data.health.mDis, data.health.fDis);
                toggleAnimalHealthFields();
            }

            Object.entries(data.extendedFields || {}).forEach(([name, value]) => {
                const field = document.querySelector(`[name="${name}"]`);
                if (!field) return;
                if (field.type === 'checkbox') field.checked = value === true;
                else field.value = value ?? '';
                if (field.classList.contains('section-toggle')) field.dispatchEvent(new Event('change'));
            });
            syncAllBoolRadios();
            const storedInward = String(document.getElementById('migrationIsInward')?.value).toLowerCase() === 'true';
            const directionRadio = document.querySelector(`.migration-direction[value="${storedInward}"]`);
            if (directionRadio) directionRadio.checked = true;
            syncMigrationDirection();
            const checkIds = (name, ids) => document.querySelectorAll(`[name="${name}"]`).forEach(x => { x.checked = (ids || []).map(String).includes(x.value); x.dispatchEvent(new Event('change')); });
            checkIds('SelectedHumanWaterKebeleIds', data.selectedHumanWaterKebeleIds);
            checkIds('SelectedEpidemicDiseaseTypeIds', data.selectedEpidemicDiseaseTypeIds);
            checkIds('SelectedAccidentTypeIds', data.selectedAccidentTypeIds);
            hydrateCollectionRows('GrainPriceRows', 'GrainTypeId', data.grainPriceRows);
            hydrateCollectionRows('AnimalPriceRows', 'AnimalTypeId', data.animalPriceRows);
            hydrateCollectionRows('AidDistributionDetails', 'SupplyTypeId', data.aidDistributionDetails);
            hydrateCollectionRows('CropPestImpactDetails', 'CropPestAndDeseaseId', data.cropPestImpactDetails);
            hydrateCollectionRows('AnimalDiseaseImpactDetails', 'AnimalDiseaseId', data.animalDiseaseImpactDetails);
            hydrateCollectionRows('EpidemicImpactDetails', 'EpidemicDiseaseTypeId', data.epidemicImpactDetails);
            hydrateCollectionRows('AccidentDetails', 'AccidentTypeId', data.accidentImpactDetails);
            if (data.inwardAnimalMigrationOriginId) document.querySelector('[name="InwardAnimalMigrationOriginId"]').value = data.inwardAnimalMigrationOriginId;
            if (data.outwardAnimalMigrationDestinationId) document.querySelector('[name="OutwardAnimalMigrationDestinationId"]').value = data.outwardAnimalMigrationDestinationId;
            const savedAnimalDirection = data.animalMigrationDirection || 'Inward';
            const savedAnimalDirectionRadio = document.querySelector(`.animal-migration-direction[value="${savedAnimalDirection}"]`);
            if (savedAnimalDirectionRadio) savedAnimalDirectionRadio.checked = true;
            syncAnimalMigrationDirection();
            (data.animalMigrationRows || []).forEach(saved => {
                document.querySelectorAll('input[name$=".AnimalType"]').forEach(typeField => {
                    const row = typeField.closest('tr');
                    if (String(typeField?.value) !== String(saved.animalType)) return;
                    row.querySelector('input[name$=".NumberOfAnimals"]').value = saved.numberOfAnimals || 0;
                    row.querySelector('input[name$=".OtherAnimalType"]').value = saved.otherAnimalType || '';
                });
            });
            if (data.draftFields) applyServerDraftFields(data.draftFields);
            document.querySelectorAll('.market-current-price').forEach(x => updateMarketComparison({ target: x }));
            document.querySelectorAll('.calc-table').forEach(t => calculateGridTotals(t));
            document.querySelectorAll('.migration-summary-table').forEach(calculateMigrationTotals);
        }

        function hydrateCollectionRows(prefix, key, rows) {
            (rows || []).forEach(item => {
                const hidden = [...document.querySelectorAll(`input[name^="${prefix}["][name$="].${key}"]`)].find(x => x.value.toLowerCase() === String(item[key.charAt(0).toLowerCase() + key.slice(1)]).toLowerCase());
                const row = hidden?.closest('.impact-card') || hidden?.closest('tr') ||
                    (hidden?.nextElementSibling?.classList.contains('impact-card') ? hidden.nextElementSibling : null);
                if (!row) return;
                Object.entries(item).forEach(([property, value]) => {
                    const pascal = property.charAt(0).toUpperCase() + property.slice(1);
                    const input = row.querySelector(`[name$="].${pascal}"]`);
                    if (input) input.value = value ?? '';
                });
            });
        }

        function mapDemographicInputs(rowDOM, maleVal, femaleVal) {
            if(!rowDOM) return;
            const male = Number(maleVal) || 0;
            const female = Number(femaleVal) || 0;
            rowDOM.querySelector(".val-male").value = male;
            rowDOM.querySelector(".val-female").value = female;
            rowDOM.querySelector(".row-total").innerText = (male + female).toLocaleString();
        }

        function resetWizardForm() {
            document.getElementById("remarksInput").value = "";
            document.querySelectorAll("input[type='number']").forEach(el => el.value = "0");
            document.querySelectorAll("input[type='text']").forEach(el => el.value = "");
            document.querySelectorAll("input[type='checkbox']").forEach(el => el.checked = false);
            
            document.getElementById("hasPestNo").checked = true;
            document.getElementById("pastureEnoughYes").checked = true;
            document.getElementById("waterEnoughYes").checked = true;
            document.getElementById("healthEnoughYes").checked = true;
            
            toggleCropPestFields();
            togglePastureFields();
            toggleWaterFields();
            toggleAnimalHealthFields();
            document.querySelectorAll('.calc-table').forEach(t => calculateGridTotals(t));
        }

        // =======================================================
        // REAL-TIME MATHEMATICAL MATRIX GRID CALCULATION ENGINE
        // =======================================================
        function initMatrixCalculations() {
            document.querySelectorAll('.calc-table').forEach(table => {
                table.querySelectorAll('tbody tr').forEach(row => {
                    const maleInput = row.querySelector('.val-male');
                    const femaleInput = row.querySelector('.val-female');

                    if(maleInput && femaleInput) {
                        const calculateRow = () => {
                            let mValue = parseInt(maleInput.value) || 0;
                            let fValue = parseInt(femaleInput.value) || 0;
                            row.querySelector('.row-total').innerText = (mValue + fValue).toLocaleString();
                            calculateGridTotals(table);
                        };
                        maleInput.addEventListener('input', calculateRow);
                        femaleInput.addEventListener('input', calculateRow);
                    }
                });
                calculateGridTotals(table);
            });
        }

        function calculateGridTotals(table) {
            let totalMaleSum = 0, totalFemaleSum = 0;
            table.querySelectorAll('tbody tr').forEach(row => {
                const male = parseInt(row.querySelector('.val-male')?.value) || 0;
                const female = parseInt(row.querySelector('.val-female')?.value) || 0;
                totalMaleSum += male;
                totalFemaleSum += female;
                const rowTotal = row.querySelector('.row-total');
                if (rowTotal) rowTotal.innerText = (male + female).toLocaleString();
            });
            const maleTotal = table.querySelector('.total-male');
            const femaleTotal = table.querySelector('.total-female');
            const grandTotal = table.querySelector('.grand-total');
            if (maleTotal) maleTotal.innerText = totalMaleSum.toLocaleString();
            if (femaleTotal) femaleTotal.innerText = totalFemaleSum.toLocaleString();
            if (grandTotal) grandTotal.innerText = (totalMaleSum + totalFemaleSum).toLocaleString();
        }

        function calculateMigrationTotals(table) {
            let total = 0;
            table.querySelectorAll('tbody tr').forEach(row => {
                const count = parseInt(row.querySelector('.migration-count')?.value) || 0;
                total += count;
                const rowTotal = row.querySelector('.migration-row-total');
                if (rowTotal) rowTotal.innerText = count.toLocaleString();
            });
            const columnTotal = table.querySelector('.migration-column-total');
            const grandTotal = table.querySelector('.migration-grand-total');
            if (columnTotal) columnTotal.innerText = total.toLocaleString();
            if (grandTotal) grandTotal.innerText = total.toLocaleString();
        }

