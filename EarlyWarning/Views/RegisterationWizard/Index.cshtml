                        <div class="card p-3 bg-light mb-3">
                            <label class="form-label fw-bold mb-2">የእንስሳት ጤና ሁኔታ እንዴት ነው?</label>
                            <div class="d-flex flex-row flex-wrap align-items-center gap-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="healthEnoughRadio" id="healthEnoughYes" value="true" onchange="toggleAnimalHealthFields()" checked>
                                    <label class="form-check-label fw-bold text-success" for="healthEnoughYes">አጥጋቢ / ጤናማ ነው</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="healthEnoughRadio" id="healthEnoughNo" value="false" onchange="toggleAnimalHealthFields()">
                                    <label class="form-check-label fw-bold text-danger" for="healthEnoughNo">ያልተረጋጋ / የበሽታ ወረርሽኝ አለ</label>
                                </div>
                            </div>
                            <input type="hidden" asp-for="AnimalHealthStatus.Enough" id="animalHealthEnoughSwitch" value="true" />
                        </div>
                        
                        <div id="animalHealthFields" class="d-none">
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label asp-for="AnimalHealthStatus.NoOfKebeliesWithWaterSupply" class="form-label fw-bold"></label>
                                    <input asp-for="AnimalHealthStatus.NoOfKebeliesWithWaterSupply" id="healthAnimalsMale" class="form-for-int form-control" type="number" min="0" value="0" />
                                </div>
                            </div>
                            <div class="p-3 bg-light rounded border mb-3 shadow-sm">
                                <label class="form-label fw-bold text-dark"><i class="fas fa-shield-virus me-1"></i>የተከሰቱ የእንስሳት በሽታዎች ዝርዝር</label>
                                <div class="row pt-2 ms-1">
                                    @if (Model.AnimalDiseases != null)
                                    {
                                        foreach (var dis in Model.AnimalDiseases)
                                        {
                                            <div class="col-md-4 form-check mb-2">
                                                <input class="form-check-input health-checkbox" type="checkbox" name="SelectedAnimalDiseaseIds" value="@dis.Id" data-name="@dis.Name" id="an_@dis.Id" />
                                                <label class="form-check-label" for="an_@dis.Id">@dis.Name</label>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>

                            <h5 class="text-muted mt-4 mb-2"><i class="fas fa-users me-2"></i>በእያንዳንዱ የእንስሳት በሽታ የተጎዱ አርብቶ አደሮች ስብጥር</h5>
                            <div id="animalImpactCards">@for (var i = 0; i < Model.AnimalDiseaseImpactDetails.Count; i++) { var item = Model.AnimalDiseaseImpactDetails[i]; var type = Model.AnimalDiseases.First(x => x.Id == item.AnimalDiseaseId); <input type="hidden" name="AnimalDiseaseImpactDetails[@i].AnimalDiseaseId" value="@item.AnimalDiseaseId" /><partial name="_PerTypeDemographicCard" model='($"AnimalDiseaseImpactDetails[{i}]", type.Name, item.AnimalDiseaseId.ToString(), (object)item)' /> }</div>
                            <div class="table-responsive bg-white rounded shadow-sm d-none">
                                <table class="table table-bordered text-center align-middle m-0 calc-table" id="healthTable">
                                    <thead class="table-danger text-dark">
                                        <tr>
                                            <th>የተጎጂዎች ምድብ</th>
                                            <th style="width: 40%;">ወንድ</th>
                                            <th style="width: 40%;">ሴት</th>
                                            <th style="width: 20%;" class="bg-danger bg-opacity-25 fw-bold">ድምር</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr><td class="bg-light fw-bold" data-label="አባወራ / እማወራ">አባወራ / እማወራ</td><td><input asp-for="AnimalHealthStatus.MaleHouseHold" class="form-for-int form-control text-center val-male" type="number" min="0" value="0" /></td><td><input asp-for="AnimalHealthStatus.FemaleHouseHold" class="form-for-int form-control text-center val-female" type="number" min="0" value="0" /></td><td class="fw-bold bg-light row-total">0</td></tr>
                                        <tr><td class="bg-light fw-bold" data-label="የቤተሰብ አባላት">የቤተሰብ አባላት</td><td><input asp-for="AnimalHealthStatus.MaleFamily" class="form-for-int form-control text-center val-male" type="number" min="0" value="0" /></td><td><input asp-for="AnimalHealthStatus.FemaleFamily" class="form-for-int form-control text-center val-female" type="number" min="0" value="0" /></td><td class="fw-bold bg-light row-total">0</td></tr>
                                        <tr><td class="bg-light fw-bold" data-label="ህጻናት">ህጻናት</td><td><input asp-for="AnimalHealthStatus.ChildhMale" class="form-for-int form-control text-center val-male" type="number" min="0" value="0" /></td><td><input asp-for="AnimalHealthStatus.ChildFemale" class="form-for-int form-control text-center val-female" type="number" min="0" value="0" /></td><td class="fw-bold bg-light row-total">0</td></tr>
                                        <tr><td class="bg-light fw-bold" data-label="ወጣቶች">ወጣቶች</td><td><input asp-for="AnimalHealthStatus.YouthMale" class="form-for-int form-control text-center val-male" type="number" min="0" value="0" /></td><td><input asp-for="AnimalHealthStatus.YouthFemale" class="form-for-int form-control text-center val-female" type="number" min="0" value="0" /></td><td class="fw-bold bg-light row-total">0</td></tr>
                                        <tr><td class="bg-light fw-bold" data-label="አረጋውያን">አረጋውያን</td><td><input asp-for="AnimalHealthStatus.ElderlyMale" class="form-for-int form-control text-center val-male" type="number" min="0" value="0" /></td><td><input asp-for="AnimalHealthStatus.ElderlyFemale" class="form-for-int form-control text-center val-female" type="number" min="0" value="0" /></td><td class="fw-bold bg-light row-total">0</td></tr>
                                        <tr><td class="bg-light fw-bold" data-label="አካል ጉዳተኞች">አካል ጉዳተኞች</td><td><input asp-for="AnimalHealthStatus.DisabledMale" class="form-for-int form-control text-center val-male" type="number" min="0" value="0" /></td><td><input asp-for="AnimalHealthStatus.DisabledFemale" class="form-for-int form-control text-center val-female" type="number" min="0" value="0" /></td><td class="fw-bold bg-light row-total">0</td></tr>
                                    </tbody>
                                    <tfoot class="table-light fw-bold border-top border-2">
                                        <tr class="text-danger">
                                            <td>ጠቅላላ ድምር (Grand Total)</td>
                                            <td class="total-male">0</td>
                                            <td class="total-female">0</td>
                                            <td class="bg-danger text-white grand-total">0</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>

                        <div class="mb-2 mt-4">
                            <label asp-for="Remarks" class="form-label fw-bold">የማጠቃለያ ተጨማሪ ማስታወሻ ወይም ማብራሪያ (Remarks)</label>
                            <textarea asp-for="Remarks" id="remarksInput" class="form-control" rows="3" placeholder="አጠቃላይ ተጨማሪ አስተያየት ካለ እዚህ ያስፍሩ..."></textarea>
                        </div>
                    </div>
                </div>

                <partial name="_ExtendedReportSteps" model="Model" />

                <div class="wizard-step d-none" id="step18">
                    <div class="p-4 bg-white rounded shadow-sm border-top border-dark border-4">
                        <h4 class="text-dark mb-3"><i class="fas fa-eye me-2"></i>ደረጃ 18፡ የተመዘገቡ መረጃዎች ማጠቃለያ ቅድመ-ዕይታ (Master Review Dashboard)</h4>
                        <div class="alert alert-warning py-2 shadow-sm"><i class="fas fa-exclamation-circle me-2"></i><strong>ማሳሰቢያ፡</strong> መረጃውን ወደ ዳታቤዝ ከመላክዎ በፊት ሁሉንም ክፍሎች እዚህ ማረጋገጥ ይችላሉ። ስህተት ካለ "ቀደመው ገጽ" በመጫን ማስተካከል ይቻላል።</div>
                        <hr />

                        <div id="previewContainer"></div>
                    </div>
                </div>

                @if (ViewBag.CanZoneDecision == true)
                {
                    <div class="card border-primary shadow-sm mt-4 mb-2">
                        <div class="card-header fw-bold">የዞን ግምገማ ውሳኔ</div>
                        <div class="card-body">
                            <label for="zoneReviewComment" class="form-label">አስተያየት (ለውድቅ ግዴታ ነው)</label>
                            <textarea id="zoneReviewComment" name="comment" form="zoneDecisionForm" class="form-control mb-3" rows="3" maxlength="2000"></textarea>
                            <button type="submit" form="zoneDecisionForm" name="decision" value="Approve" class="btn btn-success me-2"><i class="fas fa-check me-1"></i>ፍቀድ</button>
                            <button type="submit" form="zoneDecisionForm" name="decision" value="Reject" class="btn btn-danger"><i class="fas fa-times me-1"></i>ውድቅ አድርግ</button>
                        </div>
                    </div>
                }

                <div class="d-flex justify-content-between mt-4 p-3 bg-white rounded shadow-sm">
                    <button type="button" class="btn btn-secondary px-4 d-none" id="prevBtn" onclick="nextPrev(-1)">
                        <i class="fas fa-arrow-left me-2"></i>ቀደመው ገጽ
                    </button>
                    <button type="button" class="btn btn-primary px-5 ms-auto" id="nextBtn" onclick="nextPrev(1)">
                        ቀጣይ ገጽ<i class="fas fa-arrow-right ms-2"></i>
                    </button>
                </div>
            </form>
            @if (ViewBag.CanZoneDecision == true && zoneReviewSubmission != null)
            {
                <form id="zoneDecisionForm" asp-controller="WeeklyWorkflow" asp-action="Act" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@zoneReviewSubmission.Id" />
                    <input type="hidden" name="rowVersion" value="@Convert.ToBase64String(zoneReviewSubmission.RowVersion)" />
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentStep = 0;
        const steps = document.getElementsByClassName("wizard-step");
        const totalSteps = steps.length;
        const schoolProblemSwitch = document.getElementById('schoolProblemSwitch');
        const updateSchoolProblemVisibility = () => {
            const active = schoolProblemSwitch?.querySelector('input[type="radio"]:checked')?.value === 'true';
            document.querySelectorAll('.school-problem-detail').forEach(section => {
                section.classList.toggle('d-none', !active);
                section.querySelectorAll('input, select, textarea').forEach(control => control.disabled = !active);
            });
        };
        schoolProblemSwitch?.querySelectorAll('input[type="radio"]').forEach(radio =>
            radio.addEventListener('change', updateSchoolProblemVisibility));
        updateSchoolProblemVisibility();
        let currentWoredaMaxKebeles = 0;
        let serverDraftEnabled = false;
        let serverDraftTimer = null;
        let serverDraftRequest = null;
        let isSubmittingWizard = false;
        let isHydratingWeeklyData = false;
        const isReviewMode = @((ViewBag.IsReviewMode == true).ToString().ToLowerInvariant());

        // One delegated calculator covers every demographic table, including
        // tables restored from drafts or revealed after the page initializes.
        const wizardFormElement = document.getElementById('earlyWarningForm');
        const recalculateChangedTable = event => {
            if (event.target.matches?.('.val-male, .val-female')) {
                const table = event.target.closest('.calc-table');
                if (table) calculateGridTotals(table);
            }
            if (event.target.matches?.('.migration-count')) {
                const table = event.target.closest('.migration-summary-table');
                if (table) calculateMigrationTotals(table);
            }
        };
        wizardFormElement?.addEventListener('input', recalculateChangedTable);
        wizardFormElement?.addEventListener('change', recalculateChangedTable);

        document.querySelectorAll('.section-toggle').forEach(toggle => {
            const sync = () => document.querySelector(toggle.dataset.target)?.classList.toggle('d-none', !toggle.checked);
            toggle.addEventListener('change', sync);
            sync();
        });
        function syncAllBoolRadios() {
            document.querySelectorAll('.bool-radio').forEach(radio => {
                const hidden = document.getElementById(radio.dataset.field);
                radio.checked = String(hidden.value).toLowerCase() === radio.value;
                const section = document.querySelector(radio.dataset.section);
                if (radio.checked && section) section.classList.toggle('d-none', radio.value !== 'true');
            });
        }
        document.querySelectorAll('.bool-radio').forEach(radio => radio.addEventListener('change', () => {
            if (!radio.checked) return;
            document.getElementById(radio.dataset.field).value = radio.value;
            document.querySelector(radio.dataset.section)?.classList.toggle('d-none', radio.value !== 'true');
        }));
        syncAllBoolRadios();
        function syncMigrationDirection() {
            const selected = document.querySelector('.migration-direction:checked');
            if (!selected) return;
            const inward = selected.value === 'true';
            document.getElementById('migrationIsInward').value = inward;
            document.getElementById('inwardMigration')?.classList.toggle('d-none', !inward);
            document.getElementById('outwardMigration')?.classList.toggle('d-none', inward);
        }
        document.querySelectorAll('.migration-direction').forEach(x => x.addEventListener('change', syncMigrationDirection));
        syncMigrationDirection();
        function syncAnimalMigrationDirection() {
            const selected = document.querySelector('.animal-migration-direction:checked');
            const inward = selected?.value === 'Inward';
            document.getElementById('animalMigrationInward')?.classList.toggle('d-none', !inward);
            document.getElementById('animalMigrationOutward')?.classList.toggle('d-none', inward);
            const title = document.getElementById('animalMigrationRouteTitle');
            if (title) title.textContent = inward ? 'ወደ ወረዳው የሚገቡ እንስሳት መስመር' : 'ከወረዳው የሚወጡ እንስሳት መስመር';
        }
        document.querySelectorAll('.animal-migration-direction').forEach(x => x.addEventListener('change', syncAnimalMigrationDirection));
        syncAnimalMigrationDirection();
        document.querySelectorAll('.aid-provided, .aid-distributed').forEach(input => input.addEventListener('input', () => {
            const row = input.closest('tr');
            const provided = Number(row.querySelector('.aid-provided').value) || 0;
            const distributed = Number(row.querySelector('.aid-distributed').value) || 0;
            row.querySelector('.aid-percent').value = provided > 0 ? Math.min(100, distributed / provided * 100).toFixed(2) : '0';
            const distributedInput = row.querySelector('.aid-distributed');
            distributedInput.classList.toggle('is-invalid', distributed > provided);
            distributedInput.setCustomValidity(distributed > provided ? 'የተሰራጨው መጠን ከቀረበው መጠን ሊበልጥ አይችልም።' : '');
        }));
        document.querySelectorAll('input[name$=".DamageRateInPercent"]').forEach(input => {
            input.min = '0';
            input.max = '100';
            input.step = '0.01';

            let feedback = input.parentElement?.querySelector('.damage-rate-feedback');
            if (!feedback) {
                feedback = document.createElement('div');
                feedback.className = 'invalid-feedback damage-rate-feedback';
                feedback.textContent = 'የጉዳት መጠን (%) ከ0 እስከ 100 ብቻ መሆን አለበት።';
                input.insertAdjacentElement('afterend', feedback);
            }

            const validateDamageRate = () => {
                const hasValue = input.value.trim() !== '';
                const value = Number(input.value);
                const invalid = hasValue && (!Number.isFinite(value) || value < 0 || value > 100);
                input.setCustomValidity(invalid ? feedback.textContent : '');
                input.classList.toggle('is-invalid', invalid);
                input.classList.toggle('is-valid', hasValue && !invalid);
            };

            input.addEventListener('input', validateDamageRate);
            input.addEventListener('change', validateDamageRate);
            validateDamageRate();
        });
        document.querySelectorAll('input[type="checkbox"][name^="Selected"]').forEach(box => {
            const syncImpact = () => document.querySelectorAll(`.impact-card[data-impact-key="${box.value}"]`).forEach(card => card.classList.toggle('d-none', !box.checked));
            box.addEventListener('change', syncImpact);
            syncImpact();
        });
        document.querySelectorAll('.market-current-price').forEach(input => input.addEventListener('input', updateMarketComparison));
        function updateMarketComparison(event) {
            const row = event.target.closest('tr');
            const current = Number(event.target.value) || 0;
            const previous = Number(row.querySelector('.market-previous-price')?.value) || 0;
            const status = current > previous ? 1 : current < previous ? 2 : 3;
            row.querySelectorAll('.market-status').forEach(x => x.value = status);
            row.querySelector('.market-difference').value = (current - previous).toFixed(2);
            row.querySelector('.market-percentage').value = previous > 0 ? ((current - previous) / previous * 100).toFixed(2) : '0';
        }

        function updateMaxKebeleLimit() {
            const totalKebelesInput = document.getElementById("totalWoredaKebeles");
            if (totalKebelesInput) {
                currentWoredaMaxKebeles = parseInt(totalKebelesInput.value) || 0;
            }
            
            const badge = document.getElementById("woredaKebeleCountBadge");
            if (badge) {
                badge.innerText = currentWoredaMaxKebeles;
            }

            ["rainFull", "rainPartial", "rainNone", "rainNoData", "rainHigh", "rainMedium", "rainMediumHigh", "rainLow", "rainLowMedium", "rainAmountNoData"]
                .forEach(id => document.getElementById(id)?.setAttribute("max", currentWoredaMaxKebeles));
        }

        function showStep(n) {
            steps[n].classList.remove("d-none");
            // Recalculate when a step becomes visible. This is especially
            // important after a POST validation response restores Step 15.
            steps[n].querySelectorAll('.calc-table').forEach(calculateGridTotals);
            steps[n].querySelectorAll('.migration-summary-table').forEach(calculateMigrationTotals);
            document.getElementById("prevBtn").classList.toggle("d-none", n === 0);

            if (n === (totalSteps - 1)) {
                document.querySelectorAll('.calc-table').forEach(calculateGridTotals);
                buildDataPreviewEngine();
                document.getElementById("nextBtn").className = isReviewMode ? "btn btn-outline-secondary px-5 ms-auto disabled" : "btn btn-success px-5 ms-auto";
                document.getElementById("nextBtn").innerHTML = isReviewMode
                    ? '<i class="fas fa-check-circle me-2"></i>ግምገማው ተጠናቋል'
                    : 'መረጃውን በአንድነት መዝግብ <i class="fas fa-cloud-upload-alt ms-2"></i>';
            } else {
                document.getElementById("nextBtn").className = "btn btn-primary px-5 ms-auto";
                document.getElementById("nextBtn").innerHTML = 'ቀጣይ ገጽ <i class="fas fa-arrow-right ms-2"></i>';
            }

            document.getElementById("stepIndicator").innerText = `ደረጃ ${n + 1} ከ ${totalSteps}`;
            document.getElementById("wizardProgress").style.width = ((n + 1) / totalSteps) * 100 + "%";
        }

        function navigateToField(field) {
            if (!field) return false;
            let container = field.parentElement;
            while (container && !container.classList.contains('wizard-step')) {
                if (container.classList.contains('conditional-section') || container.classList.contains('impact-card'))
                    container.classList.remove('d-none');
                container = container.parentElement;
            }
            const step = field.closest('.wizard-step');
            if (step) {
                const stepIndex = Array.from(steps).indexOf(step);
                if (stepIndex >= 0) {
                    Array.from(steps).forEach(x => x.classList.add('d-none'));
                    currentStep = stepIndex;
                    showStep(currentStep);
                }
            }
            field.classList.add('is-invalid');
            setTimeout(() => {
                field.scrollIntoView({ behavior: 'smooth', block: 'center' });
                if (!field.disabled && field.type !== 'hidden') field.focus({ preventScroll: true });
            }, 100);
            return true;
        }

        function navigateToServerValidationError() {
            const errorKeys = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(serverErrorFields));
            for (const key of errorKeys) {
                const escaped = CSS.escape(key);
                const candidates = [
                    ...document.querySelectorAll(`[name="${escaped}"]`),
                    ...document.querySelectorAll(`[name^="${escaped}["]`),
                    ...document.querySelectorAll(`[name$=".${escaped}"]`)
                ];
                const field = candidates.find(x => x.type !== 'hidden' && !x.closest('.d-none'))
                    || candidates.find(x => x.type !== 'hidden') || candidates[0];
                if (navigateToField(field)) return;
            }
            const summary = document.getElementById('errorSummaryBox');
            if (errorKeys.length && summary) {
                summary.classList.remove('d-none');
                summary.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        function showWizardMessage(message, type = 'danger') {
            const banner = document.getElementById('wizardModeBanner');
            const text = document.getElementById('wizardModeText');
            if (!banner || !text) return;
            banner.className = `alert alert-${type} py-2 shadow-sm animate-fade-in`;
            text.textContent = message;
            banner.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        async function checkSelectedWeek() {
            const startDate = document.getElementById('StartDate')?.value;
            if (!startDate) return null;
            try {
                const response = await fetch(`@Url.Action("CheckWeeklySubmission", "RegisterationWizard")?startDate=${encodeURIComponent(startDate)}`, {
                    headers: { 'Accept': 'application/json' }, cache: 'no-store'
                });
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                return await response.json();
            } catch (error) {
                console.error('Weekly duplicate check failed:', error);
                showWizardMessage('የሳምንቱን መዝገብ ማረጋገጥ አልተቻለም። እባክዎ ግንኙነቱን አረጋግጠው እንደገና ይሞክሩ።', 'warning');
                return { checkFailed: true };
            }
        }

        async function loadExistingWeeklyData(showMissingAsNew = false) {
            const woredaSelect = document.getElementById('WoredaId');
            const startDateInput = document.getElementById('StartDate');
            const endDateInput = document.getElementById('EndDate');
            if (!woredaSelect?.value || !startDateInput?.value || !endDateInput?.value) return false;

            const query = new URLSearchParams({
                woredaId: woredaSelect.value,
                startDate: startDateInput.value,
                endDate: endDateInput.value
            });
            const response = await fetch(`@Url.Action("GetExistingWizardData", "RegisterationWizard")?${query}`, {
                headers: { 'Accept': 'application/json' }, cache: 'no-store'
            });
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            const data = await response.json();
            if (!data.exists) {
                if (showMissingAsNew) {
                    document.getElementById('RecordId').value = '0';
                    document.getElementById('wizardModeBanner').classList.remove('d-none', 'alert-warning');
                    document.getElementById('wizardModeBanner').classList.add('alert-info');
                    document.getElementById('wizardModeText').innerText = '✨ አዲስ ሳምንታዊ መረጃ ምዝገባ (Create Mode Active)...';
                }
                return false;
            }

            serverDraftEnabled = false;
            document.getElementById('RecordId').value = '1';
            document.getElementById('wizardModeBanner').classList.remove('d-none', 'alert-info');
            document.getElementById('wizardModeBanner').classList.add('alert-warning');
            document.getElementById('wizardModeText').innerText = data.workflowStatus === 'Draft'
                ? 'የዚህ ሳምንት የተቀመጠው ረቂቅ መረጃ ተጭኗል፤ ከቆሙበት ቀጥለው ያጠናቅቁ።'
                : data.canEdit ? `ሪፖርቱ በዞን ተመልሷል፤ ማስተካከልና እንደገና መላክ ይችላሉ። ${data.latestWorkflowComment ? 'ምክንያት፡ ' + data.latestWorkflowComment : ''}`
                : `ሪፖርቱ ተልኳል እና ተቆልፏል (${data.workflowStatus || 'በግምገማ ላይ'})።`;
            isHydratingWeeklyData = true;
            try {
                if (data.workflowStatus === 'Draft' && data.draftFields) {
                    if (data.recordStartDate) document.getElementById('StartDate').value = data.recordStartDate;
                    if (data.recordEndDate) document.getElementById('EndDate').value = data.recordEndDate;
                    applyServerDraftFields(data.draftFields);
                } else {
                    hydrateWizardForm(data);
                }
            } finally {
                isHydratingWeeklyData = false;
            }
            serverDraftEnabled = Boolean(data.canEdit);
            if (!data.canEdit) {
                document.querySelectorAll("#earlyWarningForm input, #earlyWarningForm select, #earlyWarningForm textarea, #earlyWarningForm button[type='submit']")
                    .forEach(el => {
                        if (el.type !== 'hidden' && el.getAttribute('form') !== 'zoneDecisionForm')
                            el.disabled = true;
                    });
            }
            return true;
        }

        async function saveServerDraft(showConfirmation = false) {
            if (!serverDraftEnabled || isSubmittingWizard) return true;
            const form = document.getElementById('earlyWarningForm');
            const startDate = document.getElementById('StartDate')?.value;
            const endDate = document.getElementById('EndDate')?.value;
            if (!startDate || !endDate) return false;
            try {
                serverDraftRequest?.abort();
                serverDraftRequest = new AbortController();
                const response = await fetch('@Url.Action("SaveDraft", "RegisterationWizard")', {
                    method: 'POST', body: new FormData(form), headers: { 'Accept': 'application/json' },
                    signal: serverDraftRequest.signal
                });
                const result = await response.json().catch(() => ({}));
                if (!response.ok) {
                    showWizardMessage(result.message || 'ረቂቅ መረጃውን ማስቀመጥ አልተቻለም።', 'danger');
                    return false;
                }
                if (showConfirmation) showWizardMessage('ረቂቅ መረጃው በዳታቤዝ ተቀምጧል። በሌላ ጊዜ ተመልሰው መቀጠል ይችላሉ።', 'success');
                return true;
            } catch (error) {
                if (error.name === 'AbortError') return true;
                console.error('Draft save failed:', error);
                showWizardMessage('ረቂቅ መረጃውን ማስቀመጥ አልተቻለም፤ ግንኙነቱን አረጋግጠው ይሞክሩ።', 'warning');
                return false;
            }
        }

        function scheduleServerDraftSave() {
            if (!serverDraftEnabled || isSubmittingWizard) return;
            clearTimeout(serverDraftTimer);
            serverDraftTimer = setTimeout(() => saveServerDraft(false), 900);
        }

        async function nextPrev(n) {
            if (n === 1 && !isReviewMode) {
                let isStepValid = await validateCurrentStep();
                if (!isStepValid) return false;
            }
            if (serverDraftEnabled && currentStep < totalSteps - 1) {
                const saved = await saveServerDraft(false);
                if (!saved) return false;
            }

            steps[currentStep].classList.add("d-none");
            currentStep += n;

            if (currentStep >= totalSteps) {
                if (isReviewMode) {
                    currentStep = totalSteps - 1;
                    showStep(currentStep);
                    return false;
                }
                const form = document.getElementById("earlyWarningForm");
                document.querySelectorAll('#earlyWarningForm input[type="number"]').forEach(x => x.dispatchEvent(new Event('input')));
                if (!form.checkValidity()) {
                    const invalidField = form.querySelector(':invalid');
                    navigateToField(invalidField);
                    invalidField?.reportValidity();
                    return false;
                }
                form.requestSubmit();
                return false;
            }
            showStep(currentStep);
        }

        // =======================================================
        // CLIENT-SIDE REALTIME INTEGER TYPE CONSTRAINT EVALUATION
        // =======================================================
        document.querySelectorAll(".form-for-int, input[type='number']:not([step='any'])").forEach(input => {
            input.addEventListener("keydown", function(e) {
                if (e.key === '.' || e.key === ',') {
                    e.preventDefault();
                }
            });

            input.addEventListener("input", function() {
                let val = this.value;
                if (parseFloat(val) < 0) {
                    this.value = 0;
                    return;
                }
                if (val.includes(".")) {
                    this.value = Math.floor(parseFloat(val)) || 0;
                }
            });

            input.addEventListener("blur", function() {
                if (this.value.trim() === "") {
                    this.value = 0;
                }
            });
        });

        // =======================================================
        // OVERRIDE TOGGLE HANDLERS TO WORK WITH RADIO ACTIONS
        // =======================================================
        function toggleCropPestFields() {
            const selected = document.querySelector('input[name="hasPestRadio"]:checked');
            const value = selected ? selected.value === "true" : document.getElementById("hasPestSwitch").value === "true";
            document.getElementById("hasPestSwitch").value = value;
            document.getElementById("cropPestFields").classList.toggle("d-none", !value);
        }

        function togglePastureFields() {
