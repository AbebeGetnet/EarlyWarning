                        <div class="col-6 col-md"><div class="p-2 border rounded bg-light"><strong>በዘር፡</strong> ${document.getElementById("cropSeedStage").value}</div></div>
                        <div class="col-6 col-md"><div class="p-2 border rounded bg-light"><strong>በብቅለት፡</strong> ${document.getElementById("cropGerminationStage").value}</div></div>
                        <div class="col-6 col-md"><div class="p-2 border rounded bg-light"><strong>በእድገት፡</strong> ${document.getElementById("cropGrowthStage").value}</div></div>
                        <div class="col-6 col-md"><div class="p-2 border rounded bg-light"><strong>ፍሬ በመሙላት፡</strong> ${document.getElementById("cropFruitStage").value}</div></div>
                        <div class="col-6 col-md"><div class="p-2 border rounded bg-light"><strong>በመሰብሰብ፡</strong> ${document.getElementById("cropHarvestingStage").value}</div></div>
                    </div></div>
                </div>

                <div class="card mb-3 border-warning shadow-sm">
                    <div class="card-header bg-warning bg-opacity-10 text-warning fw-bold"><i class="fas fa-bug me-2"></i>ደረጃ 3፡ የሰብል ሁኔታ — 3.2፡ የሰብል ተባይ ክስተት</div>
                    <div class="card-body bg-white">
                        <p><strong>የተከሰተ ተባይ/በሽታ አለ?</strong> ${isPestActive ? '<span class="badge bg-danger">አዎ ተከስቷል</span>' : '<span class="badge bg-success">አልተከሰተም</span>'}</p>
                        ${hasPestData ? `
                            <p><strong>የተጎዳ መሬት (ሄክታር)፡</strong> <span class="fw-bold text-danger">${totalPestHectares.toLocaleString()}</span> <small class="text-muted">(የተባዮቹ ድምር)</small> | <strong>የሰብል አይነት፡</strong> <span class="fw-bold">${document.getElementById("pestCropType").value || "-"}</span></p>
                            <p><strong>የበሽታ አይነቶች፡</strong> <span class="text-danger fw-bold">${selectedPests}</span></p>
                            ${compileSelectedImpactTables('cropImpactCards', '.pest-checkbox:checked', 'warning')}
                        ` : ''}
                    </div>
                </div>

                <div class="card mb-3 border-success shadow-sm">
                    <div class="card-header bg-success bg-opacity-10 text-success fw-bold"><i class="fas fa-leaf me-2"></i>4.1፡ የእንስሳት ግጦሽ ሁኔታ</div>
                    <div class="card-body bg-white">
                        <p><strong>የመኖ አቅርቦት በቂ ነው?</strong> ${!isPastureShort ? '<span class="badge bg-success">በቂ ነው</span>' : '<span class="badge bg-danger">እጥረት አለ</span>'}</p>
                        ${hasPastureShortage ? `
                            <p><strong>በመኖ እጥረት የተጎዱ እንስሳት ብዛት፡</strong> <span class="text-danger fw-bold">${document.getElementById("pastureAnimalsAffected").value}</span></p>
                            <p><strong>የግጦሽ ችግር ያለባቸው ቀበሌዎች ብዛት፡</strong> <span class="fw-bold text-danger">${document.getElementById("pastureKebelesCount").value}</span></p>
                            ${compileReviewGridHtml('pastureTable', 'success')}
                        ` : ''}
                    </div>
                </div>

                <div class="card mb-3 border-primary shadow-sm">
                    <div class="card-header bg-primary bg-opacity-10 text-primary fw-bold"><i class="fas fa-tint me-2"></i>4.2፡ የእንስሳት ውሃ አቅርቦት ሁኔታ</div>
                    <div class="card-body bg-white">
                        <p><strong>የውሃ አቅርቦት በቂ ነው?</strong> ${!isWaterShort ? '<span class="badge bg-success">በቂ ነው</span>' : '<span class="badge bg-danger">እጥረት አለ</span>'}</p>
                        ${hasWaterShortage ? `
                            <p><strong>የውሃ እጥረት የታየባቸው ቀበሌዎች ብዛት፡</strong> <span class="fw-bold text-danger">${document.getElementById("waterKebelesCount").value}</span></p>
                            ${compileReviewGridHtml('waterTable', 'primary')}
                        ` : ''}
                        <p class="mt-3"><strong>4.3፡ የእንስሳት አቋም፡</strong> ${document.getElementById("bodyConditionLow").checked ? '<span class="badge bg-danger">ዝቅተኛ</span>' : document.getElementById("bodyConditionMedium").checked ? '<span class="badge bg-warning text-dark">መካከለኛ</span>' : document.getElementById("bodyConditionHigh").checked ? '<span class="badge bg-success">ከፍተኛ</span>' : '<span class="text-muted">አልተመረጠም</span>'}</p>
                        ${document.getElementById("bodyConditionLow").checked ? `<p><strong>የተጎዱ እንስሳት ብዛት፡</strong> <span class="fw-bold text-danger">${document.getElementById("bodyConditionAnimalsAffected").value || 0}</span></p>` : ''}
                        ${document.getElementById("bodyConditionLow").checked ? `<p><strong>ዝቅተኛ የሆነበት ምክንያት፡</strong> ${document.getElementById("bodyConditionReason").value.replace(/[&<>"']/g, c => '&#' + c.charCodeAt(0) + ';')}</p>` : ''}
                    </div>
                </div>

                <div class="card mb-3 border-danger shadow-sm">
                    <div class="card-header bg-danger bg-opacity-10 text-danger fw-bold"><i class="fas fa-ambulance me-2"></i>ደረጃ 5፡ የእንስሳት ጤና እና በሽታዎች ሁኔታ ማጠቃለያ</div>
                    <div class="card-body bg-white">
                        <p><strong>የእንስሳት ጤና ሁኔታ አጥጋቢ ነው?</strong> ${!isHealthIssues ? '<span class="badge bg-success">አዎ አጥጋቢ ነው</span>' : '<span class="badge bg-danger">አጥጋቢ አይደለም (ችግር አለ)</span>'}</p>
                        ${hasHealthIssues ? `
                            <p><strong>የታመሙ/የተጎዱ እንስሳት፡</strong> <span class="fw-bold text-danger">${totalAffectedAnimals.toLocaleString()}</span> <small class="text-muted">(የበሽታዎቹ ድምር)</small></p>
                            <p><strong>የእንስሣት አይነት፡</strong> ${(document.getElementById("healthDiseaseType")?.value || '-').replace(/[&<>"']/g, c => '&#' + c.charCodeAt(0) + ';')}</p>
                            <p><strong>የተከሰቱ በሽታዎች፡</strong> <span class="text-danger fw-bold">${selectedDiseases}</span></p>
                            ${compileSelectedImpactTables('animalImpactCards', '.health-checkbox:checked', 'danger')}
                        ` : ''}
                        <div class="p-2 border rounded bg-light mt-3">
                            <strong>ተጨማሪ ማስታወሻ (Remarks)፦</strong>
                            <p class="mb-0 text-muted italic small pt-1">${document.getElementById("remarksInput").value || "ምንም አስተያየት አልተሰጠም"}</p>
                        </div>
                    </div>
                </div>
            `;
            html += buildCompleteWizardReviewHtml();
            document.getElementById("previewContainer").innerHTML = html;
        }

        // Form fields grouped by name, built once per bulk restore instead of scanning ~1,500 fields per value.
        function formFieldsByName() {
            const map = new Map();
            for (const field of document.getElementById('earlyWarningForm').elements) {
                if (!field.name) continue;
                if (!map.has(field.name)) map.set(field.name, []);
                map.get(field.name).push(field);
            }
            return map;
        }

        // While a saved draft is poured into the form, the per-field change events must not each re-save
        // the whole form (that made restoring a draft quadratic); one save follows at the end.
        let isRestoringDraft = false;

        function applyServerDraftFields(fields) {
            ensureDefensiveActivityRows(Object.keys(fields || {}));
            const byName = formFieldsByName();
            isRestoringDraft = true;
            try {
                Object.entries(fields || {}).forEach(([name, rawValues]) => {
                    const values = Array.isArray(rawValues) ? rawValues.map(String) : [String(rawValues ?? '')];
                    (byName.get(name) || []).forEach(field => {
                        if (field.type === 'checkbox' || field.type === 'radio') field.checked = values.includes(field.value);
                        else field.value = values[0] ?? '';
                        field.dispatchEvent(new Event('change', { bubbles: true }));
                        field.dispatchEvent(new Event('input', { bubbles: true }));
                    });
                });
            } finally {
                isRestoringDraft = false;
            }
            document.querySelectorAll('.calc-table').forEach(calculateGridTotals);
        }

        function buildCompleteWizardReviewHtml() {
            const escapeHtml = value => String(value ?? '').replace(/[&<>'"]/g, character => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
            })[character]);
            let sectionsHtml = '';
            // Steps 2-7 have purpose-built summaries above. From Step 8 onward, clone
            // the actual Wizard layout so Amharic labels, tables and totals stay intact.
            Array.from(document.querySelectorAll('.wizard-step')).slice(7, -1).forEach(step => {
                const clone = step.cloneNode(true);
                clone.classList.remove('wizard-step', 'd-none');
                clone.removeAttribute('id');
                clone.querySelectorAll('.d-none').forEach(hidden => hidden.remove());
                clone.querySelectorAll('button, .field-validation-error, .text-danger.field-validation-valid').forEach(x => x.remove());
                clone.querySelectorAll('input, select, textarea').forEach(field => {
                    if (field.type === 'hidden') { field.remove(); return; }
                    if (field.type === 'radio' || field.type === 'checkbox') {
                        if (!field.checked) {
                            const label = field.closest('label');
                            if (label) label.remove(); else field.remove();
                            return;
                        }
                        const marker = document.createElement('span');
                        marker.className = 'badge bg-primary ms-1';
                        marker.textContent = 'ተመርጧል';
                        field.replaceWith(marker);
                        return;
                    }
                    let value = field.tagName === 'SELECT'
                        ? field.options[field.selectedIndex]?.text
                        : field.value;
                    if (value == null || String(value).trim() === '') value = '-';
                    const display = document.createElement(field.tagName === 'TEXTAREA' ? 'div' : 'span');
                    display.className = 'd-block px-2 py-1 fw-semibold text-dark review-field-value';
                    display.textContent = value;
                    field.replaceWith(display);
                });
                clone.querySelectorAll('table').forEach(table => table.classList.add('table-striped'));
                sectionsHtml += `<div class="card mb-4 shadow-sm border-0"><div class="card-body p-0">${clone.innerHTML}</div></div>`;
            });
            return `<div class="mt-4"><h4 class="border-bottom pb-2">ሁሉም የተሞሉ መረጃዎች — የመጨረሻ ማረጋገጫ</h4>${sectionsHtml}</div>`;
        }

        function compileReviewGridHtml(tableId, theme) {
            const table = document.getElementById(tableId);
            if (!table) return '';
            return compileReviewTable(table, theme);
        }

        function compileSelectedImpactTables(containerId, selectedSelector, theme) {
            const container = document.getElementById(containerId);
            if (!container) return '';
            const escapeHtml = value => String(value ?? '').replace(/[&<>'"]/g, character => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
            })[character]);

            return Array.from(document.querySelectorAll(selectedSelector)).map(checkbox => {
                const card = Array.from(container.querySelectorAll('.impact-card'))
                    .find(item => item.dataset.impactKey === checkbox.value);
                const table = card?.querySelector('.calc-table');
                if (!table) return '';
                calculateGridTotals(table);
                const name = checkbox.dataset.name || card.querySelector('.card-header')?.textContent?.trim() || '-';
                return `<div class="card mt-3 border-${theme}">
                    <div class="card-header fw-bold bg-${theme} bg-opacity-10">${escapeHtml(name)}</div>
                    <div class="card-body p-0">${compileReviewTable(table, theme)}</div>
                </div>`;
            }).join('');
        }

        function compileReviewTable(table, theme) {
            let rowsHtml = '';
            table.querySelectorAll('tbody tr').forEach(row => {
                let cell = row.querySelector('td[data-label]');
                let category = cell ? cell.getAttribute('data-label') : row.querySelector('td')?.textContent?.trim() || 'ምድብ';
                let male = row.querySelector('.val-male')?.value || 0;
                let female = row.querySelector('.val-female')?.value || 0;
                let total = row.querySelector('.row-total')?.innerText || 0;
                const breakdown = row.classList.contains('beneficiary-breakdown');
                rowsHtml += `<tr${breakdown ? ' class="beneficiary-breakdown"' : ''}><td class="bg-light fw-bold text-start ps-3">${category}</td><td>${male}</td><td>${female}</td><td class="fw-bold bg-light">${total}</td></tr>`;
            });

            return `
                <div class="table-responsive mt-2">
                    <table class="table table-sm table-bordered text-center m-0" style="font-size:0.85rem;">
                        <thead class="table-${theme} text-dark">
                            <tr><th>የተጎጂዎች ምድብ</th><th style="width:25%;">ወንድ</th><th style="width:25%;">ሴት</th><th style="width:20%;">ድምር</th></tr>
                        </thead>
                        <tbody>${rowsHtml}</tbody>
                        <tfoot class="table-light fw-bold text-${theme}">
                            <tr>
                                <td class="text-start ps-3">ጠቅላላ ድምር (አባወራ/እማወራ + ቤተሰብ)</td>
                                <td>${table.querySelector('.total-male')?.innerText || 0}</td>
                                <td>${table.querySelector('.total-female')?.innerText || 0}</td>
                                <td class="bg-${theme} text-white">${table.querySelector('.grand-total')?.innerText || 0}</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>`;
        }

        document.addEventListener("DOMContentLoaded", async function() {
            const form = document.getElementById("earlyWarningForm");
            const draftStartDate = document.getElementById("StartDate")?.value || '';
            const draftKey = `early-warning-wizard:${document.getElementById("WoredaId")?.value || "woreda"}:${document.getElementById("StartDate")?.value || "week"}`;

            document.querySelectorAll('#earlyWarningForm input[type="number"]').forEach(input => {
                const decimalName = /(hectare|price|quantity|percentage|rate|plan|ploughed|sown|harvest|residual)/i.test(input.name || '');
                const integerField = input.step !== 'any' && input.step !== '0.01' && !decimalName && !input.classList.contains('market-current-price') && !input.classList.contains('aid-provided') && !input.classList.contains('aid-distributed');
                input.min = input.min || '0';
                input.max = input.max || (integerField ? '1000000000' : '999999999999.99');
                input.inputMode = integerField ? 'numeric' : 'decimal';
                input.setAttribute('pattern', integerField ? '[0-9]*' : '[0-9]+([.][0-9]+)?');
                input.addEventListener('keydown', event => {
                    if (['e', 'E', '+', '-', ','].includes(event.key) || (integerField && event.key === '.')) event.preventDefault();
                });
                input.addEventListener('beforeinput', event => {
                    if (!event.data || event.inputType.startsWith('delete')) return;
                    const proposed = `${input.value.slice(0, input.selectionStart ?? input.value.length)}${event.data}${input.value.slice(input.selectionEnd ?? input.value.length)}`;
                    const allowed = integerField ? /^\d*$/.test(proposed) : /^\d*(\.\d{0,2})?$/.test(proposed);
                    if (!allowed) event.preventDefault();
                });
                input.addEventListener('paste', event => {
                    const pasted = event.clipboardData?.getData('text') ?? '';
                    const allowed = integerField ? /^\d+$/.test(pasted) : /^\d+(\.\d{1,2})?$/.test(pasted);
                    if (!allowed) event.preventDefault();
                });
                input.addEventListener('input', () => {
                    const value = Number(input.value);
                    const invalid = input.value !== '' && (!Number.isFinite(value) || value < Number(input.min) || value > Number(input.max) || (integerField && !Number.isInteger(value)));
                    input.setCustomValidity(invalid ? `ቁጥሩ በ${input.min} እና ${input.max} መካከል መሆን አለበት።` : '');
                    input.classList.toggle('is-invalid', invalid);
                });
            });

            const writeDraftNow = () => {
                clearTimeout(sessionDraftTimer);
                const fields = Array.from(form.elements).filter(x => x.name && x.name !== '__RequestVerificationToken').map(x => ({
                    name: x.name, type: x.type, value: x.value, checked: x.checked
                }));
                try {
                    localStorage.setItem(draftKey, JSON.stringify({ step: currentStep, fields, pending: localDraftNeedsUpload, savedAt: new Date().toISOString() }));
                } catch { /* storage full or blocked */ }
            };
            writeLocalDraft = writeDraftNow;
            // Serialising the whole form on every keystroke made typing lag; write once typing pauses.
            let sessionDraftTimer = null;
            const saveDraft = () => {
                if (isRestoringDraft) return;
                clearTimeout(sessionDraftTimer);
                sessionDraftTimer = setTimeout(writeDraftNow, 400);
            };
            const restoreDraft = () => {
                const forget = () => { try { localStorage.removeItem(draftKey); sessionStorage.removeItem(draftKey); } catch { /* ignore */ } };
                if (@(TempData["SuccessMessage"] != null ? "true" : "false")) { forget(); return; }
                let raw = null;
                try { raw = localStorage.getItem(draftKey) ?? sessionStorage.getItem(draftKey); } catch { /* storage blocked */ }
                if (!raw) return;
                try {
                    const draft = JSON.parse(raw);
                    localDraftNeedsUpload = Boolean(draft.pending);
                    ensureDefensiveActivityRows(draft.fields.map(x => x.name));
                    const byName = formFieldsByName();
                    isRestoringDraft = true;
                    try {
                        draft.fields.forEach(saved => {
                            const matches = (byName.get(saved.name) || []).filter(x =>
                                (x.type === 'checkbox' || x.type === 'radio') ? x.value === saved.value : true);
                            matches.forEach(field => {
                                if (field.type === 'checkbox' || field.type === 'radio') field.checked = saved.checked;
                                else field.value = saved.value;
                                field.dispatchEvent(new Event('change', { bubbles: true }));
                                field.dispatchEvent(new Event('input', { bubbles: true }));
                            });
                        });
                    } finally {
                        isRestoringDraft = false;
                    }
                    currentStep = Math.max(0, Math.min(Number(draft.step) || 0, totalSteps - 1));
                    steps.forEach(x => x.classList.add('d-none'));
                } catch { forget(); }
            };

            // A report finished offline waits in the outbox; the form stays read-only until it is sent.
            const lockForOutbox = () => {
                isSubmittingWizard = true;   // stops autosave
                serverDraftEnabled = false;
                document.querySelectorAll("#earlyWarningForm input, #earlyWarningForm select, #earlyWarningForm textarea, #earlyWarningForm button")
                    .forEach(el => { if (el.type !== 'hidden') el.disabled = true; });
                showWizardMessage('ሪፖርቱ በዚህ መሣሪያ ላይ ተቀምጧል፤ ግንኙነት ሲመለስ በራሱ ይላካል። ገጹን ወይም አሳሹን መዝጋት ይችላሉ፤ ሪፖርቱ አይጠፋም።', 'info');
            };
            const queueForLater = () => {
                const start = document.getElementById('StartDate')?.value;
                const end = document.getElementById('EndDate')?.value;
                const fields = [...new FormData(form)].filter(([name, value]) => name !== '__RequestVerificationToken' && typeof value === 'string');
                const saved = window.EWOffline?.queue({
                    key: draftKey,
                    url: '@Url.Action("SubmitWizard", "RegisterationWizard")',
                    openUrl: `@Url.Action("Index", "RegisterationWizard")?startDate=${encodeURIComponent(draftStartDate)}`,   // opens the page under the same draft key
                    label: start && end ? `የ${EthiopianDate.format(start)}–${EthiopianDate.format(end)} ሪፖርት` : 'ሳምንታዊ ሪፖርት',
                    fields
                });
                if (saved) { lockForOutbox(); return; }
                isSubmittingWizard = false;
                serverDraftEnabled = true;
                showWizardMessage('በመሣሪያው ላይ በቂ ቦታ ስለሌለ ሪፖርቱን ማስቀመጥ አልተቻለም። ግንኙነት ሲኖር እንደገና ይላኩ።', 'danger');
            };
            document.addEventListener('ew-outbox-sent', event => {
                if (event.detail.key === draftKey) showWizardMessage(event.detail.message || 'ሪፖርቱ ተልኳል።', 'success');
            });
            document.addEventListener('ew-outbox-failed', event => {
                if (event.detail.key !== draftKey) return;
                localDraftNeedsUpload = true;
                writeDraftNow();
                location.reload();   // reopens the report, unlocked, with the reasons shown (see below)
            });
            form.addEventListener('input', saveDraft);
            form.addEventListener('change', saveDraft);
            form.addEventListener('input', scheduleServerDraftSave);
            form.addEventListener('change', scheduleServerDraftSave);
            form.addEventListener('invalid', event => {
                if (event.target instanceof HTMLElement) navigateToField(event.target);
            }, true);
            document.getElementById('StartDate')?.addEventListener('change', async () => {
                if (isHydratingWeeklyData) return;
                const startInput = document.getElementById('StartDate');
                const selected = startInput?.value ? new Date(`${startInput.value}T00:00:00`) : null;
                if (selected && !Number.isNaN(selected.valueOf())) {
                    const daysSinceMonday = (selected.getDay() + 6) % 7;
                    selected.setDate(selected.getDate() - daysSinceMonday);
                    const wednesday = new Date(selected);
                    wednesday.setDate(wednesday.getDate() + 2);
                    const localDate = value => `${value.getFullYear()}-${String(value.getMonth() + 1).padStart(2, '0')}-${String(value.getDate()).padStart(2, '0')}`;
                    startInput.value = localDate(selected);
                    document.getElementById('EndDate').value = localDate(wednesday);
                }
                const duplicate = await checkSelectedWeek();
                if (duplicate?.exists) {
                    showWizardMessage(duplicate.message, duplicate.editable ? 'warning' : 'danger');
                    try { await loadExistingWeeklyData(false); }
                    catch (error) { console.error('Existing weekly data load failed:', error); }
                } else {
                    serverDraftEnabled = false;
                    document.getElementById('RecordId').value = '0';
                    await refreshPreviousWeekPrices();
                }
            });
            form.addEventListener('submit', async event => {
                event.preventDefault();
                syncConditionalRequired();
                document.querySelectorAll('#earlyWarningForm input[type="number"]').forEach(x => x.dispatchEvent(new Event('input')));
                const invalidFields = Array.from(form.querySelectorAll('input, select, textarea')).filter(x => x.type !== 'hidden' && !x.checkValidity());
                const invalidField = invalidFields.find(x => x.offsetParent !== null) || invalidFields[0];
                if (invalidField) {
                    navigateToField(invalidField);
                    invalidField.reportValidity();
                    return;
                }
                const duplicate = await checkSelectedWeek();
                if (duplicate?.checkFailed && !duplicate.offline) return;
                if (duplicate?.exists && !duplicate.editable) {
                    showWizardMessage(duplicate.message, 'danger');
                    navigateToField(document.getElementById('StartDate'));
                    return;
                }
                // Last chance: a sent report is locked until the zone returns it.
                if (!await confirmFinalSubmit()) {
                    currentStep = totalSteps - 1;
                    showStep(currentStep);
                    return;
                }
                isSubmittingWizard = true;
                serverDraftEnabled = false;
                clearTimeout(serverDraftTimer);
                serverDraftRequest?.abort();
                if (duplicate?.offline) {
                    localDraftNeedsUpload = true;
                    writeDraftNow();
                    queueForLater();
                    return;
                }
                writeDraftNow();   // immediate: the page is about to unload
                form.submit();
            });
            if (!isReviewMode) {
                isHydratingWeeklyData = true;
                try {
                    restoreDraft();
                } finally {
                    isHydratingWeeklyData = false;
                }
                const outboxEntry = window.EWOffline?.find(draftKey);
                if (outboxEntry?.status === 'pending') lockForOutbox();
                else if (outboxEntry?.status === 'failed') {
                    window.EWOffline.remove(draftKey);
                    localDraftNeedsUpload = true;
                    writeDraftNow();
                    showWizardMessage(`ያለ ግንኙነት የላኩት ሪፖርት አልተቀበለም፤ ያስተካክሉና እንደገና ይላኩ። ምክንያት፡ ${(outboxEntry.errors || []).join(' • ')}`, 'danger');
                }
            }
            const initialWeeklyRecord = isReviewMode ? { exists: true } : await checkSelectedWeek();
            if (initialWeeklyRecord?.exists) {
                try { await loadExistingWeeklyData(false); }
                catch (error) {
                    if (isNetworkError(error)) goneOffline();
                    else {
                        console.error('Initial weekly data load failed:', error);
                        showWizardMessage('የተቀመጠውን የሳምንት መረጃ መጫን አልተቻለም። ገጹን እንደገና ይጫኑ።', 'danger');
                    }
                }
            } else {
                await refreshPreviousWeekPrices();
            }
            syncDroughtKebeleOptions();
            showStep(currentStep);
            updateMaxKebeleLimit();
            toggleCropPestFields();
            togglePastureFields();
            toggleWaterFields();
            toggleBodyConditionFields();
            toggleAnimalHealthFields();
            initMatrixCalculations();
            syncAccidentOtherDamage();
            navigateToServerValidationError();
        });
    </script>
}
