                                    <input class="form-check-input" type="radio" asp-for="AnimalWaterSupplyStatus.AnimalBodyCondition" id="bodyConditionHigh" data-detail="false" value="@AnimalBodyCondition.ከፍተኛ" onchange="toggleBodyConditionFields()">
                                    <label class="form-check-label fw-bold" for="bodyConditionHigh">ከፍተኛ</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="AnimalWaterSupplyStatus.AnimalBodyCondition" id="bodyConditionMedium" data-detail="false" value="@AnimalBodyCondition.መካከለኛ" onchange="toggleBodyConditionFields()">
                                    <label class="form-check-label fw-bold" for="bodyConditionMedium">መካከለኛ</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="AnimalWaterSupplyStatus.AnimalBodyCondition" id="bodyConditionLow" data-detail="true" value="@AnimalBodyCondition.ዝቅተኛ" onchange="toggleBodyConditionFields()">
                                    <label class="form-check-label fw-bold" for="bodyConditionLow">ዝቅተኛ</label>
                                </div>
                            </div>
                            <span asp-validation-for="AnimalWaterSupplyStatus.AnimalBodyCondition" class="text-danger"></span>
                        </div>
                        <div id="bodyConditionReasonField" class="row g-3 mb-3 d-none">
                            <div class="col-md-4">
                                <label asp-for="AnimalWaterSupplyStatus.LowBodyConditionAnimalsAffected" class="form-label fw-bold"></label>
                                <input asp-for="AnimalWaterSupplyStatus.LowBodyConditionAnimalsAffected" id="bodyConditionAnimalsAffected" class="form-for-int form-control" type="number" min="0" value="0" />
                                <span asp-validation-for="AnimalWaterSupplyStatus.LowBodyConditionAnimalsAffected" class="text-danger"></span>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="AnimalWaterSupplyStatus.LowBodyConditionReason" class="form-label fw-bold"></label>
                                <textarea asp-for="AnimalWaterSupplyStatus.LowBodyConditionReason" id="bodyConditionReason" class="form-control" rows="3" maxlength="500" placeholder="የእንስሳት አቋም ዝቅተኛ የሆነበትን ምክንያት ይግለጹ"></textarea>
                                <span asp-validation-for="AnimalWaterSupplyStatus.LowBodyConditionReason" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="wizard-step d-none" id="step7">
                    <div class="p-4 bg-white rounded shadow-sm border-top border-danger border-4">
                        <h4 class="text-danger mb-3"><i class="fas fa-ambulance me-2"></i>ደረጃ 4.3፡ የእንስሳት ጤና </h4>
                        <hr />
                        
                        <div class="card p-3 bg-light mb-3">
                            <label class="form-label fw-bold mb-2">በወረርሽኝ መልክ የተከሰተ የእንስሳት በሽታ</label>
                            <div class="d-flex flex-row flex-wrap align-items-center gap-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="healthEnoughRadio" id="healthEnoughYes" data-detail="false" value="true" onchange="toggleAnimalHealthFields()" checked>
                                    <label class="form-check-label fw-bold" for="healthEnoughYes">የለም</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="healthEnoughRadio" id="healthEnoughNo" data-detail="true" value="false" onchange="toggleAnimalHealthFields()">
                                    <label class="form-check-label fw-bold" for="healthEnoughNo">አለ</label>
                                </div>
                            </div>
                            <input type="hidden" asp-for="AnimalHealthStatus.Enough" id="animalHealthEnoughSwitch" value="true" />
                        </div>
                        
                        <div id="animalHealthFields" class="d-none">
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label asp-for="AnimalHealthStatus.DiseaseType" class="form-label fw-bold"></label>
                                    <input asp-for="AnimalHealthStatus.DiseaseType" id="healthDiseaseType" class="form-control" maxlength="500" />
                                    <span asp-validation-for="AnimalHealthStatus.DiseaseType" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="p-3 bg-light rounded border mb-3 shadow-sm">
                                <label class="form-label fw-bold text-dark"><i class="fas fa-shield-virus me-1"></i>የተከሰቱ የእንስሳት በሽታዎች ዝርዝር</label>
                                <div class="row pt-2 ms-1">
                                    @if (Model.AnimalDiseases != null)
                                    {
                                        foreach (var dis in Model.AnimalDiseases)
                                        {
                                            <div class="col-md-4 form-check mb-2">
                                                <input class="form-check-input health-checkbox" type="checkbox" name="SelectedAnimalDiseaseIds" value="@dis.Id" data-name="@dis.Name" id="an_@dis.Id" />
                                                <label class="form-check-label" for="an_@dis.Id">@dis.Name</label>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>

                            <h5 class="text-muted mt-4 mb-2"><i class="fas fa-users me-2"></i>በእያንዳንዱ የእንስሳት በሽታ የተጎዱ አርብቶ አደሮች ስብጥር</h5>
                            <div id="animalImpactCards">@for (var i = 0; i < Model.AnimalDiseaseImpactDetails.Count; i++) { var item = Model.AnimalDiseaseImpactDetails[i]; var type = Model.AnimalDiseases.First(x => x.Id == item.AnimalDiseaseId); <input type="hidden" name="AnimalDiseaseImpactDetails[@i].AnimalDiseaseId" value="@item.AnimalDiseaseId" /><partial name="_PerTypeDemographicCard" model='($"AnimalDiseaseImpactDetails[{i}]", type.Name, item.AnimalDiseaseId.ToString(), (object)item)' view-data="animalImpactViewData" /> }</div>
                            <div class="table-responsive bg-white rounded shadow-sm d-none">
                                <table class="table table-bordered text-center align-middle m-0 calc-table" id="healthTable">
                                    <thead class="table-danger text-dark">
                                        <tr>
                                            <th>የተጎጂዎች ምድብ</th>
                                            <th style="width: 40%;">ወንድ</th>
                                            <th style="width: 40%;">ሴት</th>
                                            <th style="width: 20%;" class="bg-danger bg-opacity-25 fw-bold">ድምር</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr><td class="bg-light fw-bold" data-label="አባወራ / እማወራ">አባወራ / እማወራ</td><td><input asp-for="AnimalHealthStatus.MaleHouseHold" class="form-for-int form-control text-center val-male" type="number" min="0" value="0" /></td><td><input asp-for="AnimalHealthStatus.FemaleHouseHold" class="form-for-int form-control text-center val-female" type="number" min="0" value="0" /></td><td class="fw-bold bg-light row-total">0</td></tr>
                                        <tr><td class="bg-light fw-bold" data-label="የቤተሰብ አባላት">የቤተሰብ አባላት</td><td><input asp-for="AnimalHealthStatus.MaleFamily" class="form-for-int form-control text-center val-male" type="number" min="0" value="0" /></td><td><input asp-for="AnimalHealthStatus.FemaleFamily" class="form-for-int form-control text-center val-female" type="number" min="0" value="0" /></td><td class="fw-bold bg-light row-total">0</td></tr>
                                        <tr><td class="bg-light fw-bold" data-label="ህፃናት ከ5 ዓመት በታች">ህፃናት ከ5 ዓመት በታች</td><td><input asp-for="AnimalHealthStatus.ChildhMale" class="form-for-int form-control text-center val-male" type="number" min="0" value="0" /></td><td><input asp-for="AnimalHealthStatus.ChildFemale" class="form-for-int form-control text-center val-female" type="number" min="0" value="0" /></td><td class="fw-bold bg-light row-total">0</td></tr>
                                        <tr><td class="bg-light fw-bold" data-label="ወጣቶች">ወጣቶች</td><td><input asp-for="AnimalHealthStatus.YouthMale" class="form-for-int form-control text-center val-male" type="number" min="0" value="0" /></td><td><input asp-for="AnimalHealthStatus.YouthFemale" class="form-for-int form-control text-center val-female" type="number" min="0" value="0" /></td><td class="fw-bold bg-light row-total">0</td></tr>
                                        <tr><td class="bg-light fw-bold" data-label="አረጋውያን">አረጋውያን</td><td><input asp-for="AnimalHealthStatus.ElderlyMale" class="form-for-int form-control text-center val-male" type="number" min="0" value="0" /></td><td><input asp-for="AnimalHealthStatus.ElderlyFemale" class="form-for-int form-control text-center val-female" type="number" min="0" value="0" /></td><td class="fw-bold bg-light row-total">0</td></tr>
                                        <tr><td class="bg-light fw-bold" data-label="አካል ጉዳተኞች">አካል ጉዳተኞች</td><td><input asp-for="AnimalHealthStatus.DisabledMale" class="form-for-int form-control text-center val-male" type="number" min="0" value="0" /></td><td><input asp-for="AnimalHealthStatus.DisabledFemale" class="form-for-int form-control text-center val-female" type="number" min="0" value="0" /></td><td class="fw-bold bg-light row-total">0</td></tr>
                                    </tbody>
                                    <tfoot class="table-light fw-bold border-top border-2">
                                        <tr class="text-danger">
                                            <td>ጠቅላላ ድምር (Grand Total)</td>
                                            <td class="total-male">0</td>
                                            <td class="total-female">0</td>
                                            <td class="bg-danger text-white grand-total">0</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>

                        <div class="mb-2 mt-4">
                            <label asp-for="Remarks" class="form-label fw-bold">የማጠቃለያ ተጨማሪ ማስታወሻ ወይም ማብራሪያ (Remarks)</label>
                            <textarea asp-for="Remarks" id="remarksInput" class="form-control" rows="3" placeholder="አጠቃላይ ተጨማሪ አስተያየት ካለ እዚህ ያስፍሩ..."></textarea>
                        </div>
                    </div>
                </div>

                <partial name="_ExtendedReportSteps" model="Model" />

                <div class="wizard-step d-none" id="step18">
                    <div class="p-4 bg-white rounded shadow-sm border-top border-dark border-4">
                        <h4 class="text-dark mb-3"><i class="fas fa-eye me-2"></i>ደረጃ 18፡ የተመዘገቡ መረጃዎች ማጠቃለያ ቅድመ-ዕይታ (Master Review Dashboard)</h4>
                        <div class="alert alert-warning py-2 shadow-sm"><i class="fas fa-exclamation-circle me-2"></i><strong>ማሳሰቢያ፡</strong> መረጃውን ወደ ዳታቤዝ ከመላክዎ በፊት ሁሉንም ክፍሎች እዚህ ማረጋገጥ ይችላሉ። ስህተት ካለ "ቀደመው ገጽ" በመጫን ማስተካከል ይቻላል።</div>
                        <hr />

                        <div id="previewContainer"></div>
                    </div>
                </div>

                @if (ViewBag.CanZoneDecision == true && zoneReviewSubmission != null)
                {
                    @* Approval is only available on the record's details page. *@
                    <div class="alert alert-primary mt-4 mb-2">
                        የዞን ማጽደቂያ የሚሰጠው በሪፖርቱ ዝርዝር ገጽ ላይ ብቻ ነው።
                        <a asp-controller="WeeklyWorkflow" asp-action="Details" asp-route-id="@zoneReviewSubmission.Id" class="alert-link">የሪፖርቱን ዝርዝር ገጽ ይክፈቱ</a>
                    </div>
                }

                <div class="d-flex justify-content-between mt-4 p-3 bg-white rounded shadow-sm">
                    <button type="button" class="btn btn-secondary px-4 d-none" id="prevBtn" onclick="nextPrev(-1)">
                        <i class="fas fa-arrow-left me-2"></i>ቀደመው ገጽ
                    </button>
                    <button type="button" class="btn btn-primary px-5 ms-auto" id="nextBtn" onclick="nextPrev(1)">
                        ቀጣይ ገጽ<i class="fas fa-arrow-right ms-2"></i>
                    </button>
                </div>
            </form>

            @* Shown once every check has passed, just before the report is sent; cancelling returns to the review step. *@
            <div class="submit-confirm-backdrop" id="submitConfirm" hidden>
                <div class="submit-confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="submitConfirmTitle" aria-describedby="submitConfirmText">
                    <header id="submitConfirmTitle"><i class="fas fa-exclamation-triangle me-2"></i>ማስጠንቀቂያ፡ ከተላከ በኋላ ማስተካከል አይቻልም</header>
                    <div class="body">
                        <p id="submitConfirmText" class="mb-2">
                            መረጃው አንዴ ከተመዘገበና ለዞን ከተላከ በኋላ <strong>መቀየር ወይም ማስተካከል አይችሉም</strong>።
                            ማስተካከል የሚቻለው ዞኑ ሪፖርቱን ለማስተካከያ ሲመልሰው ብቻ ነው።
                            እባክዎ ከመላክዎ በፊት በቅድመ-ዕይታው ላይ ሁሉንም ክፍሎች፣ ቁጥሮችና ቀኖች በጥንቃቄ ያረጋግጡ።
                        </p>
                        <div class="small text-muted">
                            <div><strong>ወረዳ፡</strong> @ViewBag.WoredaName</div>
                            <div><strong>የሪፖርት ሳምንት፡</strong> <span id="submitConfirmWeek">-</span></div>
                        </div>
                        <label class="ack" for="submitConfirmAck">
                            <input type="checkbox" id="submitConfirmAck" />
                            <span>ሁሉንም መረጃ አረጋግጫለሁ፤ ከተላከ በኋላ ማስተካከል እንደማልችል ተረድቻለሁ።</span>
                        </label>
                    </div>
                    <footer>
                        <button type="button" class="btn btn-secondary" id="submitConfirmCancel"><i class="fas fa-arrow-left me-1"></i>ተመለስና አረጋግጥ</button>
                        <button type="button" class="btn btn-success" id="submitConfirmOk" disabled><i class="fas fa-cloud-upload-alt me-1"></i>አዎ፣ መዝግብና ላክ</button>
                    </footer>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ethiopianDate.js" asp-append-version="true"></script>
    <script>
        // Ethiopian-calendar picker for the reporting week. The hidden #StartDate/#EndDate keep the Gregorian
        // yyyy-MM-dd value; every write to them (user pick, saved week, draft) re-renders the picker.
        (function () {
            const E = window.EthiopianDate;
            const start = document.getElementById('StartDate');
            const end = document.getElementById('EndDate');
            const day = document.getElementById('ethStartDay');
            const month = document.getElementById('ethStartMonth');
            const year = document.getElementById('ethStartYear');
            if (!E || !start || !end || !day || !month || !year) return;
            const native = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value');
            const option = (value, text) => new Option(text, value);

            month.append(option('', 'ወር'), ...E.monthNames.map((name, i) => option(i + 1, name)));
            const thisYear = E.fromGregorian(E.todayIso()).year;
            year.append(option('', 'ዓመት'), option(thisYear, thisYear), option(thisYear - 1, thisYear - 1));
            const ensureYear = y => { if (![...year.options].some(o => o.value === String(y))) year.append(option(y, y)); };
            function fillDays(y, m, selected) {
                const count = y && m ? E.daysInMonth(y, m) : 30;
                day.replaceChildren(option('', 'ቀን'), ...Array.from({ length: count }, (_, i) => option(i + 1, i + 1)));
                day.value = selected && selected <= count ? String(selected) : '';
            }

            function render() {
                const iso = native.get.call(start);
                const picked = E.fromGregorian(iso);
                if (picked) {
                    ensureYear(picked.year);
                    year.value = String(picked.year);
                    month.value = String(picked.month);
                    fillDays(picked.year, picked.month, picked.day);
                } else if (!day.value && !month.value && !year.value) {
                    fillDays(null, null, null);
                }
                document.getElementById('ethStartLong').textContent = picked ? E.formatLong(iso) : '';
                const endIso = native.get.call(end);
                document.getElementById('ethEndDisplay').value = endIso ? `${E.format(endIso)} ዓ/ም` : '';
                document.getElementById('ethEndLong').textContent = endIso ? E.formatLong(endIso) : '';
            }

            // Any code that sets .value on the hidden dates (saved week, draft restore, Monday snapping) re-renders.
            [start, end].forEach(input => Object.defineProperty(input, 'value', {
                configurable: true,
                get() { return native.get.call(this); },
                set(v) { native.set.call(this, v); render(); }
            }));

            function pick() {
                const y = Number(year.value), m = Number(month.value);
                fillDays(y || null, m || null, Number(day.value) || null);
                if (!y || !m || !day.value) return;   // wait until day, month and year are all chosen
                native.set.call(start, E.toGregorian(y, m, Number(day.value)));
                // The wizard's own handler snaps to Monday, sets the Wednesday end date and loads that week.
                start.dispatchEvent(new Event('change', { bubbles: true }));
                render();
            }
            [day, month, year].forEach(select => select.addEventListener('change', pick));
            render();
        })();
    </script>
    <script>
        let currentStep = 0;
        const steps = document.getElementsByClassName("wizard-step");
        const totalSteps = steps.length;
        const schoolProblemSwitch = document.getElementById('schoolProblemSwitch');
        const updateSchoolProblemVisibility = () => {
            const active = schoolProblemSwitch?.querySelector('input[type="radio"]:checked')?.value === 'true';
            document.querySelectorAll('.school-problem-detail').forEach(section => {
                section.classList.toggle('d-none', !active);
                section.querySelectorAll('input, select, textarea').forEach(control => control.disabled = !active);
            });
        };
        schoolProblemSwitch?.querySelectorAll('input[type="radio"]').forEach(radio =>
            radio.addEventListener('change', updateSchoolProblemVisibility));
        updateSchoolProblemVisibility();
        const updateSchoolDropoutTotal = () => {
            const total = (Number(document.getElementById('SchoolReport_MaleStudentDropouts')?.value) || 0)
                + (Number(document.getElementById('SchoolReport_FemaleStudentDropouts')?.value) || 0);
            const totalInput = document.getElementById('schoolDropoutTotal');
            if (totalInput) totalInput.value = total;
        };
        ['SchoolReport_MaleStudentDropouts', 'SchoolReport_FemaleStudentDropouts'].forEach(id =>
            document.getElementById(id)?.addEventListener('input', updateSchoolDropoutTotal));
        updateSchoolDropoutTotal();
        // Malnutrition rates come from the counts (mirrors MalnutritionReport.CalculateRates):
        // GAM = (severe + moderate) / screened, MAM = moderate / screened. Found may not exceed screened.
        function updateMalnutritionRates() {
            const count = id => Number(document.getElementById(id)?.value) || 0;
            const rate = (found, screened) => screened > 0 ? (Math.round(found * 10000 / screened) / 100).toFixed(2) + ' %' : '-';
            const check = (ids, found, screened, message) => ids.forEach(id =>
                document.getElementById(id)?.setCustomValidity(found > screened ? message : ''));
            const childrenFound = count('malChildrenSevere') + count('malChildrenModerate');
            const plwFound = count('malPlwModerate');
            const gam = document.getElementById('malChildrenGamRate');
            const mam = document.getElementById('malPlwMamRate');
            if (gam) gam.value = rate(childrenFound, count('malChildrenScreened'));
            if (mam) mam.value = rate(plwFound, count('malPlwScreened'));
            check(['malChildrenSevere', 'malChildrenModerate'], childrenFound, count('malChildrenScreened'),
                'የስነ-ምግብ እጥረት የተገኘባቸው ህጻናት (ከፍተኛ + መካከለኛ) ልየታ ከተደረገላቸው ህጻናት መብለጥ አይችልም።');
            check(['malPlwModerate'], plwFound, count('malPlwScreened'),
                'የስነ-ምግብ እጥረት የተገኘባቸው እናቶች ልየታ ከተደረገላቸው እናቶች መብለጥ አይችልም።');
        }
        document.querySelectorAll('.malnutrition-count').forEach(input => input.addEventListener('input', updateMalnutritionRates));
        updateMalnutritionRates();
        let currentWoredaMaxKebeles = 0;
        let serverDraftEnabled = false;
        let serverDraftTimer = null;
        let serverDraftRequest = null;
        let isSubmittingWizard = false;
        let isHydratingWeeklyData = false;
        // Offline work (see wwwroot/js/offline.js). The local draft remembers whether it holds changes the
        // server has not saved yet; such a draft wins over the server's copy when the page is opened again.
        let localDraftNeedsUpload = false;
        let offlineNoticeShown = false;
        let writeLocalDraft = () => { };
        const OFFLINE_MESSAGE = 'ከመስመር ውጭ ነዎት። የሚሞሉት መረጃ በዚህ መሣሪያ ላይ ይቀመጣል፤ ሪፖርቱን ሲልኩት ግንኙነት ሲመለስ በራሱ ይላካል።';
        const isNetworkError = error => error instanceof TypeError;   // fetch() rejects with TypeError when the server cannot be reached
        function goneOffline() {
            localDraftNeedsUpload = true;
            writeLocalDraft();
            window.EWOffline?.setReachable(false);
            if (!offlineNoticeShown) showWizardMessage(OFFLINE_MESSAGE, 'secondary', false);
            offlineNoticeShown = true;
        }
        const isReviewMode = @((ViewBag.IsReviewMode == true).ToString().ToLowerInvariant());

        // One delegated calculator covers every demographic table, including
        // tables restored from drafts or revealed after the page initializes.
        const wizardFormElement = document.getElementById('earlyWarningForm');
        const recalculateChangedTable = event => {
            if (event.target.matches?.('.val-male, .val-female')) {
                const table = event.target.closest('.calc-table');
                if (table) calculateGridTotals(table);
            }
            if (event.target.matches?.('.migration-count')) {
                const table = event.target.closest('.migration-summary-table');
                if (table) calculateMigrationTotals(table);
            }
        };
        wizardFormElement?.addEventListener('input', recalculateChangedTable);
        wizardFormElement?.addEventListener('change', recalculateChangedTable);

        document.querySelectorAll('.section-toggle').forEach(toggle => {
            const sync = () => document.querySelector(toggle.dataset.target)?.classList.toggle('d-none', !toggle.checked);
            toggle.addEventListener('change', sync);
            sync();
        });
        function syncAllBoolRadios() {
            document.querySelectorAll('.bool-radio').forEach(radio => {
                const hidden = document.getElementById(radio.dataset.field);
                radio.checked = String(hidden.value).toLowerCase() === radio.value;
                const section = document.querySelector(radio.dataset.section);
                if (radio.checked && section) section.classList.toggle('d-none', radio.value !== 'true');
            });
        }
        document.querySelectorAll('.bool-radio').forEach(radio => radio.addEventListener('change', () => {
            if (!radio.checked) return;
            document.getElementById(radio.dataset.field).value = radio.value;
            document.querySelector(radio.dataset.section)?.classList.toggle('d-none', radio.value !== 'true');
        }));
        syncAllBoolRadios();
        function syncMigrationDirection() {
            const selected = document.querySelector('.migration-direction:checked');
            if (!selected) return;
            const inward = selected.value === 'true';
            document.getElementById('migrationIsInward').value = inward;
            document.getElementById('inwardMigration')?.classList.toggle('d-none', !inward);
            document.getElementById('outwardMigration')?.classList.toggle('d-none', inward);
        }
        document.querySelectorAll('.migration-direction').forEach(x => x.addEventListener('change', syncMigrationDirection));
        syncMigrationDirection();
        function syncAnimalMigrationDirection() {
            const selected = document.querySelector('.animal-migration-direction:checked');
            const inward = selected?.value === 'Inward';
            document.getElementById('animalMigrationInward')?.classList.toggle('d-none', !inward);
            document.getElementById('animalMigrationOutward')?.classList.toggle('d-none', inward);
            const title = document.getElementById('animalMigrationRouteTitle');
            if (title) title.textContent = inward ? 'ወደ ወረዳው የሚገቡ እንስሳት መስመር' : 'ከወረዳው የሚወጡ እንስሳት መስመር';
        }
        document.querySelectorAll('.animal-migration-direction').forEach(x => x.addEventListener('change', syncAnimalMigrationDirection));
        syncAnimalMigrationDirection();
        document.querySelectorAll('.aid-provided, .aid-distributed').forEach(input => input.addEventListener('input', () => {
            const row = input.closest('tr');
            const provided = Number(row.querySelector('.aid-provided').value) || 0;
            const distributed = Number(row.querySelector('.aid-distributed').value) || 0;
            row.querySelector('.aid-percent').value = provided > 0 ? Math.min(100, distributed / provided * 100).toFixed(2) : '0';
            const distributedInput = row.querySelector('.aid-distributed');
            distributedInput.classList.toggle('is-invalid', distributed > provided);
            distributedInput.setCustomValidity(distributed > provided ? 'የተሰራጨው መጠን ከቀረበው መጠን ሊበልጥ አይችልም።' : '');
        }));
        document.querySelectorAll('input[name$=".DamageRateInPercent"]').forEach(input => {
            input.min = '0';
            input.max = '100';
            input.step = '0.01';

            let feedback = input.parentElement?.querySelector('.damage-rate-feedback');
            if (!feedback) {
                feedback = document.createElement('div');
                feedback.className = 'invalid-feedback damage-rate-feedback';
                feedback.textContent = 'የጉዳት መጠን (%) ከ0 እስከ 100 ብቻ መሆን አለበት።';
                input.insertAdjacentElement('afterend', feedback);
            }

            const validateDamageRate = () => {
                const hasValue = input.value.trim() !== '';
                const value = Number(input.value);
                const invalid = hasValue && (!Number.isFinite(value) || value < 0 || value > 100);
                input.setCustomValidity(invalid ? feedback.textContent : '');
                input.classList.toggle('is-invalid', invalid);
                input.classList.toggle('is-valid', hasValue && !invalid);
            };

            input.addEventListener('input', validateDamageRate);
            input.addEventListener('change', validateDamageRate);
            validateDamageRate();
        });
        document.querySelectorAll('input[type="checkbox"][name^="Selected"]').forEach(box => {
            const syncImpact = () => document.querySelectorAll(`.impact-card[data-impact-key="${box.value}"]`).forEach(card => card.classList.toggle('d-none', !box.checked));
            box.addEventListener('change', syncImpact);
            syncImpact();
        });
        document.querySelectorAll('.market-current-price').forEach(input => input.addEventListener('input', updateMarketComparison));
        function updateMarketComparison(event) {
            const row = event.target.closest('tr');
            const current = Number(event.target.value) || 0;
            const previousInput = row.querySelector('.market-previous-price');
            // Only the immediately preceding week is compared. Without it the row is
            // New (no history at all) or Uncompared (older history only).
            if (!previousInput || previousInput.value === '') {
                row.querySelectorAll('.market-status').forEach(x => x.value = previousInput?.dataset.noComparisonStatus || 4);
                row.querySelector('.market-difference').value = '';
                row.querySelector('.market-percentage').value = '';
                return;
            }
            const previous = Number(previousInput.value) || 0;
            const status = current > previous ? 1 : current < previous ? 2 : 3;
            row.querySelectorAll('.market-status').forEach(x => x.value = status);
            row.querySelector('.market-difference').value = (current - previous).toFixed(2);
            row.querySelector('.market-percentage').value = previous > 0 ? ((current - previous) / previous * 100).toFixed(2) : '0';
        }

        async function refreshPreviousWeekPrices() {
            const woredaId = document.getElementById('WoredaId')?.value;
            const startDate = document.getElementById('StartDate')?.value;
            if (!woredaId || !startDate) return;
            try {
                const response = await fetch(`@Url.Action("GetPreviousWeekPrices", "RegisterationWizard")?${new URLSearchParams({ woredaId, startDate })}`, {
                    headers: { 'Accept': 'application/json' }, cache: 'no-store'
                });
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                const data = await response.json();
                const applyRows = (prefix, key, rows) => (rows || []).forEach(item => {
                    const hidden = [...document.querySelectorAll(`input[name^="${prefix}["][name$="].${key}"]`)]
                        .find(x => x.value.toLowerCase() === String(item.id).toLowerCase());
                    const row = hidden?.closest('tr');
                    const previousInput = row?.querySelector('.market-previous-price');
                    if (!previousInput) return;
                    previousInput.value = item.previousWeekPrice ?? '';
                    previousInput.dataset.noComparisonStatus = item.noComparisonStatus ?? '';
                    updateMarketComparison({ target: row.querySelector('.market-current-price') });
                });
                applyRows('GrainPriceRows', 'GrainTypeId', data.grainPriceRows);
                applyRows('AnimalPriceRows', 'AnimalTypeId', data.animalPriceRows);
            } catch (error) {
                console.error('Previous week price load failed:', error);
            }
        }

        // A kebele already selected under high rainfall cannot also be reported as drought-affected.
        function syncDroughtKebeleOptions() {
            const highRainfallIds = new Set([...document.querySelectorAll('.kebele-checkbox:checked')].map(cb => cb.value));
            document.querySelectorAll('.drought-kebele-checkbox').forEach(cb => {
                const excluded = highRainfallIds.has(cb.value);
                if (excluded) cb.checked = false;
                cb.closest('.form-check')?.classList.toggle('d-none', excluded);
            });
        }
        document.querySelectorAll('.kebele-checkbox').forEach(cb => cb.addEventListener('change', syncDroughtKebeleOptions));

        // Per-disease damage fields and defensive activities are mandatory only while their card/section is shown
        // (an inactive wizard step does not count as hidden).
        function syncConditionalRequired() {
            document.querySelectorAll('[data-required-when-visible]').forEach(input => {
                input.required = !input.parentElement.closest('.d-none:not(.wizard-step)');
            });
        }

        function addDefensiveActivityRow(activity = '', area = '') {
            const body = document.getElementById('defensiveActivityRows');
            const row = document.createElement('tr');
            row.className = 'defensive-activity-row';
            row.innerHTML = `<td class="defensive-activity-index"></td>
                <td><input class="form-control" maxlength="300" data-required-when-visible="true" data-field="Activity" /></td>
                <td><input class="form-control" type="number" min="0" step="0.01" data-field="AreaCoveredInHectares" /></td>
                <td><button type="button" class="btn btn-sm btn-outline-danger remove-defensive-activity" title="አስወግድ"><i class="fas fa-trash"></i></button></td>`;
            row.querySelector('[data-field="Activity"]').value = activity ?? '';
            row.querySelector('[data-field="AreaCoveredInHectares"]').value = area ?? '';
            body.appendChild(row);
            renumberDefensiveActivities();
            return row;
        }

        // Keeps posted names contiguous (CropDefensiveActivities[0..n]) so MVC binds every row.
        function renumberDefensiveActivities() {
            document.querySelectorAll('#defensiveActivityRows .defensive-activity-row').forEach((row, index) => {
                row.querySelector('.defensive-activity-index').textContent = index + 1;
                row.querySelectorAll('input').forEach(input => {
                    const field = input.dataset.field || input.name.split('.').pop();
                    input.dataset.field = field;
                    input.name = `CropDefensiveActivities[${index}].${field}`;
                });
            });
            syncConditionalRequired();
        }

        function setDefensiveActivities(items) {
            document.getElementById('defensiveActivityRows').innerHTML = '';
            (items || []).forEach(x => addDefensiveActivityRow(x.activity, x.areaCoveredInHectares));
            renumberDefensiveActivities();
        }

        // Draft snapshots store field names only, so recreate enough rows before their values are applied.
        function ensureDefensiveActivityRows(names) {
            const highest = Math.max(-1, ...names.map(name => Number(/^CropDefensiveActivities\[(\d+)\]/.exec(name)?.[1] ?? -1)));
            while (document.querySelectorAll('#defensiveActivityRows .defensive-activity-row').length <= highest) addDefensiveActivityRow();
        }

        document.getElementById('addDefensiveActivity')?.addEventListener('click', () => {
            addDefensiveActivityRow().querySelector('input')?.focus();
        });
        document.getElementById('defensiveActivityRows')?.addEventListener('click', event => {
            const button = event.target.closest('.remove-defensive-activity');
            if (!button) return;
            button.closest('tr').remove();
            renumberDefensiveActivities();
            document.getElementById('earlyWarningForm').dispatchEvent(new Event('change'));
        });
        renumberDefensiveActivities();

        // A danger's "Other" damage category needs a description.
        function syncAccidentOtherDamage() {
            document.querySelectorAll('.accident-damage-other').forEach(box => {
                box.closest('.impact-card')?.querySelector('.accident-other-damage')?.classList.toggle('d-none', !box.checked);
            });
            syncConditionalRequired();
        }
        document.querySelectorAll('.accident-damage-other').forEach(box => box.addEventListener('change', syncAccidentOtherDamage));
        document.getElementById('earlyWarningForm')?.addEventListener('change', syncConditionalRequired);

        function updateMaxKebeleLimit() {
            const totalKebelesInput = document.getElementById("totalWoredaKebeles");
            if (totalKebelesInput) {
                currentWoredaMaxKebeles = parseInt(totalKebelesInput.value) || 0;
            }
            
            const badge = document.getElementById("woredaKebeleCountBadge");
            if (badge) {
                badge.innerText = currentWoredaMaxKebeles;
            }

            ["rainFull", "rainPartial", "rainNone", "rainNoData", "rainHigh", "rainMedium", "rainMediumHigh", "rainLow", "rainLowMedium", "rainAmountNoData"]
                .forEach(id => document.getElementById(id)?.setAttribute("max", currentWoredaMaxKebeles));
        }

        function showStep(n) {
            steps[n].classList.remove("d-none");
            // Recalculate when a step becomes visible. This is especially
            // important after a POST validation response restores Step 15.
            steps[n].querySelectorAll('.calc-table').forEach(calculateGridTotals);
            steps[n].querySelectorAll('.migration-summary-table').forEach(calculateMigrationTotals);
            updateMalnutritionRates();
            document.getElementById("prevBtn").classList.toggle("d-none", n === 0);

            if (n === (totalSteps - 1)) {
                document.querySelectorAll('.calc-table').forEach(calculateGridTotals);
                buildDataPreviewEngine();
                document.getElementById("nextBtn").className = isReviewMode ? "btn btn-outline-secondary px-5 ms-auto disabled" : "btn btn-success px-5 ms-auto";
                document.getElementById("nextBtn").innerHTML = isReviewMode
                    ? '<i class="fas fa-check-circle me-2"></i>ግምገማው ተጠናቋል'
                    : 'መረጃውን በአንድነት መዝግብ <i class="fas fa-cloud-upload-alt ms-2"></i>';
            } else {
                document.getElementById("nextBtn").className = "btn btn-primary px-5 ms-auto";
                document.getElementById("nextBtn").innerHTML = 'ቀጣይ ገጽ <i class="fas fa-arrow-right ms-2"></i>';
            }

            document.getElementById("stepIndicator").innerText = `ደረጃ ${n + 1} ከ ${totalSteps}`;
            document.getElementById("wizardProgress").style.width = ((n + 1) / totalSteps) * 100 + "%";
        }

        function navigateToField(field) {
            if (!field) return false;
            let container = field.parentElement;
            while (container && !container.classList.contains('wizard-step')) {
                if (container.classList.contains('conditional-section') || container.classList.contains('impact-card'))
                    container.classList.remove('d-none');
                container = container.parentElement;
            }
            const step = field.closest('.wizard-step');
            if (step) {
                const stepIndex = Array.from(steps).indexOf(step);
                if (stepIndex >= 0) {
                    Array.from(steps).forEach(x => x.classList.add('d-none'));
                    currentStep = stepIndex;
                    showStep(currentStep);
                }
            }
            field.classList.add('is-invalid');
            setTimeout(() => {
                field.scrollIntoView({ behavior: 'smooth', block: 'center' });
                if (!field.disabled && field.type !== 'hidden') field.focus({ preventScroll: true });
            }, 100);
            return true;
        }

        function navigateToServerValidationError() {
            const errorKeys = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(serverErrorFields));
            for (const key of errorKeys) {
                const escaped = CSS.escape(key);
                const candidates = [
                    ...document.querySelectorAll(`[name="${escaped}"]`),
                    ...document.querySelectorAll(`[name^="${escaped}["]`),
                    ...document.querySelectorAll(`[name$=".${escaped}"]`)
                ];
                const field = candidates.find(x => x.type !== 'hidden' && !x.closest('.d-none'))
                    || candidates.find(x => x.type !== 'hidden') || candidates[0];
                if (navigateToField(field)) return;
            }
            const summary = document.getElementById('errorSummaryBox');
            if (errorKeys.length && summary) {
                summary.classList.remove('d-none');
                summary.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        function showWizardMessage(message, type = 'danger', scroll = true) {
            const banner = document.getElementById('wizardModeBanner');
            const text = document.getElementById('wizardModeText');
            if (!banner || !text) return;
            banner.className = `alert alert-${type} py-2 shadow-sm animate-fade-in`;
            text.textContent = message;
            if (scroll) banner.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        async function checkSelectedWeek() {
            const startDate = document.getElementById('StartDate')?.value;
            if (!startDate) return null;
            try {
                const response = await fetch(`@Url.Action("CheckWeeklySubmission", "RegisterationWizard")?startDate=${encodeURIComponent(startDate)}`, {
                    headers: { 'Accept': 'application/json' }, cache: 'no-store'
                });
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                return await response.json();
            } catch (error) {
                if (isNetworkError(error)) {
                    goneOffline();
                    return { checkFailed: true, offline: true };
                }
                console.error('Weekly duplicate check failed:', error);
                showWizardMessage('የሳምንቱን መዝገብ ማረጋገጥ አልተቻለም። እባክዎ ግንኙነቱን አረጋግጠው እንደገና ይሞክሩ።', 'warning');
                return { checkFailed: true };
            }
        }

        async function loadExistingWeeklyData(showMissingAsNew = false) {
            const woredaSelect = document.getElementById('WoredaId');
            const startDateInput = document.getElementById('StartDate');
            const endDateInput = document.getElementById('EndDate');
            if (!woredaSelect?.value || !startDateInput?.value || !endDateInput?.value) return false;

            const query = new URLSearchParams({
                woredaId: woredaSelect.value,
                startDate: startDateInput.value,
                endDate: endDateInput.value
            });
            const response = await fetch(`@Url.Action("GetExistingWizardData", "RegisterationWizard")?${query}`, {
                headers: { 'Accept': 'application/json' }, cache: 'no-store'
            });
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            const data = await response.json();
            if (!data.exists) {
                if (showMissingAsNew) {
                    document.getElementById('RecordId').value = '0';
                    document.getElementById('wizardModeBanner').classList.remove('d-none', 'alert-warning');
                    document.getElementById('wizardModeBanner').classList.add('alert-info');
                    document.getElementById('wizardModeText').innerText = '✨ አዲስ ሳምንታዊ መረጃ ምዝገባ (Create Mode Active)...';
                }
                return false;
            }

            serverDraftEnabled = false;
            document.getElementById('RecordId').value = '1';
            document.getElementById('wizardModeBanner').classList.remove('d-none', 'alert-info');
            document.getElementById('wizardModeBanner').classList.add('alert-warning');
            document.getElementById('wizardModeText').innerText = data.workflowStatus === 'Draft'
                ? 'የዚህ ሳምንት የተቀመጠው ረቂቅ መረጃ ተጭኗል፤ ከቆሙበት ቀጥለው ያጠናቅቁ።'
                : data.canEdit ? `ሪፖርቱ በዞን ተመልሷል፤ ማስተካከልና እንደገና መላክ ይችላሉ። ${data.latestWorkflowComment ? 'ምክንያት፡ ' + data.latestWorkflowComment : ''}`
                : `ሪፖርቱ ተልኳል እና ተቆልፏል (${data.workflowStatus || 'በግምገማ ላይ'})።`;
            const keepLocalChanges = localDraftNeedsUpload && data.canEdit;
            if (keepLocalChanges)
                document.getElementById('wizardModeText').innerText = 'በዚህ መሣሪያ ላይ ያለ ግንኙነት የሞሉት መረጃ ተጭኗል፤ ወደ ዳታቤዝ ይቀመጣል።';
            isHydratingWeeklyData = true;
            try {
                if (keepLocalChanges) {
                    // Changes made offline are newer than the server's draft.
                } else if (data.workflowStatus === 'Draft' && data.draftFields) {
                    if (data.recordStartDate) document.getElementById('StartDate').value = data.recordStartDate;
                    if (data.recordEndDate) document.getElementById('EndDate').value = data.recordEndDate;
                    applyServerDraftFields(data.draftFields);
                    if (!('HasAnimalMigration' in data.draftFields)) {
                        // Drafts saved before the yes/no question existed: answer it from the counts entered.
                        const hasAnimals = [...document.querySelectorAll('.migration-count')].some(x => Number(x.value) > 0);
                        document.getElementById('animalMigrationValue').value = hasAnimals ? 'true' : 'false';
                        syncAllBoolRadios();
                    }
                } else {
                    hydrateWizardForm(data);
                }
                syncDroughtKebeleOptions();
            } finally {
                isHydratingWeeklyData = false;
            }
            await refreshPreviousWeekPrices();
            serverDraftEnabled = Boolean(data.canEdit);
            if (keepLocalChanges) await saveServerDraft(false);
            if (!data.canEdit) {
                document.querySelectorAll("#earlyWarningForm input, #earlyWarningForm select, #earlyWarningForm textarea, #earlyWarningForm button[type='submit']")
                    .forEach(el => {
                        if (el.type !== 'hidden' && el.getAttribute('form') !== 'zoneDecisionForm')
                            el.disabled = true;
                    });
            }
            return true;
        }

        async function saveServerDraft(showConfirmation = false) {
            if (!serverDraftEnabled || isSubmittingWizard) return true;
            const form = document.getElementById('earlyWarningForm');
            const startDate = document.getElementById('StartDate')?.value;
            const endDate = document.getElementById('EndDate')?.value;
            if (!startDate || !endDate) return false;
            try {
                serverDraftRequest?.abort();
                serverDraftRequest = new AbortController();
                const response = await fetch('@Url.Action("SaveDraft", "RegisterationWizard")', {
                    method: 'POST', body: new FormData(form), headers: { 'Accept': 'application/json' },
                    signal: serverDraftRequest.signal
                });
                const result = await response.json().catch(() => ({}));
                if (!response.ok) {
                    showWizardMessage(result.message || 'ረቂቅ መረጃውን ማስቀመጥ አልተቻለም።', 'danger');
                    return false;
                }
                if (showConfirmation) showWizardMessage('ረቂቅ መረጃው በዳታቤዝ ተቀምጧል። በሌላ ጊዜ ተመልሰው መቀጠል ይችላሉ።', 'success');
                else if (offlineNoticeShown) showWizardMessage('ግንኙነት ተመልሷል፤ ያለ ግንኙነት የሞሉት መረጃ በዳታቤዝ ተቀምጧል።', 'success', false);
                offlineNoticeShown = false;
                localDraftNeedsUpload = false;
                writeLocalDraft();
                window.EWOffline?.setReachable(true);
                return true;
            } catch (error) {
                if (error.name === 'AbortError') return true;
                if (isNetworkError(error)) {
                    goneOffline();
                    return true;
                }
                console.error('Draft save failed:', error);
                showWizardMessage('ረቂቅ መረጃውን ማስቀመጥ አልተቻለም፤ ግንኙነቱን አረጋግጠው ይሞክሩ።', 'warning');
                return false;
            }
        }

        function scheduleServerDraftSave() {
            if (!serverDraftEnabled || isSubmittingWizard || isRestoringDraft) return;
            clearTimeout(serverDraftTimer);
            serverDraftTimer = setTimeout(() => saveServerDraft(false), 900);
        }

        // Resolves true when the encoder ticks the acknowledgement and confirms; false on cancel, Esc or backdrop click.
        function confirmFinalSubmit() {
            const dialog = document.getElementById('submitConfirm');
            const ack = document.getElementById('submitConfirmAck');
            const ok = document.getElementById('submitConfirmOk');
            const cancel = document.getElementById('submitConfirmCancel');
            if (!dialog || !ack || !ok || !cancel) return Promise.resolve(window.confirm('መረጃው ከተላከ በኋላ ማስተካከል አይቻልም። ለመላክ እርግጠኛ ነዎት?'));

            const start = document.getElementById('StartDate')?.value;
            const end = document.getElementById('EndDate')?.value;
            document.getElementById('submitConfirmWeek').textContent = start && end
                ? `ከ${EthiopianDate.format(start)} እስከ ${EthiopianDate.format(end)} ዓ/ም` : '-';
            ack.checked = false;
            ok.disabled = true;
            dialog.hidden = false;
            ack.focus();

            return new Promise(resolve => {
                const onAck = () => { ok.disabled = !ack.checked; };
                const onKey = event => { if (event.key === 'Escape') finish(false); };
                const onBackdrop = event => { if (event.target === dialog) finish(false); };
                const onOk = () => finish(ack.checked);
                const onCancel = () => finish(false);
                function finish(result) {
                    dialog.hidden = true;
                    ack.removeEventListener('change', onAck);
                    ok.removeEventListener('click', onOk);
                    cancel.removeEventListener('click', onCancel);
                    dialog.removeEventListener('click', onBackdrop);
                    document.removeEventListener('keydown', onKey);
                    resolve(result);
                }
                ack.addEventListener('change', onAck);
                ok.addEventListener('click', onOk);
                cancel.addEventListener('click', onCancel);
                dialog.addEventListener('click', onBackdrop);
                document.addEventListener('keydown', onKey);
            });
        }

        async function nextPrev(n) {
            if (n === 1 && !isReviewMode) {
                let isStepValid = await validateCurrentStep();
                if (!isStepValid) return false;
            }
            if (serverDraftEnabled && currentStep < totalSteps - 1) {
                const saved = await saveServerDraft(false);
                if (!saved) return false;
            }

            steps[currentStep].classList.add("d-none");
            currentStep += n;

            if (currentStep >= totalSteps) {
                if (isReviewMode) {
                    currentStep = totalSteps - 1;
                    showStep(currentStep);
                    return false;
                }
                const form = document.getElementById("earlyWarningForm");
                syncConditionalRequired();
                document.querySelectorAll('#earlyWarningForm input[type="number"]').forEach(x => x.dispatchEvent(new Event('input')));
                if (!form.checkValidity()) {
                    const invalidField = form.querySelector(':invalid');
                    navigateToField(invalidField);
                    invalidField?.reportValidity();
                    return false;
                }
                form.requestSubmit();
                return false;
            }
            showStep(currentStep);
        }

        // =======================================================
        // CLIENT-SIDE REALTIME INTEGER TYPE CONSTRAINT EVALUATION
        // =======================================================
        document.querySelectorAll(".form-for-int, input[type='number']:not([step='any'])").forEach(input => {
            input.addEventListener("keydown", function(e) {
                if (e.key === '.' || e.key === ',') {
                    e.preventDefault();
                }
            });

            input.addEventListener("input", function() {
                let val = this.value;
                if (parseFloat(val) < 0) {
                    this.value = 0;
                    return;
                }
                if (val.includes(".")) {
                    this.value = Math.floor(parseFloat(val)) || 0;
                }
            });

            input.addEventListener("blur", function() {
                if (this.value.trim() === "") {
                    this.value = 0;
                }
            });
        });

