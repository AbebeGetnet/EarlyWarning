        function applyServerDraftFields(fields) {
            Object.entries(fields || {}).forEach(([name, rawValues]) => {
                const values = Array.isArray(rawValues) ? rawValues.map(String) : [String(rawValues ?? '')];
                Array.from(document.getElementById('earlyWarningForm').elements).filter(x => x.name === name).forEach(field => {
                    if (field.type === 'checkbox' || field.type === 'radio') field.checked = values.includes(field.value);
                    else field.value = values[0] ?? '';
                    field.dispatchEvent(new Event('change', { bubbles: true }));
                    field.dispatchEvent(new Event('input', { bubbles: true }));
                });
            });
            document.querySelectorAll('.calc-table').forEach(calculateGridTotals);
        }

        function buildCompleteWizardReviewHtml() {
            const escapeHtml = value => String(value ?? '').replace(/[&<>'"]/g, character => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
            })[character]);
            let sectionsHtml = '';
            // Steps 2-7 have purpose-built summaries above. From Step 8 onward, clone
            // the actual Wizard layout so Amharic labels, tables and totals stay intact.
            Array.from(document.querySelectorAll('.wizard-step')).slice(7, -1).forEach(step => {
                const clone = step.cloneNode(true);
                clone.classList.remove('wizard-step', 'd-none');
                clone.removeAttribute('id');
                clone.querySelectorAll('.d-none').forEach(hidden => hidden.remove());
                clone.querySelectorAll('button, .field-validation-error, .text-danger.field-validation-valid').forEach(x => x.remove());
                clone.querySelectorAll('input, select, textarea').forEach(field => {
                    if (field.type === 'hidden') { field.remove(); return; }
                    if (field.type === 'radio' || field.type === 'checkbox') {
                        if (!field.checked) {
                            const label = field.closest('label');
                            if (label) label.remove(); else field.remove();
                            return;
                        }
                        const marker = document.createElement('span');
                        marker.className = 'badge bg-primary ms-1';
                        marker.textContent = 'ተመርጧል';
                        field.replaceWith(marker);
                        return;
                    }
                    let value = field.tagName === 'SELECT'
                        ? field.options[field.selectedIndex]?.text
                        : field.value;
                    if (value == null || String(value).trim() === '') value = '-';
                    const display = document.createElement(field.tagName === 'TEXTAREA' ? 'div' : 'span');
                    display.className = 'd-block px-2 py-1 fw-semibold text-dark review-field-value';
                    display.textContent = value;
                    field.replaceWith(display);
                });
                clone.querySelectorAll('table').forEach(table => table.classList.add('table-striped'));
                sectionsHtml += `<div class="card mb-4 shadow-sm border-0"><div class="card-body p-0">${clone.innerHTML}</div></div>`;
            });
            return `<div class="mt-4"><h4 class="border-bottom pb-2">ሁሉም የተሞሉ መረጃዎች — የመጨረሻ ማረጋገጫ</h4>${sectionsHtml}</div>`;
        }

        function compileReviewGridHtml(tableId, theme) {
            const table = document.getElementById(tableId);
            if (!table) return '';
            return compileReviewTable(table, theme);
        }

        function compileSelectedImpactTables(containerId, selectedSelector, theme) {
            const container = document.getElementById(containerId);
            if (!container) return '';
            const escapeHtml = value => String(value ?? '').replace(/[&<>'"]/g, character => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
            })[character]);

            return Array.from(document.querySelectorAll(selectedSelector)).map(checkbox => {
                const card = Array.from(container.querySelectorAll('.impact-card'))
                    .find(item => item.dataset.impactKey === checkbox.value);
                const table = card?.querySelector('.calc-table');
                if (!table) return '';
                calculateGridTotals(table);
                const name = checkbox.dataset.name || card.querySelector('.card-header')?.textContent?.trim() || '-';
                return `<div class="card mt-3 border-${theme}">
                    <div class="card-header fw-bold bg-${theme} bg-opacity-10">${escapeHtml(name)}</div>
                    <div class="card-body p-0">${compileReviewTable(table, theme)}</div>
                </div>`;
            }).join('');
        }

        function compileReviewTable(table, theme) {
            let rowsHtml = '';
            table.querySelectorAll('tbody tr').forEach(row => {
                let cell = row.querySelector('td[data-label]');
                let category = cell ? cell.getAttribute('data-label') : row.querySelector('td')?.textContent?.trim() || 'ምድብ';
                let male = row.querySelector('.val-male')?.value || 0;
                let female = row.querySelector('.val-female')?.value || 0;
                let total = row.querySelector('.row-total')?.innerText || 0;
                rowsHtml += `<tr><td class="bg-light fw-bold text-start ps-3">${category}</td><td>${male}</td><td>${female}</td><td class="fw-bold bg-light">${total}</td></tr>`;
            });

            return `
                <div class="table-responsive mt-2">
                    <table class="table table-sm table-bordered text-center m-0" style="font-size:0.85rem;">
                        <thead class="table-${theme} text-dark">
                            <tr><th>የተጎጂዎች ምድብ</th><th style="width:25%;">ወንድ</th><th style="width:25%;">ሴት</th><th style="width:20%;">ድምር</th></tr>
                        </thead>
                        <tbody>${rowsHtml}</tbody>
                        <tfoot class="table-light fw-bold text-${theme}">
                            <tr>
                                <td class="text-start ps-3">ጠቅላላ ድምር</td>
                                <td>${table.querySelector('.total-male')?.innerText || 0}</td>
                                <td>${table.querySelector('.total-female')?.innerText || 0}</td>
                                <td class="bg-${theme} text-white">${table.querySelector('.grand-total')?.innerText || 0}</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>`;
        }

        document.addEventListener("DOMContentLoaded", async function() {
            const form = document.getElementById("earlyWarningForm");
            const draftKey = `early-warning-wizard:${document.getElementById("WoredaId")?.value || "woreda"}:${document.getElementById("StartDate")?.value || "week"}`;

            document.querySelectorAll('#earlyWarningForm input[type="number"]').forEach(input => {
                const decimalName = /(hectare|price|quantity|percentage|rate|plan|ploughed|sown|harvest|residual)/i.test(input.name || '');
                const integerField = input.step !== 'any' && input.step !== '0.01' && !decimalName && !input.classList.contains('market-current-price') && !input.classList.contains('aid-provided') && !input.classList.contains('aid-distributed');
                input.min = input.min || '0';
                input.max = input.max || (integerField ? '1000000000' : '999999999999.99');
                input.inputMode = integerField ? 'numeric' : 'decimal';
                input.setAttribute('pattern', integerField ? '[0-9]*' : '[0-9]+([.][0-9]+)?');
                input.addEventListener('keydown', event => {
                    if (['e', 'E', '+', '-', ','].includes(event.key) || (integerField && event.key === '.')) event.preventDefault();
                });
                input.addEventListener('beforeinput', event => {
                    if (!event.data || event.inputType.startsWith('delete')) return;
                    const proposed = `${input.value.slice(0, input.selectionStart ?? input.value.length)}${event.data}${input.value.slice(input.selectionEnd ?? input.value.length)}`;
                    const allowed = integerField ? /^\d*$/.test(proposed) : /^\d*(\.\d{0,2})?$/.test(proposed);
                    if (!allowed) event.preventDefault();
                });
                input.addEventListener('paste', event => {
                    const pasted = event.clipboardData?.getData('text') ?? '';
                    const allowed = integerField ? /^\d+$/.test(pasted) : /^\d+(\.\d{1,2})?$/.test(pasted);
                    if (!allowed) event.preventDefault();
                });
                input.addEventListener('input', () => {
                    const value = Number(input.value);
                    const invalid = input.value !== '' && (!Number.isFinite(value) || value < Number(input.min) || value > Number(input.max) || (integerField && !Number.isInteger(value)));
                    input.setCustomValidity(invalid ? `ቁጥሩ በ${input.min} እና ${input.max} መካከል መሆን አለበት።` : '');
                    input.classList.toggle('is-invalid', invalid);
                });
            });

            const saveDraft = () => {
                const fields = Array.from(form.elements).filter(x => x.name && x.name !== '__RequestVerificationToken').map(x => ({
                    name: x.name, type: x.type, value: x.value, checked: x.checked
                }));
                sessionStorage.setItem(draftKey, JSON.stringify({ step: currentStep, fields }));
            };
            const restoreDraft = () => {
                if (@(TempData["SuccessMessage"] != null ? "true" : "false")) { sessionStorage.removeItem(draftKey); return; }
                const raw = sessionStorage.getItem(draftKey); if (!raw) return;
                try {
                    const draft = JSON.parse(raw);
                    draft.fields.forEach(saved => {
                        const matches = Array.from(form.elements).filter(x => x.name === saved.name &&
                            ((x.type === 'checkbox' || x.type === 'radio') ? x.value === saved.value : true));
                        matches.forEach(field => {
                            if (field.type === 'checkbox' || field.type === 'radio') field.checked = saved.checked;
                            else field.value = saved.value;
                            field.dispatchEvent(new Event('change', { bubbles: true }));
                            field.dispatchEvent(new Event('input', { bubbles: true }));
                        });
                    });
                    currentStep = Math.max(0, Math.min(Number(draft.step) || 0, totalSteps - 1));
                    steps.forEach(x => x.classList.add('d-none'));
                } catch { sessionStorage.removeItem(draftKey); }
            };
            form.addEventListener('input', saveDraft);
            form.addEventListener('change', saveDraft);
            form.addEventListener('input', scheduleServerDraftSave);
            form.addEventListener('change', scheduleServerDraftSave);
            form.addEventListener('invalid', event => {
                if (event.target instanceof HTMLElement) navigateToField(event.target);
            }, true);
            document.getElementById('StartDate')?.addEventListener('change', async () => {
                if (isHydratingWeeklyData) return;
                const startInput = document.getElementById('StartDate');
                const selected = startInput?.value ? new Date(`${startInput.value}T00:00:00`) : null;
                if (selected && !Number.isNaN(selected.valueOf())) {
                    const daysSinceMonday = (selected.getDay() + 6) % 7;
                    selected.setDate(selected.getDate() - daysSinceMonday);
                    const wednesday = new Date(selected);
                    wednesday.setDate(wednesday.getDate() + 2);
                    const localDate = value => `${value.getFullYear()}-${String(value.getMonth() + 1).padStart(2, '0')}-${String(value.getDate()).padStart(2, '0')}`;
                    startInput.value = localDate(selected);
                    document.getElementById('EndDate').value = localDate(wednesday);
                }
                const duplicate = await checkSelectedWeek();
                if (duplicate?.exists) {
                    showWizardMessage(duplicate.message, duplicate.editable ? 'warning' : 'danger');
                    try { await loadExistingWeeklyData(false); }
                    catch (error) { console.error('Existing weekly data load failed:', error); }
                } else {
                    serverDraftEnabled = false;
                    document.getElementById('RecordId').value = '0';
                }
            });
            form.addEventListener('submit', async event => {
                event.preventDefault();
                document.querySelectorAll('#earlyWarningForm input[type="number"]').forEach(x => x.dispatchEvent(new Event('input')));
                const invalidFields = Array.from(form.querySelectorAll('input, select, textarea')).filter(x => x.type !== 'hidden' && !x.checkValidity());
                const invalidField = invalidFields.find(x => x.offsetParent !== null) || invalidFields[0];
                if (invalidField) {
                    navigateToField(invalidField);
                    invalidField.reportValidity();
                    return;
                }
                const duplicate = await checkSelectedWeek();
                if (duplicate?.checkFailed) return;
                if (duplicate?.exists && !duplicate.editable) {
                    showWizardMessage(duplicate.message, 'danger');
                    navigateToField(document.getElementById('StartDate'));
                    return;
                }
                isSubmittingWizard = true;
                serverDraftEnabled = false;
                clearTimeout(serverDraftTimer);
                serverDraftRequest?.abort();
                saveDraft();
                form.submit();
            });
            if (!isReviewMode) {
                isHydratingWeeklyData = true;
                try {
                    restoreDraft();
                } finally {
                    isHydratingWeeklyData = false;
                }
            }
            const initialWeeklyRecord = isReviewMode ? { exists: true } : await checkSelectedWeek();
            if (initialWeeklyRecord?.exists) {
                try { await loadExistingWeeklyData(false); }
                catch (error) {
                    console.error('Initial weekly data load failed:', error);
                    showWizardMessage('የተቀመጠውን የሳምንት መረጃ መጫን አልተቻለም። ገጹን እንደገና ይጫኑ።', 'danger');
                }
            }
            showStep(currentStep);
            updateMaxKebeleLimit();
            toggleCropPestFields();
            togglePastureFields();
            toggleWaterFields();
            toggleAnimalHealthFields();
            initMatrixCalculations();
            navigateToServerValidationError();
        });
    </script>
}
