                                <div class="row g-3">
                                    <div class="col-md-4"><label asp-for="CropGrowth.AtSeedStage" class="form-label">በዘር ደረጃ</label><input asp-for="CropGrowth.AtSeedStage" id="cropSeedStage" class="form-control" type="number" step="0.01" min="0" /></div>
                                    <div class="col-md-4"><label asp-for="CropGrowth.AtGerminationStage" class="form-label">በብቅለት ደረጃ</label><input asp-for="CropGrowth.AtGerminationStage" id="cropGerminationStage" class="form-control" type="number" step="0.01" min="0" /></div>
                                    <div class="col-md-4"><label asp-for="CropGrowth.AtGrowthStage" class="form-label">በእድገት ደረጃ</label><input asp-for="CropGrowth.AtGrowthStage" id="cropGrowthStage" class="form-control" type="number" step="0.01" min="0" /></div>
                                    <div class="col-md-6"><label asp-for="CropGrowth.AtFruitStage" class="form-label">ፍሬ በመሙላት ደረጃ</label><input asp-for="CropGrowth.AtFruitStage" id="cropFruitStage" class="form-control" type="number" step="0.01" min="0" /></div>
                                    <div class="col-md-6"><label asp-for="CropGrowth.AtHarvestingStage" class="form-label">በመሰብሰብ ደረጃ</label><input asp-for="CropGrowth.AtHarvestingStage" id="cropHarvestingStage" class="form-control" type="number" step="0.01" min="0" /></div>
                                </div>
                            </div>
                        </div>
                        <h5 class="text-warning mb-3">3.2፡ የሰብል ተባይ እና በሽታ ተከስቷል?</h5>
                        <div class="card p-3 bg-light mb-3">
                            <label class="form-label fw-bold mb-2">የሰብል ተባይ እና በሽታ ተከስቷል?</label>
                            <div class="d-flex gap-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="hasPestRadio" id="hasPestYes" data-detail="true" value="true" onchange="toggleCropPestFields()">
                                    <label class="form-check-label fw-bold" for="hasPestYes">አዎ ተከስቷል</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="hasPestRadio" id="hasPestNo" data-detail="false" value="false" onchange="toggleCropPestFields()" checked>
                                    <label class="form-check-label fw-bold" for="hasPestNo">አልተከሰተም</label>
                                </div>
                            </div>
                            <input type="hidden" asp-for="CropPestAndDeseaseReport.HasPestAndDeseasOccured" id="hasPestSwitch" value="false" />
                        </div>

                        <div id="cropPestFields" class="d-none">
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label asp-for="CropPestAndDeseaseReport.TypeOfCropAffected" class="form-label"></label>
                                    <input asp-for="CropPestAndDeseaseReport.TypeOfCropAffected" id="pestCropType" class="form-control" />
                                </div>
                            </div>

                            <div class="p-3 bg-light rounded mb-3 shadow-sm border">
                                <label class="form-label fw-bold text-danger"><i class="fas fa-virus me-1"></i>የተከሰቱ የበሽታ/ተባይ አይነቶች</label>
                                <div class="row pt-2 ms-1">
                                    @if (Model.CropPestAndDeseases != null)
                                    {
                                        foreach (var pest in Model.CropPestAndDeseases)
                                        {
                                            <div class="col-md-4 form-check mb-2">
                                                <input class="form-check-input pest-checkbox" type="checkbox" name="SelectedCropDiseaseIds" value="@pest.Id" data-name="@pest.Name" id="pest_@pest.Id" />
                                                <label class="form-check-label" for="pest_@pest.Id">@pest.Name</label>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>

