                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="waterEnoughRadio" id="waterEnoughYes" data-detail="false" value="true" onchange="toggleWaterFields()" checked>
                                    <label class="form-check-label fw-bold" for="waterEnoughYes">በቂ ነው</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="waterEnoughRadio" id="waterEnoughNo" data-detail="true" value="false" onchange="toggleWaterFields()">
                                    <label class="form-check-label fw-bold" for="waterEnoughNo">እጥረት አለ</label>
                                </div>
                            </div>
                            <input type="hidden" asp-for="AnimalWaterSupplyStatus.Enough" id="waterEnoughSwitch" value="true" />
                        </div>

                        <div id="waterFields" class="d-none">
