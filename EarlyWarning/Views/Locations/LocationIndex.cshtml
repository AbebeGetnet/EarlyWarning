@using EarlyWarning.Enums
@model IEnumerable<EarlyWarning.Models.Locations>

@{
    ViewData["Title"] = "Index";
    LocationLevel? parentLevel = ViewBag.ParentLevel;
    var (ChildWord, AddAction) = parentLevel switch
    {
        LocationLevel.ክልል => ("ዞኖች", "AddNewZone"),
        LocationLevel.ዞን => ("ወረዳዎች", "AddNewWoreda"),
        LocationLevel.ወረዳ => ("ቀበሌዎች", "AddNewKebelie"),
        _ => ("አድራሻዎች", (string?)null)
    };
}

<div class="card card-info card-outline">
    <div class="btn btn-info">
        <h4 style="color: white;padding-left:10px;">@(ViewBag.ParentName) – @(ChildWord) ዝርዝር</h4>
        @if (AddAction != null)
        {
            <a asp-action="@AddAction" asp-route-id="@ViewBag.ParentId" class="btn btn-success">@ChildWord ጨምር</a>
        }
        <a asp-action="Index" class="btn btn-secondary">ተመለስ</a>
    </div>
    <div class="card-body">
        <table id="dataTable" class="table">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.LocationAmharicName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.LocationCode)
                    </th>  
                    <th>
                        @Html.DisplayNameFor(model => model.Level)
                    </th>

                    <th>
                        @Html.DisplayNameFor(model => model.PhoneNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CardHeaderTitle)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Parent)
                    </th>
                </tr>
            </thead>
            <tbody>
        @foreach (var item in Model) {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.LocationAmharicName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.LocationCode)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Level)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.PhoneNumber)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CardHeaderTitle)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Parent.LocationAmharicName)
                    </td>                    
                </tr>
        }
            </tbody>
        </table>
    </div>
</div>
