@using EarlyWarning.Extensions
@model EarlyWarning.ViewModels.WeeklyExcelExportViewModel

@{
    ViewData["Title"] = "Excel ሳምንታዊ ሪፖርት ማውረጃ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="_SettingsPageStyles" />

<div class="container-fluid">
    <div class="page-header">
        <h1><i class="fas fa-file-excel"></i> @ViewData["Title"]</h1>
        <p>
            የቅድሚያ ማስጠንቀቂያና ምላሽ ሳምንታዊ ሪፖርት በክልሉ የExcel ቅርጽ (ዝርዝር ስራዎች × ዞን/ወረዳ)።
            @if (!string.IsNullOrEmpty(Model.ScopeName))
            {
                <span>የሪፖርቱ ወሰን፡ <strong>@Model.ScopeName</strong> (@Model.WoredasInScope ወረዳ)</span>
            }
        </p>
    </div>

    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger"><i class="fas fa-exclamation-triangle me-2"></i>@Model.ErrorMessage</div>
    }
    else if (Model.Weeks.Count == 0)
    {
        <div class="alert alert-info"><i class="fas fa-info-circle me-2"></i>ለማውረድ የሚያስችል የተላከ ሳምንታዊ ሪፖርት እስካሁን የለም።</div>
    }
    else
    {
        <div class="table-container">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th><i class="fas fa-calendar-alt"></i> የሪፖርት ሳምንት (ዓ/ም)</th>
                            <th><i class="fas fa-calendar"></i> በፈረንጆች</th>
                            <th><i class="fas fa-map-marker-alt"></i> ሪፖርት የላኩ ወረዳዎች</th>
                            <th><i class="fas fa-download"></i> ማውረጃ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var week in Model.Weeks)
                        {
                            <tr>
                                <td><strong>ከ@(EthiopianDate.FromGregorian(week.StartDate)) - @(EthiopianDate.FromGregorian(week.EndDate))</strong></td>
                                <td>@week.StartDate.ToString("dd/MM/yyyy") — @week.EndDate.ToString("dd/MM/yyyy")</td>
                                <td>@week.WoredasReported ከ @Model.WoredasInScope</td>
                                <td class="action-buttons">
                                    <a asp-action="FormReportExcel" asp-route-startDate="@week.StartDate.ToString("yyyy-MM-dd")" asp-route-endDate="@week.EndDate.ToString("yyyy-MM-dd")"
                                       class="btn btn-sm btn-success btn-action"><i class="fas fa-file-excel"></i> Excel አውርድ</a>
                                    <a asp-action="FormReport" asp-route-startDate="@week.StartDate.ToString("yyyy-MM-dd")" asp-route-endDate="@week.EndDate.ToString("yyyy-MM-dd")"
                                       class="btn btn-sm btn-info btn-action"><i class="fas fa-eye"></i> ቅጹን ይመልከቱ</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
