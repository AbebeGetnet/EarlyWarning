@model EarlyWarning.ViewModels.WeeklyReportPageTwoViewModel
@{
    ViewData["Title"] = $"ሳምንታዊ ሪፖርት በ{Model.BreakdownWord}";
    var weekRoute = new Dictionary<string, string>
    {
        ["startDate"] = Model.StartDate?.ToString("yyyy-MM-dd") ?? "",
        ["endDate"] = Model.EndDate?.ToString("yyyy-MM-dd") ?? ""
    };
}

<partial name="_StandardWeeklyReportStyles" />

<div class="container-fluid mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3 no-print">
        <div>
            <h3 class="mb-1">የቅድሚያ ማስጠንቀቂያና ምላሽ ሳምንታዊ ሪፖርት — በ@(Model.BreakdownWord) ዝርዝር</h3>
            <div class="text-muted small">@Model.ScopeName · ለእያንዳንዱ @Model.BreakdownWord በሪፖርት ደረጃው (ቅርጹ) የተዘጋጀ</div>
        </div>
        <partial name="_WeekPicker" model='("ReportPageTwo", Model.AvailableWeeks, Model.StartDate, Model.EndDate)' />
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-dark" onclick="window.print()"><i class="fas fa-print me-1"></i> አትም</button>
            <a asp-action="Index" asp-all-route-data="weekRoute" class="btn btn-outline-primary">ወደ ተጠቃለለ ሪፖርት</a>
        </div>
    </div>

    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    else if (Model.Reports.Count == 0)
    {
        <div class="alert alert-info">ለማሳየት የተላከ ሳምንታዊ ሪፖርት እስካሁን የለም።</div>
    }
    else
    {
        @if (Model.Reports.Count > 1)
        {
            <nav class="mb-3 no-print">
                @for (var i = 0; i < Model.Reports.Count; i++)
                {
                    <a href="#report-@i" class="btn btn-sm btn-outline-secondary mb-1">@Model.Reports[i].ScopeName</a>
                }
            </nav>
        }
        @for (var i = 0; i < Model.Reports.Count; i++)
        {
            <div id="report-@i"></div>
            <partial name="_StandardWeeklyReport" model="Model.Reports[i]" />
        }
    }
</div>
