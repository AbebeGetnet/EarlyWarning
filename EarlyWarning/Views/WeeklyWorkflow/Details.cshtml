@model EarlyWarning.ViewModels.WeeklyWorkflowDetailsViewModel
@using EarlyWarning.Enums
@using EarlyWarning.Extensions
@{ ViewData["Title"] = "የሪፖርት ዝርዝርና ማጽደቂያ"; }
<div class="container mt-4">
 <a asp-action="Index" class="btn btn-link">← ወደ ዝርዝር</a>
 @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
 @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
 <div class="card shadow-sm mb-4"><div class="card-header"><h4 class="mb-0">@Model.Report.Zone / @Model.Report.Woreda</h4></div><div class="card-body"><div class="row"><div class="col-md-4"><b>ሳምንት:</b> @Model.Report.StartDate.ToString("yyyy-MM-dd") — @Model.Report.EndDate.ToString("yyyy-MM-dd")</div><div class="col-md-4"><b>ሁኔታ:</b> @ReadOnlyFields.EnumLabel(Model.Report.Status)</div><div class="col-md-4"><b>የመጨረሻ እርምጃ:</b> @Model.Report.LastActionAt.ToLocalTime()</div></div></div></div>

 <h5 class="mb-3"><i class="fas fa-file-alt me-2"></i>የተላከው ሙሉ ቅጽ (ለንባብ ብቻ)</h5>
 <partial name="_SubmissionForm" model="Model.Form" />

 @if (Model.ZoneDecisionWindowClosed)
 {
  <div class="alert alert-warning">የዞን ፍቃድ/ውድቅ ጊዜው ሐሙስ ማብቂያ ላይ አልፏል። ሪፖርቱን ማየት ይቻላል፣ ውሳኔ መስጠት ግን አይቻልም።</div>
 }
 @if ((Model.CanZoneApprove || Model.CanRegionApprove) && Model.ApprovalToken != null)
 {
  var level = Model.CanZoneApprove ? "የዞን" : "የክልል";
  <div class="card shadow-sm mb-4 border-success" id="approvalPanel">
   <div class="card-header fw-bold bg-success bg-opacity-10">@level ማጽደቂያ</div>
   <div class="card-body">
    <form asp-action="Act" method="post">
     @Html.AntiForgeryToken()
     <input type="hidden" name="id" value="@Model.Report.Id" />
     <input type="hidden" name="rowVersion" value="@Convert.ToBase64String(Model.Report.RowVersion)" />
     <input type="hidden" name="approvalToken" value="@Model.ApprovalToken" />
     <label class="form-label">አስተያየት (ውድቅ ለማድረግ ግዴታ ነው)</label>
     <textarea name="comment" class="form-control mb-3" maxlength="2000" rows="3"></textarea>
     <button name="decision" value="Approve" class="btn btn-success me-2"><i class="fas fa-check me-1"></i>@level ማጽደቂያ፡ ፍቀድ@(Model.CanZoneApprove ? "ና ለክልል ላክ" : "")</button>
     <button name="decision" value="Reject" class="btn btn-danger"><i class="fas fa-undo me-1"></i>ውድቅ አድርግና @(Model.CanZoneApprove ? "ለወረዳ" : "ለዞን") መልስ</button>
    </form>
   </div>
  </div>
 }
 <div class="card shadow-sm"><div class="card-header fw-bold">ሙሉ የፍቃድና ውድቅ ታሪክ</div><div class="table-responsive"><table class="table table-striped mb-0"><thead><tr><th>ቀን</th><th>ተጠቃሚ / ቦታ</th><th>እርምጃ</th><th>የሁኔታ ለውጥ</th><th>አስተያየት</th></tr></thead><tbody>@foreach(var h in Model.History){<tr><td>@h.PerformedAt.ToLocalTime()</td><td>@h.User<br/><small>@h.Location</small></td><td>@ReadOnlyFields.EnumLabel(h.Action)</td><td>@(h.PreviousStatus.HasValue ? ReadOnlyFields.EnumLabel(h.PreviousStatus.Value) : "-") → @ReadOnlyFields.EnumLabel(h.NewStatus)</td><td>@h.Comment</td></tr>}</tbody></table></div></div>
</div>
