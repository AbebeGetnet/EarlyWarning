@model EarlyWarning.ViewModels.WeeklyFormReportViewModel
@using EarlyWarning.ViewModels
@using EarlyWarning.Services
@{
    ViewData["Title"] = "የቅድመ ማስጠንቀቂያና ምላሽ ሳምንታዊ ሪፖርት";
    string Or(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    // Header follows the signed-in user's administrative level.
    var (officeLine, reportKind) = Model.ScopeLevel switch
    {
        ReportScopeLevel.Region => ($"የ{Or(Model.RegionName)} ክልል አደጋ ስጋት ስራ አመራር ኮሚሽን", "ክልላዊ ማጠቃለያ"),
        ReportScopeLevel.Zone => ($"በ {Or(Model.ZoneName)} ዞን አደጋ ስጋት ስራ አመራር ኮሚሽን ተጠሪ ጽ/ቤት", "የዞን ማጠቃለያ"),
        _ => ($"በ {Or(Model.ZoneName)} ዞን {Or(Model.ScopeName)} ወረዳ አደጋ ስጋት ስራ አመራር ጽ/ቤት", "የወረዳ ሪፖርት")
    };
    var coverageLine = Model.ScopeLevel switch
    {
        ReportScopeLevel.Region => $"ሪፖርት ያስገቡ ዞኖች፡ {Model.Zones.Count} ({string.Join("፣ ", Model.Zones)})፤ ሪፖርት ያስገቡ ወረዳዎች፡ {Model.WoredaCount} ከ {Model.WoredasInScope}",
        ReportScopeLevel.Zone => $"ክልል፡ {Or(Model.RegionName)}፤ ሪፖርት ያስገቡ ወረዳዎች፡ {Model.WoredaCount} ከ {Model.WoredasInScope}",
        _ => $"ክልል፡ {Or(Model.RegionName)}፤ ዞን፡ {Or(Model.ZoneName)}፤ ወረዳ፡ {Or(Model.ScopeName)}"
    };
    // Word-style numbering: a bare section number gets its trailing dot ("1" → "1."); "3.2", "ሀ." and "•" stay as they are.
    // Signature field: the value when known, otherwise a blank line to write on.
    Microsoft.AspNetCore.Html.IHtmlContent SignLine(string label, string? value) =>
        string.IsNullOrWhiteSpace(value)
            ? Html.Raw($"<div class=\"fr-sign-line\"><span>{Html.Encode(label)}፡</span><span class=\"fr-sign-blank\"></span></div>")
            : Html.Raw($"<div class=\"fr-sign-line\"><span>{Html.Encode(label)}፡</span><span class=\"fr-value\">{Html.Encode(value)}</span></div>");
    string ListNumber(string number) => number.Length > 0 && number.All(char.IsDigit) ? number + "." : number;
    // Second list level: bullets ("•") and letter sub-items ("ሀ.") are tabbed in to the parent item's text, and
    // unnumbered lines that belong under them (indent 2+) line up with the bullet's text.
    string Level(FormReportItem item) =>
        item.Number == "•" || (item.Number != "" && !char.IsDigit(item.Number[0])) || (item.Number == "" && item.Indent >= 2) ? "fr-sub" : "";
}

@section Styles {
<style>
    /*
     * Document layout, modelled on a Word document:
     *  - one page width (A4, 210 mm) with the same margins on screen and on paper (15 mm top/bottom, 12 mm sides);
     *  - one vertical rhythm: --fr-gap between items, --fr-section-gap before each section;
     *  - numbered items use a hanging indent: the number sits at the left margin in a fixed column and all text
     *    (including wrapped lines and anything under the item) starts at the same position after it.
     */
    .form-report {
        --fr-num-col: 3.25rem;
        --fr-gap: .3rem;
        --fr-section-gap: 1rem;
        font-family: 'Nyala', 'Abyssinica SIL', 'Noto Sans Ethiopic', 'Ebrima', serif; color: #000; background: #fff;
        max-width: 210mm; margin: 0 auto 2rem; padding: 15mm 12mm; border: 1px solid #dee2e6; box-shadow: 0 .125rem .25rem rgba(0,0,0,.075);
        line-height: 1.5;
    }
    .form-report .fr-header { text-align: center !important; margin: 0 0 var(--fr-section-gap); }
    .form-report .fr-header div { font-weight: 700; font-size: 1.15rem; text-align: center !important; overflow-wrap: anywhere; margin: 0; }
    .form-report .fr-header .fr-coverage { font-weight: 400; font-size: .95rem; color: #555; margin-top: var(--fr-gap); }
    .form-report .fr-header u { text-underline-offset: 4px; }
    .form-report .fr-subtitle { font-weight: 700; margin: 0 0 var(--fr-gap); }

    /* Hanging indent: [number column][text column]. */
    .form-report .fr-item { display: grid; grid-template-columns: var(--fr-num-col) minmax(0, 1fr); align-items: baseline; margin: 0 0 var(--fr-gap); }
    .form-report .fr-item > .fr-num { font-weight: 700; white-space: nowrap; }
    .form-report .fr-item > .fr-body { min-width: 0; }
    /* Level 2: the bullet starts where level-1 text starts; its own text gets a hanging indent of --fr-sub-col. */
    .form-report { --fr-sub-col: 2rem; }
    .form-report .fr-item.fr-sub { margin-left: var(--fr-num-col); grid-template-columns: var(--fr-sub-col) minmax(0, 1fr); }
    /* Values of both levels end in the same column. */
    .form-report .fr-item.fr-sub .fr-line { max-width: calc(32rem - var(--fr-sub-col)); }
    .form-report .fr-section { margin: 0; }
    .form-report .fr-section + .fr-section, .form-report .fr-subtitle + .fr-section { margin-top: var(--fr-section-gap); }
    .form-report .fr-section-title { font-weight: 700; font-size: 1.08rem; }
    .form-report .fr-heading { font-weight: 700; }

    /* label …… value; a long label wraps under its own first line, never under the number. */
    .form-report .fr-line { display: flex; align-items: baseline; gap: .35rem; max-width: 32rem; }
    .form-report .fr-line > .fr-label { flex: 0 1 auto; }
    .form-report .fr-dots { flex: 1 1 1.5rem; border-bottom: 1px dotted #444; min-width: 1.5rem; transform: translateY(-.3em); }
    .form-report .fr-value { font-weight: 700; white-space: nowrap; }
    .form-report .fr-block-label { font-weight: 700; margin: 0 0 .15rem; }
    .form-report .fr-zone-text { margin: 0 0 .15rem; }
    .form-report .fr-zone-text:last-child { margin-bottom: 0; }
    .form-report .fr-zone-text .fr-zone { font-weight: 700; margin-right: .35rem; }
    .form-report .fr-empty { color: #6c757d; font-size: .9rem; }

    .form-report .fr-table { font-size: .9rem; margin: 0; }
    .form-report .fr-table th, .form-report .fr-table td { text-align: left; }
    .form-report .fr-table th { background: #f2f2f2; }
    .form-report .fr-people-table { width: auto; min-width: 22rem; max-width: 32rem; }
    .form-report .fr-people-table td:not(:first-child), .form-report .fr-people-table th:not(:first-child) { min-width: 4.5rem; }
    .form-report .fr-people-table tfoot td { background: #f8f8f8; }

    .form-report .fr-signatures { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: calc(var(--fr-section-gap) * 2); }
    .form-report .fr-signatures .fr-sign-title { font-weight: 700; margin: 0 0 var(--fr-gap); }
    /* "ስም፡ value" with no dotted leader; a field left to fill in by hand gets one plain writing line. */
    .form-report .fr-sign-line { display: grid; grid-template-columns: 4.5rem minmax(0, 14rem); align-items: baseline; margin: 0 0 var(--fr-gap); }
    .form-report .fr-sign-line .fr-value { white-space: normal; }
    .form-report .fr-sign-blank { border-bottom: 1px solid #000; min-height: 1.2em; }
    @@media (max-width: 576px) {
        .form-report { padding: 1.25rem 1rem; --fr-num-col: 2.75rem; }
        .form-report .fr-signatures { grid-template-columns: 1fr; }
    }

    /* A4 portrait, same margins on every page, page number in the bottom margin. */
    @@page {
        size: A4 portrait;
        margin: 15mm 12mm;
        @@bottom-center { content: counter(page) " / " counter(pages); font-family: 'Nyala', 'Noto Sans Ethiopic', serif; font-size: 9pt; color: #444; }
    }
    @@media print {
        /* Only the report itself: no app chrome, loaders, notifications or week picker. */
        .main-header, .main-sidebar, .main-footer, footer.footer, .preloader, #toast-container, .no-print { display: none !important; }
        html, body { width: auto !important; min-width: 0 !important; height: auto !important; margin: 0 !important; padding: 0 !important; background: #fff !important; }
        .wrapper, .content-wrapper, .content, .container-fluid, .fr-page {
            margin: 0 !important; padding: 0 !important; min-height: 0 !important; width: auto !important; max-width: none !important; background: #fff !important; box-shadow: none !important;
        }
        /* The @@page margins are the page margins; the report adds none of its own. */
        .form-report { width: 100%; max-width: none; margin: 0; padding: 0; border: 0; box-shadow: none; font-size: 10.5pt; line-height: 1.45; --fr-num-col: 12mm; }
        .form-report * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .form-report .fr-header div { font-size: 12pt; }
        .form-report .fr-header .fr-coverage { font-size: 9.5pt; }
        .form-report .fr-section-title { font-size: 11pt; }

        /* Nothing is cut off at the page edge: wide tables wrap inside the text column instead of scrolling. */
        .form-report .table-responsive { overflow: visible !important; }
        .form-report .fr-table { width: 100%; font-size: 9pt; }
        .form-report .fr-people-table { width: auto; min-width: 0; max-width: 100%; }
        .form-report .fr-table th, .form-report .fr-table td { padding: .12rem .35rem; overflow-wrap: anywhere; }
        .form-report .fr-line { max-width: 100%; }
        .form-report .fr-value { white-space: normal; }

        /* Page breaks: long tables may continue on the next page with their header repeated, but a row, a
           numbered line, a heading with what follows it, and the signature block are kept together. */
        .form-report thead { display: table-header-group; }
        .form-report tr, .form-report .fr-item:not(.fr-block), .form-report .fr-zone-text { break-inside: avoid; }
        .form-report .fr-section-title, .form-report .fr-heading, .form-report .fr-header, .form-report .fr-block-label { break-after: avoid; }
        .form-report { orphans: 3; widows: 3; }
        .form-report .fr-signatures { break-inside: avoid; }
    }
</style>
}

<div class="container-fluid mt-4 fr-page">
    <div class="no-print d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <form method="get" asp-action="FormReport" class="d-flex flex-wrap align-items-end gap-2 @(Model.AvailableWeeks.Count == 0 ? "invisible" : "")">
            <div>
                <label for="weekSelect" class="form-label mb-1 fw-bold">የሪፖርት ሳምንት</label>
                <select id="weekSelect" class="form-select" onchange="const [s, e] = this.value.split('|'); this.form.startDate.value = s; this.form.endDate.value = e; this.form.submit();">
                    @foreach (var week in Model.AvailableWeeks)
                    {
                        var value = $"{week.StartDate:yyyy-MM-dd}|{week.EndDate:yyyy-MM-dd}";
                        <option value="@value" selected="@(week.StartDate == Model.StartDate && week.EndDate == Model.EndDate)">@week.StartDate.ToString("dd/MM/yyyy") — @week.EndDate.ToString("dd/MM/yyyy")</option>
                    }
                </select>
            </div>
            <input type="hidden" name="startDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
        </form>
        <div class="d-flex gap-2">
            @if (Model.StartDate.HasValue && Model.EndDate.HasValue)
            {
                <a asp-action="FormReportExcel" asp-route-startDate="@Model.StartDate.Value.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate.Value.ToString("yyyy-MM-dd")"
                   class="btn btn-success"><i class="fas fa-file-excel me-1"></i> Excel ሪፖርት</a>
            }
            <button type="button" class="btn btn-outline-dark" onclick="window.print()"><i class="fas fa-print me-1"></i> አትም</button>
            <a asp-action="Index" class="btn btn-outline-primary">ወደ ተጠቃለለ ሪፖርት ተመለስ</a>
        </div>
    </div>

    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-warning"><i class="fas fa-exclamation-triangle me-2"></i>@Model.ErrorMessage</div>
    }
    else if (Model.StartDate == null)
    {
        <div class="alert alert-info">
            @(Model.WoredasInScope == 0
                ? $"በ{Or(Model.ScopeName)} ስር የተመዘገበ ወረዳ የለም።"
                : $"በ{Or(Model.ScopeName)} ስር ለተመረጠው ሳምንት የተላከ ሳምንታዊ ሪፖርት አልተገኘም።")
        </div>
    }
    else
    {
        <div class="form-report">
            <div class="fr-header">
                <div>@officeLine</div>
                <div>የቅድመ ማስጠንቀቂያና ምላሽ ሳምንታዊ ሪፖርት (@reportKind)</div>
                <div>ሪፖርቱ የሚሸፍነው ጊዜ <u>@Model.StartDate.Value.ToString("dd/MM/yyyy")</u> እስከ <u>@Model.EndDate!.Value.ToString("dd/MM/yyyy")</u></div>
                <div class="fr-coverage">@coverageLine</div>
            </div>

            <div class="fr-subtitle">የዝርዝር ስራዎች</div>

            @foreach (var formSection in Model.Sections)
            {
                <div class="fr-section">
                    <div class="fr-item fr-section-title"><span class="fr-num">@ListNumber(formSection.Number)</span><span class="fr-body">@formSection.Title</span></div>
                    @foreach (var item in formSection.Items)
                    {
                        switch (item.Kind)
                        {
                            case FormReportItemKind.Heading:
                                <div class="fr-item fr-heading @Level(item)"><span class="fr-num">@item.Number</span><span class="fr-body">@item.Label</span></div>
                                break;

                            case FormReportItemKind.Line:
                                <div class="fr-item @Level(item)">
                                    <span class="fr-num">@item.Number</span>
                                    <div class="fr-body fr-line"><span class="fr-label">@item.Label</span><span class="fr-dots"></span><span class="fr-value">@item.Value</span></div>
                                </div>
                                break;

                            case FormReportItemKind.People:
                                var p = item.People!;
                                var peopleRows = new List<(string Label, int Male, int Female)>
                                {
                                    ("አባወራ / እማወራ", p.MaleHouseholds, p.FemaleHouseholds)
                                };
                                if (p.HasFamilyRow) peopleRows.Add(("ቤተሰብ", p.MaleFamily, p.FemaleFamily));
                                peopleRows.Add(("ህፃናት ከ5 ዓመት በታች", p.MaleChildren, p.FemaleChildren));
                                peopleRows.Add(("ወጣት", p.MaleYouth, p.FemaleYouth));
                                peopleRows.Add(("አረጋውያን", p.MaleElderly, p.FemaleElderly));
                                peopleRows.Add(("አካል ጉዳተኛ", p.MaleDisabled, p.FemaleDisabled));
                                <div class="fr-item fr-block @Level(item)">
                                    <span class="fr-num"></span>
                                    <div class="fr-body">
                                        <div class="fr-block-label">@item.Label</div>
                                        <table class="table table-sm table-bordered align-middle fr-table fr-people-table">
                                            <thead><tr><th>ምድብ</th><th>ወንድ</th><th>ሴት</th><th>ድምር</th></tr></thead>
                                            <tbody>
                                                @foreach (var row in peopleRows)
                                                {
                                                    <tr><td>@row.Label</td><td>@row.Male.ToString("#,0")</td><td>@row.Female.ToString("#,0")</td><td class="fw-bold">@((row.Male + row.Female).ToString("#,0"))</td></tr>
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr class="fw-bold"><td>ጠቅላላ ድምር</td><td>@peopleRows.Sum(x => x.Male).ToString("#,0")</td><td>@peopleRows.Sum(x => x.Female).ToString("#,0")</td><td>@peopleRows.Sum(x => x.Male + x.Female).ToString("#,0")</td></tr>
                                                @if (p.LactatingAndPregnant.HasValue)
                                                {
                                                    <tr><td colspan="3">አጥቢ እና ነፍሰጡር እናቶች በቁጥር</td><td class="fw-bold">@p.LactatingAndPregnant.Value.ToString("#,0")</td></tr>
                                                }
                                            </tfoot>
                                        </table>
                                    </div>
                                </div>
                                break;

                            case FormReportItemKind.ZoneText:
                                if (item.ZoneTexts.Count == 0)
                                {
                                    <div class="fr-item @Level(item)">
                                        <span class="fr-num"></span>
                                        <div class="fr-body fr-line"><span class="fr-label">@item.Label</span><span class="fr-dots"></span><span class="fr-value">-</span></div>
                                    </div>
                                }
                                else
                                {
                                    <div class="fr-item fr-block @Level(item)">
                                        <span class="fr-num"></span>
                                        <div class="fr-body">
                                            <div class="fr-block-label">@item.Label፡</div>
                                            @foreach (var entry in item.ZoneTexts)
                                            {
                                                <div class="fr-zone-text">@if (entry.Group != "") { <span class="fr-zone">@entry.Group፡</span> }@entry.Text</div>
                                            }
                                        </div>
                                    </div>
                                }
                                break;

                            case FormReportItemKind.Table:
                                <div class="fr-item fr-block @Level(item)">
                                    <span class="fr-num"></span>
                                    <div class="fr-body">
                                        @if (item.TableRows.Count == 0)
                                        {
                                            <div class="fr-empty">— የተመዘገበ መረጃ የለም —</div>
                                        }
                                        else
                                        {
                                            <div class="table-responsive">
                                                <table class="table table-sm table-bordered align-middle fr-table">
                                                    <thead><tr>@foreach (var header in item.TableHeaders) { <th>@header</th> }</tr></thead>
                                                    <tbody>
                                                        @foreach (var row in item.TableRows)
                                                        {
                                                            <tr>@foreach (var cell in row) { <td>@cell</td> }</tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    </div>
                                </div>
                                break;
                        }
                    }
                </div>
            }

            <div class="fr-signatures">
                <div>
                    <div class="fr-sign-title">መረጃውን የሞላው</div>
                    @SignLine("ስም", Model.PreparedBy)
                    @SignLine("ኃላፊነት", null)
                    @SignLine("ቀን", DateTime.Now.ToString("dd/MM/yyyy"))
                </div>
                <div>
                    <div class="fr-sign-title">መረጃውን ያረጋገጠው</div>
                    @SignLine("ስም", null)
                    @SignLine("ኃላፊነት", null)
                    @SignLine("ቀን", null)
                </div>
            </div>
        </div>
    }
</div>
