@model EarlyWarning.ViewModels.ZoneWeeklySubmissionViewModel
@using EarlyWarning.Extensions
@{ ViewData["Title"] = $"{Model.Zone} ዞን — ሳምንታዊ ሪፖርት"; }

<partial name="_StandardWeeklyReportStyles" />

<div class="container-fluid mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 no-print">
        <a asp-action="RegionalQueue" class="btn btn-link px-0">← ወደ ዞን የፍቃድ ወረፋ</a>
        <button type="button" class="btn btn-outline-dark" onclick="window.print()"><i class="fas fa-print me-1"></i> አትም</button>
    </div>
    @if (TempData["Error"] != null) { <div class="alert alert-danger no-print">@TempData["Error"]</div> }

    <div class="alert alert-secondary no-print">
        <strong>@Model.WoredaCount</strong> በዞን የጸደቁ የወረዳ ሪፖርቶች በዚህ ሳምንታዊ ሪፖርት ተካተዋል።
        የክልል ማጽደቂያ የሚሰጠው ከታች ካሉት የእያንዳንዱ ወረዳ ዝርዝር ገጽ ላይ ብቻ ነው።
    </div>

    @if (Model.Narrative != null)
    {
        <partial name="_StandardWeeklyReport" model="Model.Narrative" />
    }

    <div class="card shadow-sm mb-4 no-print">
        <div class="card-header fw-bold">በዚህ ሪፖርት የተካተቱ ወረዳዎች</div>
        <div class="table-responsive">
            <table class="table table-bordered mb-0">
                <thead><tr><th>ወረዳ</th><th>ሳምንት (ዓ/ም)</th><th>ሁኔታ</th><th>ሙሉ መረጃ</th></tr></thead>
                <tbody>
                    @foreach (var w in Model.Woredas)
                    {
                        <tr>
                            <td>@w.Woreda</td>
                            <td>@EthiopianDate.FromGregorian(w.StartDate) — @EthiopianDate.FromGregorian(w.EndDate)</td>
                            <td><span class="badge bg-success">@ReadOnlyFields.EnumLabel(w.Status)</span></td>
                            <td><a asp-action="Details" asp-route-id="@w.Id" class="btn btn-sm btn-outline-primary">የወረዳ ዝርዝርና ታሪክ</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
