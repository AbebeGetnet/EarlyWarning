@model EarlyWarning.ViewModels.ZoneWeeklySubmissionViewModel
@{ ViewData["Title"] = "የዞን ድምር ግምገማ"; }
<div class="container-fluid mt-4">
 <a asp-action="RegionalQueue" class="btn btn-link">← ወደ ዞን የፍቃድ ወረፋ</a>
 @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
 <div class="card shadow-sm mb-4"><div class="card-header bg-primary text-white"><h4 class="mb-0">@Model.Zone — @Model.StartDate.ToString("yyyy-MM-dd") እስከ @Model.EndDate.ToString("yyyy-MM-dd")</h4></div><div class="card-body"><strong>@Model.WoredaCount</strong> በዞን የጸደቁ ወረዳዎች በዚህ ድምር ተካተዋል።</div></div>
 <div class="row g-3 mb-4"><div class="col-md-3"><div class="card"><div class="card-body"><small>ሙሉ ዝናብ</small><h3>@Model.Aggregate.FullRainCoverageKebeles</h3></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><small>ከፊል ዝናብ</small><h3>@Model.Aggregate.PartialRainCoverageKebeles</h3></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><small>ዝናብ ያላገኙ</small><h3>@Model.Aggregate.NoRainKebeles</h3></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><small>የተጎዳ መሬት</small><h3>@Model.Aggregate.AffectedCropLandHectares</h3></div></div></div></div>
 <partial name="_AggregateSections" model="Model.Aggregate" />
 <div class="card shadow-sm mb-4"><div class="card-header fw-bold">በዞን ድምሩ የተካተቱ ወረዳዎች</div><div class="table-responsive"><table class="table table-bordered mb-0"><thead><tr><th>ወረዳ</th><th>ሁኔታ</th><th>ሙሉ መረጃ</th></tr></thead><tbody>@foreach(var w in Model.Woredas){<tr><td>@w.Woreda</td><td><span class="badge bg-success">@w.Status</span></td><td><a asp-action="Details" asp-route-id="@w.Id" class="btn btn-sm btn-outline-primary">የወረዳ ዝርዝርና ታሪክ</a></td></tr>}</tbody></table></div></div>
 <div class="card shadow-sm"><div class="card-header fw-bold">የክልል ውሳኔ</div><div class="card-body"><form asp-action="ActZone" method="post">@Html.AntiForgeryToken()<input type="hidden" name="zoneId" value="@Model.ZoneId"/><input type="hidden" name="startDate" value="@Model.StartDate.ToString("O")"/><input type="hidden" name="endDate" value="@Model.EndDate.ToString("O")"/><label class="form-label">አስተያየት</label><textarea name="comment" class="form-control mb-3" maxlength="2000" rows="3"></textarea><button name="decision" value="Approve" class="btn btn-success me-2">የዞኑን ድምር ፍቀድ</button><button name="decision" value="Reject" class="btn btn-danger">ወደ ዞን መልስ</button></form></div></div>
</div>
