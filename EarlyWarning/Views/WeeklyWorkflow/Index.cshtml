@model EarlyWarning.ViewModels.WeeklyWorkflowIndexViewModel
@using EarlyWarning.Enums
@using EarlyWarning.Extensions
@{
    var workflowMode = ViewBag.WorkflowMode as string;
    ViewData["Title"] = workflowMode == null ? "የተጠቃለለ ሳምንታዊ ሪፖርት" : workflowMode == "approval" ? "የፍቃድ ወረፋ" : "የሪፖርት ግምገማ";
    var weekRoute = new Dictionary<string, string>
    {
        ["startDate"] = Model.StartDate?.ToString("yyyy-MM-dd") ?? "",
        ["endDate"] = Model.EndDate?.ToString("yyyy-MM-dd") ?? ""
    };
}

@if (workflowMode == null)
{
    <partial name="_StandardWeeklyReportStyles" />
    <div class="container-fluid mt-4">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3 no-print">
            <div>
                <h3 class="mb-1">የተጠቃለለ ሳምንታዊ ሪፖርት — @Model.ScopeName</h3>
                <div class="text-muted small">በቅድሚያ ማስጠንቀቂያና ምላሽ ሳምንታዊ ሪፖርት ደረጃ (ቅርጽ) የተዘጋጀ</div>
            </div>
            <partial name="_WeekPicker" model='("Index", Model.AvailableWeeks, Model.StartDate, Model.EndDate)' />
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-outline-dark" onclick="window.print()"><i class="fas fa-print me-1"></i> አትም</button>
                @if (Model.StartDate.HasValue)
                {
                    <a asp-action="FormReportExcel" asp-all-route-data="weekRoute" class="btn btn-success"><i class="fas fa-file-excel me-1"></i> Excel</a>
                }
                <a asp-action="ReportPageTwo" asp-all-route-data="weekRoute" class="btn btn-outline-secondary"><i class="fas fa-layer-group me-1"></i> በዞን/ወረዳ ዝርዝር</a>
                <a asp-action="FormReport" asp-all-route-data="weekRoute" class="btn btn-outline-secondary"><i class="fas fa-file-signature me-1"></i> የቅጽ ሪፖርት</a>
                <a asp-action="Index" asp-route-mode="details" class="btn btn-outline-primary"><i class="fas fa-search me-1"></i> የወረዳ ሪፖርቶችን ገምግም</a>
            </div>
        </div>
        @if (TempData["Error"] != null) { <div class="alert alert-danger no-print">@TempData["Error"]</div> }
        @if (Model.ErrorMessage != null)
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }
        else if (Model.Narrative == null)
        {
            <div class="alert alert-info">ለማሳየት የተላከ ሳምንታዊ ሪፖርት እስካሁን የለም።</div>
        }
        else
        {
            <partial name="_StandardWeeklyReport" model="Model.Narrative" />
        }
    </div>
}
else
{
    <div class="container-fluid mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3>@ViewData["Title"] — @Model.ScopeName</h3>
            <span class="badge bg-primary">@Model.Reports.Count ሪፖርቶች</span>
        </div>
        @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
        <div class="card shadow-sm mb-4">
            <div class="card-header fw-bold">የወረዳ ዝርዝር</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>ዞን</th><th>ወረዳ</th><th>ሳምንት (ዓ/ም)</th><th>ሁኔታ</th><th>ዝርዝር</th></tr></thead>
                    <tbody>
                        @foreach (var r in Model.Reports)
                        {
                            <tr>
                                <td>@r.Zone</td>
                                <td class="fw-bold">@r.Woreda</td>
                                <td>@EthiopianDate.FromGregorian(r.StartDate) — @EthiopianDate.FromGregorian(r.EndDate)</td>
                                <td><span class="badge bg-secondary">@ReadOnlyFields.EnumLabel(r.Status)</span></td>
                                <td><a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-primary">@(workflowMode == "approval" ? "ዝርዝሩን ከፍተው ይወስኑ" : "ሙሉ ዝርዝር / ግምገማ")</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
