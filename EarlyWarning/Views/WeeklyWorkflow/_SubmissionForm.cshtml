@model EarlyWarning.ViewModels.WeeklySubmissionFormViewModel
@using EarlyWarning.Enums
@using EarlyWarning.Extensions
@{
    var form = Model;
    string N(decimal? value) => ReadOnlyFields.Format(value);
    // Beneficiaries = household heads + family members; the age and disability columns describe those same people.
    int People(int a, int b, int c, int d, int e, int f, int g, int h, int i, int j, int k, int l) => (int)EarlyWarning.Extensions.Beneficiaries.Count(a, b, c, d);

    void Fields(object? source, params string[] skip)
    {
        var fields = ReadOnlyFields.For(source, skip);
        if (fields.Count == 0)
        {
            <p class="text-muted fst-italic mb-0">መረጃ አልተመዘገበም።</p>
            return;
        }
        <div class="row g-2">
            @foreach (var field in fields)
            {
                <div class="col-sm-6 col-lg-4">
                    <label class="form-label small text-muted mb-0">@field.Label</label>
                    <input class="form-control form-control-sm" value="@field.Value" readonly />
                </div>
            }
        </div>
    }

    void Names(string label, IReadOnlyCollection<string> names)
    {
        <div class="mt-2">
            <span class="small text-muted">@label፡</span>
            @if (names.Count == 0)
            {
                <span class="text-muted fst-italic">የለም</span>
            }
            @foreach (var name in names)
            {
                <span class="badge bg-secondary me-1">@name</span>
            }
        </div>
    }

    var damageCategories = Enum.GetValues<AccidentDamageCategory>().Where(x => x != AccidentDamageCategory.None).ToList();
    var cropDetails = form.CropPest?.ImpactDetails.OrderBy(x => x.PestDisease?.Name).ToList() ?? [];
    var defensiveActivities = form.CropPest?.DefensiveActivities.ToList() ?? [];
    var animalDetails = form.AnimalHealth?.ImpactDetails.OrderBy(x => x.Disease?.Name).ToList() ?? [];
    var accidentDetails = form.Accidents?.HasAccident == true ? form.Accidents.AccidentDetails?.ToList() ?? [] : [];
    var aidDetails = form.Aid?.WeeklyProvidedDetail?.ToList() ?? [];
    // With per-type rows, the report-level totals and people columns only repeat the table below: show them once.
    string[] cropSkip = cropDetails.Count > 0 ? [.. ReadOnlyFields.ReportLevelPeople, "AffectedLandInHectar"] : [];
    string[] animalSkip = animalDetails.Count > 0 ? [.. ReadOnlyFields.ReportLevelPeople, "NoOfKebeliesWithWaterSupply"] : [];
    var priceRows = form.GrainPriceRows.Select(x => (Type: x.GrainType?.GrainName ?? "-", x.WeeklyPrice, x.WeeklyMarketStatus, x.PriceDifference, x.PriceChangePercentage))
        .Concat(form.AnimalPriceRows.Select(x => (Type: x.AnimalType?.AnimalTypeName ?? "-", x.WeeklyPrice, x.WeeklyMarketStatus, x.PriceDifference, x.PriceChangePercentage))).ToList();
}

<fieldset disabled class="submitted-form">
    <div class="card shadow-sm mb-3"><div class="card-header fw-bold">1. የዝናብ ሁኔታ</div><div class="card-body">
        @{ Fields(form.Rainfall); Names("በከፍተኛ ዝናብ የተጎዱ ቀበሌዎች", form.HighRainfallKebeles); Names("በድርቅ የተጎዱ ቀበሌዎች", form.DroughtKebeles); }
    </div></div>

    <div class="card shadow-sm mb-3"><div class="card-header fw-bold">2. የግብርና ስራዎች ክንውን (ሄክታር)</div><div class="card-body">@{ Fields(form.Farming); }</div></div>
    <div class="card shadow-sm mb-3"><div class="card-header fw-bold">3.1 የሰብል እድገት ሁኔታ</div><div class="card-body">@{ Fields(form.CropGrowth); }</div></div>

    <div class="card shadow-sm mb-3"><div class="card-header fw-bold">3.2 የሰብል ተባይና በሽታ ጉዳት</div><div class="card-body">
        @{ Fields(form.CropPest, cropSkip); }
        <h6 class="mt-3 fw-bold">በእያንዳንዱ ተባይ/በሽታ የደረሰ ጉዳት</h6>
        @if (cropDetails.Count == 0)
        {
            <p class="text-muted fst-italic mb-0">ምንም ተባይ/በሽታ አልተመረጠም።</p>
        }
        else
        {
            <div class="table-responsive"><table class="table table-sm table-bordered align-middle mb-0">
                <thead class="table-light"><tr><th>ተባይ/በሽታ</th><th>የተጎዳ የሰብል መጠን (ሄ/ር)</th><th>የጉዳት መጠን (%)</th><th>የተጎዳ ሰብል</th><th>የተጎዱ አርሶ አደሮች</th></tr></thead>
                <tbody>
                @foreach (var d in cropDetails)
                {
                    <tr>
                        <td class="fw-bold">@(d.PestDisease?.Name ?? "-")</td>
                        <td><input class="form-control form-control-sm" value="@N(d.AffectedLandInHectares)" readonly /></td>
                        <td><input class="form-control form-control-sm" value="@N(d.DamagePercentage)" readonly /></td>
                        <td>@d.AffectedCropType</td>
                        <td>@People(d.MaleHouseholdHeads, d.FemaleHouseholdHeads, d.MaleFamilyMembers, d.FemaleFamilyMembers, d.MaleChildren, d.FemaleChildren, d.MaleYouth, d.FemaleYouth, d.MaleElderly, d.FemaleElderly, d.MaleDisabled, d.FemaleDisabled).ToString("N0")</td>
                    </tr>
                }
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td>ድምር</td>
                        <td>@N(cropDetails.Sum(d => d.AffectedLandInHectares))</td>
                        <td></td>
                        <td></td>
                        <td>@cropDetails.Sum(d => People(d.MaleHouseholdHeads, d.FemaleHouseholdHeads, d.MaleFamilyMembers, d.FemaleFamilyMembers, d.MaleChildren, d.FemaleChildren, d.MaleYouth, d.FemaleYouth, d.MaleElderly, d.FemaleElderly, d.MaleDisabled, d.FemaleDisabled)).ToString("N0")</td>
                    </tr>
                </tfoot>
            </table></div>
        }
        <h6 class="mt-3 fw-bold">ለጉዳቱ ምላሽ የተወሰዱ የመከላከል ተግባራት</h6>
        @if (defensiveActivities.Count == 0)
        {
            <p class="text-muted fst-italic mb-0">ምንም የመከላከል ተግባር አልተመዘገበም።</p>
        }
        else
        {
            <ol class="list-group list-group-numbered">
                @foreach (var activity in defensiveActivities)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span>@activity.Activity</span>
                        @if (activity.AreaCoveredInHectares.HasValue)
                        {
                            <span class="badge bg-success">@N(activity.AreaCoveredInHectares) ሄ/ር</span>
                        }
                    </li>
                }
            </ol>
        }
    </div></div>

    <div class="card shadow-sm mb-3"><div class="card-header fw-bold">4.1 የግጦሽ/መኖ ሁኔታ</div><div class="card-body">@{ Fields(form.Pasture); }</div></div>
    <div class="card shadow-sm mb-3"><div class="card-header fw-bold">4.2 የእንስሳት ውሃ አቅርቦት</div><div class="card-body">@{ Fields(form.AnimalWater); }</div></div>

    <div class="card shadow-sm mb-3"><div class="card-header fw-bold">4.3 የእንስሳት ጤና</div><div class="card-body">
        @{ Fields(form.AnimalHealth, animalSkip); }
        <h6 class="mt-3 fw-bold">በእያንዳንዱ የእንስሳት በሽታ የደረሰ ጉዳት</h6>
        @if (animalDetails.Count == 0)
        {
            <p class="text-muted fst-italic mb-0">ምንም የእንስሳት በሽታ አልተመረጠም።</p>
        }
        else
        {
            <div class="table-responsive"><table class="table table-sm table-bordered align-middle mb-0">
                <thead class="table-light"><tr><th>በሽታ</th><th>የተጎዱ እንስሳት ብዛት</th><th>የተጎዱ አርብቶ አደሮች</th></tr></thead>
                <tbody>
                @foreach (var d in animalDetails)
                {
                    <tr>
                        <td class="fw-bold">@(d.Disease?.Name ?? "-")</td>
                        <td><input class="form-control form-control-sm" value="@d.NumberOfAffectedAnimals.ToString("N0")" readonly /></td>
                        <td>@People(d.MaleHouseholdHeads, d.FemaleHouseholdHeads, d.MaleFamilyMembers, d.FemaleFamilyMembers, d.MaleChildren, d.FemaleChildren, d.MaleYouth, d.FemaleYouth, d.MaleElderly, d.FemaleElderly, d.MaleDisabled, d.FemaleDisabled).ToString("N0")</td>
                    </tr>
                }
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td>ድምር</td>
                        <td>@animalDetails.Sum(d => d.NumberOfAffectedAnimals).ToString("N0")</td>
                        <td>@animalDetails.Sum(d => People(d.MaleHouseholdHeads, d.FemaleHouseholdHeads, d.MaleFamilyMembers, d.FemaleFamilyMembers, d.MaleChildren, d.FemaleChildren, d.MaleYouth, d.FemaleYouth, d.MaleElderly, d.FemaleElderly, d.MaleDisabled, d.FemaleDisabled)).ToString("N0")</td>
                    </tr>
                </tfoot>
            </table></div>
        }
    </div></div>

    <div class="card shadow-sm mb-3"><div class="card-header fw-bold">5. የሰው መጠጥ ውሃ</div><div class="card-body">
        @{ Fields(form.HumanWater); Names("የተጎዱ ቀበሌዎች", form.HumanWaterKebeles); }
    </div></div>
    <div class="card shadow-sm mb-3"><div class="card-header fw-bold">6. የሰው ጤና ወረርሽኝ</div><div class="card-body">
        @{ Fields(form.Epidemic); Names("የተከሰቱ በሽታዎች", form.Epidemic?.EpidemicDiseaseSelections?.Select(x => x.EpidemicDiseaseType?.Name ?? "-").ToList() ?? []); }
    </div></div>
    <div class="card shadow-sm mb-3"><div class="card-header fw-bold">7.1 የእህል አቅርቦት</div><div class="card-body">@{ Fields(form.GrainSupply); }</div></div>
    <div class="card shadow-sm mb-3"><div class="card-header fw-bold">7.2 የእንስሳት አቅርቦት</div><div class="card-body">@{ Fields(form.AnimalSupply); }</div></div>

    <div class="card shadow-sm mb-3"><div class="card-header fw-bold">7.3 የእህልና የእንስሳት ዋጋ</div><div class="card-body">
        @{ Fields(form.GrainPrice); }
        <div class="mt-2">@{ Fields(form.AnimalPrice); }</div>
        @if (priceRows.Count > 0)
        {
            <div class="table-responsive mt-3"><table class="table table-sm table-bordered mb-0">
                <thead class="table-light"><tr><th>አይነት</th><th>የዚህ ሳምንት ዋጋ</th><th>ሁኔታ</th><th>ልዩነት</th><th>ለውጥ %</th></tr></thead>
                <tbody>
                @foreach (var row in priceRows)
                {
                    <tr><td>@row.Type</td><td>@N(row.WeeklyPrice)</td><td>@ReadOnlyFields.EnumLabel(row.WeeklyMarketStatus)</td><td>@N(row.PriceDifference)</td><td>@N(row.PriceChangePercentage)</td></tr>
                }
                </tbody>
            </table></div>
        }
    </div></div>

    <div class="card shadow-sm mb-3"><div class="card-header fw-bold">8. የተፈጥሮና ሰው ሰራሽ አደጋዎች</div><div class="card-body">
        @{ Fields(form.Accidents); }
        @foreach (var d in accidentDetails)
        {
            <div class="border rounded p-3 mt-3">
                <h6 class="fw-bold">@(d.AccidentType?.AccidentName ?? "-")</h6>
                @{ Fields(d); }
                <label class="fw-bold d-block mt-2 mb-1">የደረሰው የጉዳት ምድብ</label>
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var category in damageCategories)
                    {
                        var id = $"dmg_{d.AccidentDetailId:N}_{(int)category}";
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="@id" checked="@d.DamageCategories.HasFlag(category)" />
                            <label class="form-check-label" for="@id">@ReadOnlyFields.EnumLabel(category)</label>
                        </div>
                    }
                </div>
            </div>
        }
    </div></div>

    <div class="card shadow-sm mb-3"><div class="card-header fw-bold">9. ስደትና ሞት</div><div class="card-body">
        @{ Fields(form.Migration); }
        @foreach (var d in form.Migration?.MigrationDetails ?? [])
        {
            <div class="border rounded p-2 mt-2">
                <div class="small mb-1">@(d.OriginLocation?.LocationAmharicName ?? d.OriginLocation?.LocationName ?? "-") → @(d.DestinationLocation?.LocationAmharicName ?? d.DestinationLocation?.LocationName ?? "-")</div>
                @{ Fields(d); }
            </div>
        }
        <hr />
        @{ Fields(form.Death); }
        @foreach (var d in form.Death?.DeathDetails ?? [])
        {
            <div class="border rounded p-2 mt-2">@{ Fields(d); }</div>
        }
    </div></div>

    <div class="card shadow-sm mb-3"><div class="card-header fw-bold">10. የእንስሳት ስደት</div><div class="card-body">
        @if (form.AnimalMigrations.Count == 0)
        {
            <p class="text-muted fst-italic mb-0">የእንስሳት ስደት አልተመዘገበም።</p>
        }
        else
        {
            <div class="table-responsive"><table class="table table-sm table-bordered mb-0">
                <thead class="table-light"><tr><th>አቅጣጫ</th><th>መነሻ</th><th>መድረሻ</th><th>የእንስሳት አይነት</th><th>ብዛት</th></tr></thead>
                <tbody>
                @foreach (var m in form.AnimalMigrations)
                {
                    <tr>
                        <td>@(m.Direction == AnimalMigrationDirection.Inward ? "ወደ ወረዳው የገቡ" : "ከወረዳው የወጡ")</td>
                        <td>@(m.OriginLocation?.LocationAmharicName ?? m.OriginLocation?.LocationName)</td>
                        <td>@(m.DestinationLocation?.LocationAmharicName ?? m.DestinationLocation?.LocationName)</td>
                        <td>@(m.AnimalType == MigratingAnimalType.Other ? m.OtherAnimalType : ReadOnlyFields.EnumLabel(m.AnimalType))</td>
                        <td>@m.NumberOfAnimals.ToString("N0")</td>
                    </tr>
                }
                </tbody>
            </table></div>
        }
    </div></div>

    <div class="card shadow-sm mb-3"><div class="card-header fw-bold">11. የእርዳታ ተጠቃሚዎች</div><div class="card-body">@{ Fields(form.AssistanceRecipient); }</div></div>

    <div class="card shadow-sm mb-3"><div class="card-header fw-bold">12. በሳምንቱ የቀረበና የተሰራጨ እርዳታ</div><div class="card-body">
        @{ Fields(form.Aid); }
        @foreach (var category in new[] { AidCategory.Food, AidCategory.NonFood })
        {
            var rows = aidDetails.Where(x => (x.SupplyType?.Category ?? AidCategory.Food) == category).OrderBy(x => x.SupplyType?.SupplyTypeName).ToList();
            <h6 class="mt-3 fw-bold">@ReadOnlyFields.EnumLabel(category)</h6>
            if (rows.Count == 0)
            {
                <p class="text-muted fst-italic mb-0">የለም</p>
            }
            else
            {
                <div class="table-responsive"><table class="table table-sm table-bordered mb-0">
                    <thead class="table-light"><tr><th>አቅርቦት</th><th>መለኪያ</th><th>የተጠየቀ</th><th>የቀረበ</th><th>የተሰራጨ</th><th>%</th><th>ለጋሽ</th></tr></thead>
                    <tbody>
                    @foreach (var row in rows)
                    {
                        <tr><td>@row.SupplyType?.SupplyTypeName</td><td>@ReadOnlyFields.EnumLabel(row.Measurement)</td><td>@N(row.RequestedQuantity)</td><td>@N(row.ProvidedQuantity)</td><td>@N(row.DistributedQuantity)</td><td>@N(row.PercentageOfDistributedFromProvided)</td><td>@row.Donor</td></tr>
                    }
                    </tbody>
                </table></div>
            }
        }
    </div></div>

    <div class="card shadow-sm mb-3"><div class="card-header fw-bold">13. ሌሎች ችግሮች</div><div class="card-body">@{ Fields(form.OtherProblem); }</div></div>
    <div class="card shadow-sm mb-3"><div class="card-header fw-bold">14. የትምህርት ቤት ሁኔታ</div><div class="card-body">@{ Fields(form.School); }</div></div>
</fieldset>
