@page
@using SIMS.Areas.Identity.Pages.Account
@model LoginModel

@{
    ViewData["Title"] = "መግቢያ";
}

@section Styles {
    <style>
        body { background: #f1faf7 !important; }
        .content-wrapper {
            margin-left: 0 !important;
            min-height: calc(100vh - 57px) !important;
            background: linear-gradient(135deg, #effaf6 0%, #f8fbfa 54%, #e9f5f3 100%) !important;
        }
        .content-wrapper > .content { padding: 0 !important; }
        .content-wrapper > .content > .container-fluid { padding: 0 !important; }
        footer.footer { display: none; }
        .login-page-shell {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 16px;
        }
        .login-card {
            width: min(100%, 506px);
            overflow: hidden;
            border: 0;
            border-radius: 34px;
            background: rgba(255,255,255,.96);
            box-shadow: 0 22px 55px rgba(16, 67, 91, .16);
        }
        .login-card-header {
            min-height: 227px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 30px 24px 26px;
            color: #fff;
            text-align: center;
            background: linear-gradient(135deg, #246383 0%, #124965 100%);
        }
        .login-emblem {
            width: 90px;
            height: 90px;
            display: grid;
            place-items: center;
            margin-bottom: 20px;
            border-radius: 50%;
            color: #205d7d;
            background: #fff;
            box-shadow: 0 8px 18px rgba(0,0,0,.13);
        }
        .login-emblem i { font-size: 46px; }
        .login-title {
            margin: 0;
            font-size: clamp(1.35rem, 4vw, 1.72rem);
            line-height: 1.45;
            font-weight: 800;
        }
        .login-subtitle { margin: 6px 0 0; font-size: .95rem; opacity: .92; }
        .login-card-body { padding: 34px 31px 30px; }
        .login-field { position: relative; margin-bottom: 18px; }
        .login-field i {
            position: absolute;
            top: 50%;
            left: 21px;
            z-index: 2;
            color: #617181;
            transform: translateY(-50%);
        }
        .login-input {
            height: 62px;
            padding: 0 24px 0 54px;
            border: 1px solid #cbd5df;
            border-radius: 999px;
            color: #263746;
            background: #fff;
            box-shadow: none;
        }
        .login-input:focus {
            border-color: #1d5877;
            box-shadow: 0 0 0 .2rem rgba(29, 88, 119, .13);
        }
        .login-validation { display: block; margin: 6px 18px 0; font-size: .86rem; }
        .login-options { margin: 4px 0 17px; padding-left: 2px; }
        .login-options label { display: inline-flex; align-items: center; gap: 9px; margin: 0; font-weight: 500; }
        .login-options input { width: 19px; height: 19px; margin: 0; accent-color: #185574; }
        .login-submit {
            width: 100%;
            min-height: 53px;
            border: 0;
            border-radius: 999px;
            color: #fff;
            font-size: 1.05rem;
            font-weight: 800;
            background: linear-gradient(90deg, #216484, #104763);
            box-shadow: 0 9px 18px rgba(18, 73, 101, .22);
            transition: transform .15s ease, box-shadow .15s ease;
        }
        .login-submit:hover, .login-submit:focus {
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 12px 23px rgba(18, 73, 101, .28);
        }
        .login-submit i { margin-right: 10px; }
        .forgot-link { display: block; margin-top: 18px; color: #205d7d; text-align: center; font-weight: 600; }
        .login-errors { margin: 0 0 18px; border-radius: 15px; }
        @@media (max-width: 575.98px) {
            .login-page-shell { padding: 0; align-items: stretch; }
            .login-card { width: 100%; min-height: 100vh; border-radius: 0; }
            .login-card-header { min-height: 220px; }
            .login-card-body { padding: 30px 24px; }
        }
    </style>
}

<main class="login-page-shell">
    <section class="login-card" aria-labelledby="loginTitle">
        <header class="login-card-header">
            <h1 class="login-title" id="loginTitle">የቅድመ ማስጠንቀቂያ ስርዓት</h1>
            <p class="login-subtitle">ወደ መለያዎ ይግቡ</p>
        </header>

        <div class="login-card-body">
            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger login-errors" role="alert"></div>

                <div class="login-field">
                    <i class="far fa-envelope" aria-hidden="true"></i>
                    <input asp-for="Input.Email" autocomplete="username" aria-required="true"
                           class="form-control login-input" placeholder="ኢሜይል አድራሻ" />
                    <span asp-validation-for="Input.Email" class="text-danger login-validation"></span>
                </div>

                <div class="login-field">
                    <i class="fas fa-lock" aria-hidden="true"></i>
                    <input asp-for="Input.Password" autocomplete="current-password" aria-required="true"
                           class="form-control login-input" placeholder="የይለፍ ቃል" />
                    <span asp-validation-for="Input.Password" class="text-danger login-validation"></span>
                </div>

                <div class="login-options">
                    <label asp-for="Input.RememberMe">
                        <input asp-for="Input.RememberMe" />
                        <span>መለያዬን አስታውስ</span>
                    </label>
                </div>

                <button id="login-submit" type="submit" class="btn login-submit">
                    <i class="fas fa-sign-in-alt" aria-hidden="true"></i>ወደ ስርዓቱ ግባ
                </button>

            </form>
        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
